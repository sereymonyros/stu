/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-related data
 * and a public-read, owner-write model for listings and jobs.  Chats are restricted
 * to the participants involved.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, owned by the user.
 * - /users/{userId}/applications/{applicationId}: Job application references, owned by the user.
 * - /users/{userId}/favouriteJobs/{jobId}: Favorite job references, owned by the user.
 * - /listings/{listingId}: Public listings, with owner-only writes.
 * - /jobs/{jobId}: Public job postings, with recruiter-only writes.
 * - /jobs/{jobId}/applications/{applicationId}: Applications for jobs, readable by applicant and job poster.
 * - /chats/{chatId}: Chat sessions between users, restricted to participants.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat, restricted to participants.
 * - /feedbacks/{feedbackId}: Public feedback, with owner-only writes.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and related subcollections.
 * - Listings and jobs are publicly readable, but only the owner (seller/recruiter) can modify them.
 * - Chats are restricted to the participants (buyer and seller).
 * - Listing of user subcollections (applications, favoriteJobs) is allowed to the owner.
 * - Users can create their own profile documents.
 *
 * Denormalization for Authorization:
 * - Listings and Jobs rely on the `sellerId` and `recruiterId` fields, respectively,
 *   to enforce ownership for write operations.
 * - Chats rely on the `participants` array to determine read/write access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (get, update, delete) User with ID 'user123' can read, update, and delete their own profile.
     * @deny (get, update, delete) User with ID 'user456' cannot read, update, or delete user 'user123's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Protects user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, get, list, update, delete) User with ID 'user123' can manage their own application references.
     * @deny (create, get, list, update, delete) User with ID 'user456' cannot manage user 'user123's application references.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Protects user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create, get, list, update, delete) User with ID 'user123' can manage their own favorite job references.
     * @deny (create, get, list, update, delete) User with ID 'user456' cannot manage user 'user123's favorite job references.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Protects listing data, allowing public read and owner-only write.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read all listings.
     * @allow (create, update, delete) Only the seller can create, update, or delete a listing.
     * @deny (create) User creating a listing with sellerId not matching their own ID.
     * @deny (update, delete) Non-seller attempting to update or delete a listing.
     * @principle Enforces public read access with owner-only writes, validates sellerId on create.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.sellerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Protects job data, allowing public read and recruiter-only write.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read all job postings.
     * @allow (create, update, delete) Only the recruiter can create, update, or delete a job posting.
     * @deny (create) User creating a job posting with recruiterId not matching their own ID.
     * @deny (update, delete) Non-recruiter attempting to update or delete a job posting.
     * @principle Enforces public read access with recruiter-only writes, validates recruiterId on create.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.recruiterId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Protects applications for a specific job, readable by applicant and job poster.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) Any signed in user can create an application
     * @allow (get) Only the applicant or recruiter can get the application.
     * @allow (list) Only the recruiter can list applications for their job.
     * @allow (update) Only the applicant or recruiter can update the application.
     * @allow (delete) Only the applicant can delete their application.
     * @principle Restricts access to applicant and job poster.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isApplicant() {
        return request.auth.uid == resource.data.applicantId;
      }

      function isJobOwner(jobId) {
          return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }

      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid && request.resource.data.jobId == jobId;
      allow get: if isSignedIn() && (isApplicant() || isJobOwner(jobId));
      allow list: if isSignedIn() && isJobOwner(jobId);
      allow update: if isSignedIn() && (isApplicant() || isJobOwner(jobId));
      allow delete: if isSignedIn() && isApplicant();
    }

    /**
     * @description Protects chat data, restricting access to chat participants.
     * @path /chats/{chatId}
     * @allow (get, list) Only chat participants can read chat data.
     * @allow (create) Any signed in user can create a chat.
     * @allow (update, delete) No one can update or delete a chat.
     * @deny (get, list) Non-participants attempting to read chat data.
     * @principle Enforces access control based on chat participants.
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }

      allow get: if isSignedIn() && isParticipant();
      allow list: if isSignedIn() && isParticipant();
      allow create: if isSignedIn() && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects messages within a chat, restricting access to chat participants.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create, get, list) Only chat participants can create, read, and list messages.
     * @allow (update, delete) No one can update or delete a message.
     * @deny (create, get, list) Non-participants attempting to create, read, or list messages.
     * @principle Enforces access control based on chat participants.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant(chatId) {
        return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      allow get: if isSignedIn() && isParticipant(chatId);
      allow list: if isSignedIn() && isParticipant(chatId);
      allow create: if isSignedIn() && isParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects feedback data, allowing public read and owner-only write.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read all feedback.
     * @allow (create, update, delete) Only the feedback creator can create, update, or delete feedback.
     * @deny (create) User creating feedback with userId not matching their own ID.
     * @deny (update, delete) Non-creator attempting to update or delete feedback.
     * @principle Enforces public read access with owner-only writes, validates userId on create.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.userId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}