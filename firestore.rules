/**
 * @fileoverview Firestore Security Rules for the job board application.
 * * Core Philosophy:
 * This ruleset prioritizes user privacy and data ownership. Users can only
 * read and modify their own profile data. Public data (listings, jobs) are
 * generally readable, but write access is restricted to authorized users
 * (sellers, recruiters).
 * * NOTE: The fix involves making the 'getUserRole' function safe against null UIDs
 * and allowing 'standard' users to read their own applications.
 */
rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {
    
    // 💡 FIX 1: Safe function to retrieve a user's role, handling null/missing profiles
    function getUserRole() {
      if request.auth == null {
        return null;
      }
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Safely check for existence and return the role, or null if doc is missing
      return userDoc.exists ? userDoc.data.role : null;
    }

    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, create, update, delete: if isSignedIn() && isOwner(userId);
      allow list: if false; // User listing is disallowed.
    }

    match /users/{userId}/favoriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      
      allow get, list, create, update, delete: if isSignedIn() && isOwner(userId);
    }
    
    match /listings/{listingId} {
      function isExistingOwner() {
        return resource.data.sellerId == request.auth.uid;
      }
      
      function isSignedIn() {
        return request.auth != null;
      }
      
      allow get, list: if getUserRole() in ['recruiter', 'standard'];
      allow create: if getUserRole() in ['seller', 'recruiter', 'standard']; // Allow any registered user to create a listing
      allow update, delete: if isSignedIn() && isExistingOwner();
    }

    match /jobs/{jobId} {
      function isExistingOwner() {
        return resource.data.recruiterId == request.auth.uid;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Allow all standard and recruiter users to read jobs for the dashboard/listing page
      allow get, list: if getUserRole() in ['recruiter', 'standard'];
      
      // Only recruiters can create jobs
      allow create: if getUserRole() == 'recruiter';
      
      // Only the owning recruiter can update/delete
      allow update, delete: if getUserRole() == 'recruiter' && isExistingOwner();
    }

    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
    }

    
    match /jobs/{jobId}/applications/{applicationId} {
      function isJobOwner(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }
      
      // 💡 FIX 2: New function to check if the current user is the applicant
      function isApplicant() {
        return resource.data.applicantId == request.auth.uid;
      }
      
      function isSignedIn() {
        return request.auth != null;
      }
      
      // 💡 FIX 3: Allow the Job Owner (Recruiter) OR the Applicant (Standard User) to read/list
      allow get, list: if isSignedIn() && (isJobOwner(jobId) || isApplicant()); 
      
      // Allow creation by any signed-in user (the applicant)
      allow create: if isSignedIn(); 
      
      allow update: if false;
      allow delete: if false;
    }    
  }
}