/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for private data and allows public read access for certain collections.
 *
 * Data Structure:
 * - User profiles and associated data are stored under `/users/{userId}`.
 * - Listings, jobs, chats, and feedback are stored in top-level collections.
 * - Applications are stored both as subcollections of jobs and as subcollections of users, with the job subcollection being the source of truth.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own profile data.
 * - Listings and Jobs are publicly readable, but only the owner (seller/recruiter) can modify them.
 * - Denormalized data (like `participants` in `Chat`) is used to avoid complex queries in rules.
 * - The rules do not validate the data types or the presence of optional fields in the documents, allowing for rapid prototyping.
 * - The rules enforce the presence of key fields necessary for authorization and relational integrity.
 *
 * Denormalization for Authorization:
 * - Chats include a `participants` array for easy authorization.
 * - Listings and Jobs include `sellerId` and `recruiterId` fields respectively, for owner-based write authorization.
 *
 * Structural Segregation:
 * - User-specific data (applications, saved searches, favourite jobs) are stored under the `/users/{userId}` path, while public listings and jobs are stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the resource owner ID and that the resource exists.
     */
    function isExistingOwner(ownerId) {
        return (isOwner(ownerId) && resource != null);
    }

    /**
     * @description Secures documents under `/users/{userId}`.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) User with UID 'user123' creates their profile.
     * @allow (get) User with UID 'user123' reads their profile.
     * @allow (update) User with UID 'user123' updates their profile.
     * @allow (delete) User with UID 'user123' deletes their profile.
     * @deny (create) User with UID 'user456' tries to create a profile for 'user123'.
     * @deny (get) User with UID 'user456' tries to read profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) ;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures saved searches under `/users/{userId}/savedSearches/{searchId}`.
     * @path /databases/{database}/documents/users/{userId}/savedSearches/{searchId}
     * @allow (create) User with UID 'user123' creates a saved search.
     * @allow (get) User with UID 'user123' reads a saved search.
     * @allow (update) User with UID 'user123' updates a saved search.
     * @allow (delete) User with UID 'user123' deletes a saved search.
     * @deny (create) User with UID 'user456' tries to create a saved search for 'user123'.
     * @deny (get) User with UID 'user456' tries to read saved search of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/savedSearches/{searchId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures job applications under `/users/{userId}/applications/{applicationId}`.
     * @path /databases/{database}/documents/users/{userId}/applications/{applicationId}
     * @allow (create) User with UID 'user123' creates an application reference.
     * @allow (get) User with UID 'user123' reads an application reference.
     * @allow (update) User with UID 'user123' updates an application reference.
     * @allow (delete) User with UID 'user123' deletes an application reference.
     * @deny (create) User with UID 'user456' tries to create an application reference for 'user123'.
     * @deny (get) User with UID 'user456' tries to read application reference of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures favourite jobs under `/users/{userId}/favouriteJobs/{jobId}`.
     * @path /databases/{database}/documents/users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User with UID 'user123' creates a favorite job reference.
     * @allow (get) User with UID 'user123' reads a favorite job reference.
     * @allow (update) User with UID 'user123' updates a favorite job reference.
     * @allow (delete) User with UID 'user123' deletes a favorite job reference.
     * @deny (create) User with UID 'user456' tries to create a favorite job reference for 'user123'.
     * @deny (get) User with UID 'user456' tries to read favorite job reference of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts writes to the seller.
     * @path /databases/{database}/documents/listings/{listingId}
     * @allow (get) Any user can read a listing.
     * @allow (list) Any user can list listings.
     * @allow (create) User with UID 'user123' creates a listing with sellerId 'user123'.
     * @allow (update) User with UID 'user123' updates a listing where resource.data.sellerId == 'user123'.
     * @allow (delete) User with UID 'user123' deletes a listing where resource.data.sellerId == 'user123'.
     * @deny (create) User with UID 'user456' tries to create a listing with sellerId 'user123'.
     * @deny (update) User with UID 'user456' tries to update a listing where resource.data.sellerId == 'user123'.
     * @principle Allows public read access but enforces document ownership for writes.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Allows public read access to jobs, but restricts writes to the recruiter.
     * @path /databases/{database}/documents/jobs/{jobId}
     * @allow (get) Any user can read a job.
     * @allow (list) Any user can list jobs.
     * @allow (create) User with UID 'recruiter789' creates a job with recruiterId 'recruiter789'.
     * @allow (update) User with UID 'recruiter789' updates a job where resource.data.recruiterId == 'recruiter789'.
     * @allow (delete) User with UID 'recruiter789' deletes a job where resource.data.recruiterId == 'recruiter789'.
     * @deny (create) User with UID 'user456' tries to create a job with recruiterId 'recruiter789'.
     * @deny (update) User with UID 'user456' tries to update a job where resource.data.recruiterId == 'recruiter789'.
     * @principle Allows public read access but enforces document ownership for writes.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Secures job applications under `/jobs/{jobId}/applications/{applicationId}`.
     * @path /databases/{database}/documents/jobs/{jobId}/applications/{applicationId}
     * @allow (create) Any signed-in user can create an application if request.resource.data.applicantId == request.auth.uid.
     * @allow (get) Any signed-in user can get an application.
     * @allow (list) Any signed-in user can list applications.
     * @allow (update) Only the applicant can update their application.
     * @allow (delete) Only the applicant can delete their application.
     * @deny (create) User with UID 'user456' tries to create an application for 'user123'.
     * @deny (update) User with UID 'recruiter789' tries to update application where resource.data.applicantId == 'user123'.
     * @principle Enforces document ownership for application updates and deletes.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.applicantId);
      allow delete: if isExistingOwner(resource.data.applicantId);
    }

    /**
     * @description Secures chats based on participant IDs.
     * @path /databases/{database}/documents/chats/{chatId}
     * @allow (get) User with UID 'user123' can read a chat if 'user123' is in the participants array.
     * @allow (list) User with UID 'user123' can list chats if 'user123' is in the participants array.
     * @allow (create) User with UID 'user123' can create a chat if 'user123' is in the participants array.
     * @allow (update) User with UID 'user123' can update a chat if 'user123' is in the participants array.
     * @allow (delete) User with UID 'user123' can delete a chat if 'user123' is in the participants array.
     * @deny (get) User with UID 'user456' tries to read a chat where 'user456' is not a participant.
     * @principle Enforces shared access based on the `participants` array.
     */
    match /chats/{chatId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    /**
     * @description Secures messages within a chat.
     * @path /databases/{database}/documents/chats/{chatId}/messages/{messageId}
     * @allow (create) User with UID 'user123' can create a message in a chat they participate in.
     * @allow (get) User with UID 'user123' can read a message in a chat they participate in.
     * @allow (list) User with UID 'user123' can list messages in a chat they participate in.
     * @allow (update) User with UID 'user123' can update a message in a chat they participate in.
     * @allow (delete) User with UID 'user123' can delete a message in a chat they participate in.
     * @deny (create) User with UID 'user456' tries to create a message in a chat they don't participate in.
     * @principle Enforces access to messages based on chat participation.
     */
    match /chats/{chatId}/messages/{messageId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow create: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Allows public access to feedback, but enforces user-ownership.
     * @path /databases/{database}/documents/feedbacks/{feedbackId}
     * @allow (get) Any user can read feedback.
     * @allow (list) Any user can list feedback.
     * @allow (create) User with UID 'user123' can create feedback with userId 'user123'.
     * @allow (update) User with UID 'user123' can update feedback where resource.data.userId == 'user123'.
     * @allow (delete) User with UID 'user123' can delete feedback where resource.data.userId == 'user123'.
     * @deny (create) User with UID 'user456' tries to create feedback with userId 'user123'.
     * @deny (update) User with UID 'user456' tries to update feedback where resource.data.userId == 'user123'.
     * @principle Allows public read access but enforces document ownership for writes.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}