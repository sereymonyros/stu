/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * while allowing public read access to job postings and listings.  Write access
 * to these public collections is restricted to authorized users (job postings by
 * recruiters, listings by sellers). Data consistency is enforced where it
 * relates to authorization (e.g., the `sellerId` field in a `Listing` must
 * match the authenticated user's UID when creating a listing).
 *
 * Data Structure:
 * - /users/{userId}: User profile data, owned by the user.
 * - /users/{userId}/applications/{applicationId}: Job application references, owned by the user.
 * - /users/{userId}/favouriteJobs/{jobId}: Favorite job references, owned by the user.
 * - /users/{userId}/savedSearches/{searchId}: Saved job searches, owned by the user.
 * - /listings/{listingId}: Public marketplace listings.
 * - /jobs/{jobId}: Public job postings.
 * - /jobs/{jobId}/applications/{applicationId}: Applications for specific jobs.
 * - /feedbacks/{feedbackId}: User feedback.
 * - /companies/{companyId}: Company profiles.
 *
 * Key Security Decisions:
 * - Users can only read, create, update, and delete their own data under the /users/{userId} collection.
 * - Public read access is granted to the /listings and /jobs collections.
 * - Only authenticated recruiters can create, update, or delete job postings in the /jobs collection, and they must own the job.
 * - Only authenticated users can create listings, and they must own the listing.
 * - Listing is not allowed for the users collection or subcollections.
 *
 * Denormalization for Authorization:
 * The `Job` entity includes `recruiterId` and `recruiterDisplayName` to avoid
 * needing to query the user profile when displaying job information. The
 * `Application` entity includes `applicantName` and `applicantPhotoURL` for
 * similar reasons. The listings entity contains a sellerId so that it's easy to authorize listing updates.
 *
 * Structural Segregation:
 * Private user data is stored under the /users/{userId} path, while public data
 * like job postings and listings are stored in top-level collections. This
 * separation simplifies security rules and improves query performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User with matching UID can get, update, and delete their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @deny (get, update, delete) User cannot get, update, or delete another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, get, list, update, delete) User with matching UID can manage their applications.
     * @deny (create, get, list, update, delete) User cannot manage another user's applications.
     * @principle Enforces document ownership for user application references.
     */
    match /users/{userId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to a user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create, get, list, update, delete) User with matching UID can manage their favorite jobs.
     * @deny (create, get, list, update, delete) User cannot manage another user's favorite jobs.
     * @principle Enforces document ownership for user favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to a user's saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create, get, list, update, delete) User with matching UID can manage their saved searches.
     * @deny (create, get, list, update, delete) User cannot manage another user's saved searches.
     * @principle Enforces document ownership for user saved searches.
     */
    match /users/{userId}/savedSearches/{searchId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to marketplace listing documents.
     * @path /listings/{listingId}
     * @allow (get, list) Public read access for all listings.
     * @allow (create) Authenticated user can create a listing with their UID as sellerId.
     * @allow (update, delete) Authenticated user can update/delete their own listing.
     * @deny (create) Non-authenticated user cannot create a listing.
     * @deny (update, delete) User cannot update/delete a listing they don't own.
     * @principle Allows public read access while enforcing ownership for writes.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }

      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.sellerId);
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Manages access to job posting documents.
     * @path /jobs/{jobId}
     * @allow (get, list) Public read access for all job postings.
     * @allow (create) Authenticated recruiter can create a job posting with their UID as recruiterId.
     * @allow (update, delete) Authenticated recruiter can update/delete their own job posting.
     * @deny (create) Non-authenticated user cannot create a job posting.
     * @deny (update, delete) User cannot update/delete a job posting they don't own.
     * @principle Allows public read access while enforcing ownership for writes.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }

      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.recruiterId);
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Manages access to job application documents under a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) Authenticated user can create an application with their UID as applicantId.
     * @allow (get) Any authenticated user can get a specific application.
     * @allow (list) Only the recruiter who owns the job can list applications.
     * @allow (update, delete) No one can update or delete an application after it's submitted.
     * @deny (create) Non-authenticated user cannot create an application.
     * @deny (get) Non-authenticated user cannot read applications.
     * @deny (list) Non-authenticated user cannot list applications.
     * @principle Restricts creation to authenticated users, listing to the job owner.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isApplicant(applicantId) {
        return request.auth.uid == applicantId;
      }

      function isRecruiterForJob(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && isRecruiterForJob(jobId);
      allow create: if isSignedIn() && isApplicant(request.resource.data.applicantId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to feedback documents.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Authenticated user can create a feedback document.
     * @allow (get, list) Public read access.
     * @deny (update, delete) No one can update or delete feedback.
     * @principle Allows public read access and authenticated creation.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to company profile documents.
     * @path /companies/{companyId}
     * @allow (get, list) Public read access for all company profiles.
     * @deny (create, update, delete) Only backend services can modify company profiles.
     * @principle Allows public read access, restricts writes.
     */
    match /companies/{companyId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}