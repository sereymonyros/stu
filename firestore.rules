/**
 * @fileoverview Firestore Security Rules for the job board application.
 *
 * Core Philosophy:
 * This ruleset prioritizes user data protection, enforcing strict ownership for user-related data while allowing public read access to listings and jobs.
 *
 * Data Structure:
 * - User profiles and associated data (applications, favorites, saved searches) are nested under `/users/{userId}`.
 * - Publicly visible job postings and listings reside in the top-level collections `/jobs` and `/listings`.
 * - Chats and messages are in `/chats/{chatId}/messages/{messageId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listings and jobs are publicly readable, but creating, updating, or deleting them is restricted to authorized users (e.g., the seller or recruiter).
 * - Listing isFavorite and Job isFavorite are client-side flags and are not validated
 * - Chats are accessible only to the participants.
 * - User listing is disallowed.
 *
 * Denormalization for Authorization:
 * - Listings denormalize `sellerId` for owner-only write access.
 * - Jobs denormalize `recruiterId` for owner-only write access.
 * - Chats denormalize `participants` array to control read and write access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is one of the participants in the chat.
     */
    function isParticipant(participantIds) {
        return isSignedIn() && participantIds.hasAny([request.auth.uid]);
    }

    /**
     * @description Root match to prevent listing all documents in the database.
     * @path /
     * @allow (list) false - Listing the entire database is never permitted.
     * @deny (list) A request to list the entire database.
     * @principle Prevents unrestricted data discovery.
     */
    match /{document=**} {
        allow list: if false;
    }

    /**
     * @description Manages user profile access.
     * @path /users/{userId}
     * @allow (get) Authenticated user getting their own profile.
     * @allow (create) Authenticated user creating their own profile (with matching userId and uid).
     * @allow (update) Authenticated user updating their own profile.
     * @allow (delete) Authenticated user deleting their own profile.
     * @deny (get) Another user attempting to get this user's profile.
     * @deny (create) Another user attempting to create a profile with this user's ID.
     * @deny (update) Another user attempting to update this user's profile.
     * @deny (delete) Another user attempting to delete this user's profile.
     * @principle Enforces strict user ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages user application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get) Authenticated user getting their own application reference.
     * @allow (create) Authenticated user creating their own application reference.
     * @allow (update) Authenticated user updating their own application reference.
     * @allow (delete) Authenticated user deleting their own application reference.
     * @deny (get) Another user attempting to get this user's application reference.
     * @deny (create) Another user attempting to create an application reference with this user's ID.
     * @deny (update) Another user attempting to update this user's application reference.
     * @deny (delete) Another user attempting to delete this user's application reference.
     * @principle Enforces strict user ownership for application references.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages user favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get) Authenticated user getting their own favorite job reference.
     * @allow (create) Authenticated user creating their own favorite job reference.
     * @allow (update) Authenticated user updating their own favorite job reference.
     * @allow (delete) Authenticated user deleting their own favorite job reference.
     * @deny (get) Another user attempting to get this user's favorite job reference.
     * @deny (create) Another user attempting to create a favorite job reference with this user's ID.
     * @deny (update) Another user attempting to update this user's favorite job reference.
     * @deny (delete) Another user attempting to delete this user's favorite job reference.
     * @principle Enforces strict user ownership for favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages user saved search criteria.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (get) Authenticated user getting their own saved search.
     * @allow (create) Authenticated user creating their own saved search.
     * @allow (update) Authenticated user updating their own saved search.
     * @allow (delete) Authenticated user deleting their own saved search.
     * @deny (get) Another user attempting to get this user's saved search.
     * @deny (create) Another user attempting to create a saved search with this user's ID.
     * @deny (update) Another user attempting to update this user's saved search.
     * @deny (delete) Another user attempting to delete this user's saved search.
     * @principle Enforces strict user ownership for saved search criteria.
     */
    match /users/{userId}/savedSearches/{searchId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to listings.
     * @path /listings/{listingId}
     * @allow (get) Public read access for all listings.
     * @allow (list) Public read access for listing.
     * @allow (create) Seller creating a new listing.
     * @allow (update) Seller updating an existing listing.
     * @allow (delete) Seller deleting their own listing.
     * @deny (create) Another user attempting to create listing.
     * @deny (update) Another user attempting to update listing.
     * @deny (delete) Another user attempting to delete listing.
     * @principle Provides public read access with owner-only writes.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Manages access to job postings.
     * @path /jobs/{jobId}
     * @allow (get) Public read access for all job postings.
     * @allow (list) Public read access for all job postings.
     * @allow (create) Recruiter creating a new job posting.
     * @allow (update) Recruiter updating an existing job posting.
     * @allow (delete) Recruiter deleting their own job posting.
     * @deny (create) Another user attempting to create a job posting.
     * @deny (update) Another user attempting to update a job posting.
     * @deny (delete) Another user attempting to delete a job posting.
     * @principle Provides public read access with owner-only writes.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Manages access to job applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get) Applicant getting their own application or the recruiter getting the application.
     * @allow (list) Recruiter listing all applications for a job.
     * @allow (create) Applicant creating a new application.
     * @allow (update) Applicant or recruiter updating the application.
     * @allow (delete) Applicant or recruiter deleting the application.
     * @deny (create) Another user attempting to create application.
     * @deny (update) Another user attempting to update application.
     * @deny (delete) Another user attempting to delete application.
     * @principle Controls access to job applications based on applicant and recruiter roles.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.applicantId);
      allow list: if isSignedIn(); // TODO: Implement recruiter role check for listing.
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isExistingOwner(request.resource.data.applicantId) || isExistingOwner(resource.data.recruiterId); // TODO: Implement recruiter role check for updating.
      allow delete: if isExistingOwner(request.resource.data.applicantId) || isExistingOwner(resource.data.recruiterId); // TODO: Implement recruiter role check for deleting.
    }

    /**
     * @description Manages access to chats.
     * @path /chats/{chatId}
     * @allow (get) Participants getting the chat.
     * @allow (list) Participants listing the chats they are in.
     * @allow (create) Participants creating a new chat.
     * @allow (update) Participants updating the chat.
     * @allow (delete) Participants deleting the chat.
     * @deny (get) Another user attempting to get the chat.
     * @deny (create) Another user attempting to create a chat with this user's ID.
     * @deny (update) Another user attempting to update the chat.
     * @deny (delete) Another user attempting to delete the chat.
     * @principle Enforces strict participants-only for chat data.
     */
    match /chats/{chatId} {
      allow get: if isParticipant(resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isExistingOwner(request.resource.data.participants);
      allow delete: if isExistingOwner(request.resource.data.participants);
    }

    /**
     * @description Manages access to messages within a chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get) Participants getting the message.
     * @allow (list) Participants listing the messages they are in.
     * @allow (create) Participants creating a new message.
     * @allow (update) Participants updating the message.
     * @allow (delete) Participants deleting the message.
     * @deny (get) Another user attempting to get the message.
     * @deny (create) Another user attempting to create a message with this user's ID.
     * @deny (update) Another user attempting to update the message.
     * @deny (delete) Another user attempting to delete the message.
     * @principle Enforces strict participants-only for message data.
     */
    match /chats/{chatId}/messages/{messageId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to user feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get) Public read access for all feedback.
     * @allow (list) Public read access for all feedback.
     * @allow (create) Authenticated user creating feedback.
     * @allow (update) No updates allowed.
     * @allow (delete) No deletes allowed.
     * @deny (create) Another user attempting to create feedback.
     * @deny (update) No updates allowed.
     * @deny (delete) No deletes allowed.
     * @principle Provides public read access with authenticated user creation and no updates or deletes.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to company profiles.
     * @path /companies/{companyId}
     * @allow (get) Public read access for all company profiles.
     * @allow (list) Public read access for all company profiles.
     * @allow (create) Anyone can create a company profile.
     * @allow (update) No updates allowed.
     * @allow (delete) No deletes allowed.
     * @deny (update) No updates allowed.
     * @deny (delete) No deletes allowed.
     * @principle Provides public read access with open create and no updates or deletes.
     */
    match /companies/{companyId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}