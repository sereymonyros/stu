/**
 * @file Firebase Security Rules for Firestore.
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user profiles and their associated data.
 * Listings and jobs are publicly readable but writable only by their owners. Chats and messages are restricted to participants.
 *
 * @data_structure
 * - /users/{userId}: Stores public user profiles.
 * - /users/{userId}/favoriteJobs/{jobId}: Stores user's favorite jobs.
 * - /listings/{listingId}: Stores listings.
 * - /jobs/{jobId}: Stores job postings.
 * - /chats/{chatId}: Stores chat sessions.
 * - /chats/{chatId}/messages/{messageId}: Stores messages within a chat.
 *
 * @key_security_decisions
 * - User profiles are only readable and writable by the owning user.
 * - Listings and jobs are publicly readable but only writable by the creator (owner).
 * - Chats and messages are restricted to the participants.
 * - Listing all users is disallowed.
 *
 * @denormalization_for_authorization
 * - Listings and Jobs include `sellerId` and `recruiterId` fields respectively, to avoid needing to perform additional reads for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create a profile at /users/user123.
     * @allow (get) - User with UID 'user123' can read their profile at /users/user123.
     * @allow (update) - User with UID 'user123' can update their profile at /users/user123.
     * @allow (delete) - User with UID 'user123' can delete their profile at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get) - User with UID 'user456' cannot read profile /users/user123.
     * @deny (update) - User with UID 'user456' cannot update profile /users/user123.
     * @deny (delete) - User with UID 'user456' cannot delete profile /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Secure a user's list of favorite jobs. Only the authenticated user can read or write their own favorites.
     * @path /users/{userId}/favoriteJobs/{jobId}
     * @allow (create) - User with UID 'user123' can create a favorite job at /users/user123/favoriteJobs/job456.
     * @allow (get) - User with UID 'user123' can read their favorite job at /users/user123/favoriteJobs/job456.
     * @allow (update) - User with UID 'user123' can update their favorite job at /users/user123/favoriteJobs/job456.
     * @allow (delete) - User with UID 'user123' can delete their favorite job at /users/user123/favoriteJobs/job456.
     * @deny (create) - User with UID 'user456' cannot create a favorite job at /users/user123/favoriteJobs/job456.
     * @deny (get) - User with UID 'user456' cannot read favorite job /users/user123/favoriteJobs/job456.
     * @deny (update) - User with UID 'user456' cannot update favorite job /users/user123/favoriteJobs/job456.
     * @deny (delete) - User with UID 'user456' cannot delete favorite job /users/user123/favoriteJobs/job456.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/favoriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Secure listings. Any user can read listings, but only the seller can create, update, or delete.
     * @path /listings/{listingId}
     * @allow (get) - Any user can read a listing at /listings/listing123.
     * @allow (list) - Any user can list listings in /listings.
     * @allow (create) - User with UID 'user123' can create a listing at /listings/listing123 if resource.data.sellerId == 'user123'.
     * @allow (update) - User with UID 'user123' can update a listing at /listings/listing123 if resource.data.sellerId == 'user123'.
     * @allow (delete) - User with UID 'user123' can delete a listing at /listings/listing123 if resource.data.sellerId == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a listing at /listings/listing123.
     * @deny (update) - User with UID 'user456' cannot update listing /listings/listing123.
     * @deny (delete) - User with UID 'user456' cannot delete listing /listings/listing123.
     * @principle Allows public reads with owner-only writes, enforces ownership on create, update, and delete.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.sellerId);
      allow update: if isOwner(resource.data.sellerId) && resource != null;
      allow delete: if isOwner(resource.data.sellerId) && resource != null;
    }

    /**
     * @description Secure job postings. Any user can read job postings, but only the recruiter can create, update, or delete.
     * @path /jobs/{jobId}
     * @allow (get) - Any user can read a job posting at /jobs/job123.
     * @allow (list) - Any user can list job postings in /jobs.
     * @allow (create) - Recruiter with UID 'recruiter123' can create a job at /jobs/job123 if resource.data.recruiterId == 'recruiter123'.
     * @allow (update) - Recruiter with UID 'recruiter123' can update a job at /jobs/job123 if resource.data.recruiterId == 'recruiter123'.
     * @allow (delete) - Recruiter with UID 'recruiter123' can delete a job at /jobs/job123 if resource.data.recruiterId == 'recruiter123'.
     * @deny (create) - Recruiter with UID 'recruiter456' cannot create a job at /jobs/job123.
     * @deny (update) - Recruiter with UID 'recruiter456' cannot update job /jobs/job123.
     * @deny (delete) - Recruiter with UID 'recruiter456' cannot delete job /jobs/job123.
     * @principle Allows public reads with owner-only writes, enforces ownership on create, update, and delete.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.recruiterId);
      allow update: if isOwner(resource.data.recruiterId) && resource != null;
      allow delete: if isOwner(resource.data.recruiterId) && resource != null;
    }

    /**
     * @description Secure chat sessions. Only participants (buyer and seller) can read or write chat data.
     * @path /chats/{chatId}
     * @allow (get) - User with UID 'user123' can read chat /chats/chat1 if they are either the buyer or the seller.
     * @allow (list) - User with UID 'user123' can list chats if they are a participant.
     * @allow (create) - User with UID 'user123' can create a chat if they are the buyer or seller.
     * @allow (update) - User with UID 'user123' can update chat /chats/chat1 if they are either the buyer or the seller.
     * @allow (delete) - User with UID 'user123' can delete chat /chats/chat1 if they are either the buyer or the seller.
     * @deny (get) - User with UID 'user456' cannot read chat /chats/chat1 if they are not a participant.
     * @deny (update) - User with UID 'user456' cannot update chat /chats/chat1 if they are not a participant.
     * @principle Enforces shared access (closed collaborators).
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId;
      }

      allow get: if isParticipant();
      allow list: if get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
      allow create: if request.auth.uid == request.resource.data.buyerId || request.auth.uid == request.resource.data.sellerId;
      allow update: if isParticipant() && resource != null;
      allow delete: if isParticipant() && resource != null;
    }

    /**
     * @description Secure messages within a chat. Only participants of the chat can read or write messages.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get) - User with UID 'user123' can read a message at /chats/chat1/messages/message1 if they are a participant in chat1.
     * @allow (list) - User with UID 'user123' can list messages in /chats/chat1/messages if they are a participant in chat1.
     * @allow (create) - User with UID 'user123' can create a message at /chats/chat1/messages/message1 if they are a participant in chat1.
     * @allow (update) - User with UID 'user123' can update a message at /chats/chat1/messages/message1 if they are a participant in chat1.
     * @allow (delete) - User with UID 'user123' can delete a message at /chats/chat1/messages/message1 if they are a participant in chat1.
     * @deny (get) - User with UID 'user456' cannot read a message at /chats/chat1/messages/message1 if they are not a participant in chat1.
     * @deny (create) - User with UID 'user456' cannot create a message at /chats/chat1/messages/message1 if they are not a participant in chat1.
     * @principle Enforces shared access (closed collaborators), requires checking parent chat document for participants.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid
               || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
      }

      allow get: if isChatParticipant();
      allow list: if isChatParticipant();
      allow create: if isChatParticipant();
      allow update: if false;
      allow delete: if false;
    }
  }
}