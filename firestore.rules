/**
 * @fileoverview Firestore Security Rules for the job board application.
 *
 * Core Philosophy:
 * This ruleset prioritizes user privacy and data ownership. Users can only
 * read and modify their own profile data. Public data (listings, jobs) are
 * generally readable, but write access is restricted to authorized users
 * (sellers, recruiters).
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /listings/{listingId}: Contains items for sale.
 * - /jobs/{jobId}: Contains job postings.
 * - /chats/{chatId}: Contains chat sessions between users.
 * - /feedbacks/{feedbackId}: Contains feedback data for the application.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to the listings and jobs collections.
 * - Ownership is enforced for user profiles and related subcollections.
 * - Data validation is minimized in this prototyping phase.
 *
 * Denormalization for Authorization:
 *  - Listings have a `sellerId` field for easy ownership checks.
 *  - Jobs have a `recruiterId` field for easy ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @allow (get, update, delete) Authenticated user can access their own profile.
     * @deny (create, get, update, delete) Unauthorized access is denied.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to a user's favorite job listings.
     * @path /users/{userId}/favoriteJobs/{jobId}
     * @allow (create, get, list, update, delete) Authenticated user can manage their own favorite jobs.
     * @deny (create, get, list, update, delete) Unauthorized access is denied.
     * @principle Enforces document ownership for favorite jobs.
     */
    match /users/{userId}/favoriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to listing documents.
     * @path /listings/{listingId}
     * @allow (get, list) Anyone can view listings.
     * @allow (create) Authenticated seller can create a listing.
     * @allow (update, delete) Only the seller can modify or delete a listing.
     * @deny (create, update, delete) Unauthorized access is denied.
     * @principle Enforces public read access with owner-only writes for listings.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }

      function isExistingOwner() {
        return resource.data.sellerId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner();
      allow delete: if isSignedIn() && isExistingOwner();
    }

    /**
     * @description Controls access to job documents.
     * @path /jobs/{jobId}
     * @allow (get, list) Anyone can view job postings.
     * @allow (create) Authenticated recruiter can create a job posting.
     * @allow (update, delete) Only the recruiter can modify or delete a job posting.
     * @deny (create, update, delete) Unauthorized access is denied.
     * @principle Enforces public read access with owner-only writes for jobs.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }

      function isExistingOwner() {
        return resource.data.recruiterId == request.auth.uid;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner();
      allow delete: if isSignedIn() && isExistingOwner();
    }

    /**
     * @description Controls access to application documents for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) Authenticated users can apply for jobs.
     * @allow (get, list) Only the recruiter who posted the job can view applications.
     * @allow (update, delete) No one can update or delete applications.
     * @deny (create, get, list, update, delete) Unauthorized access is denied.
     * @principle Restricts access to job applications based on job ownership.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isJobOwner(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn() && isJobOwner(jobId);
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to chat documents.
     * @path /chats/{chatId}
     * @allow (get, list) Only participants (buyer or seller) can view chats.
     * @allow (create) Authenticated users can create a chat if they are a participant.
     * @allow (update) Only participants can update the chat (e.g., last message).
     * @deny (create, get, list, update, delete) Unauthorized access is denied.
     * @principle Restricts chat access to participants only.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn() && isParticipant();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isParticipant();
      allow delete: if false;
    }

    /**
     * @description Controls access to messages within a chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) Only chat participants can view messages.
     * @allow (create) Only chat participants can send messages.
     * @deny (create, get, list, update, delete) Unauthorized access is denied.
     * @principle Restricts message access to chat participants only.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant(chatId) {
        let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
        return chat.buyerId == request.auth.uid
               || chat.sellerId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn() && isParticipant(chatId);
      allow create: if isSignedIn() && isParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to feedback documents.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Authenticated users can submit feedback.
     * @allow (get, list) Anyone can view feedback.
     * @deny (update, delete) Feedback cannot be updated or deleted.
     * @principle Allows public read access for feedback.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}