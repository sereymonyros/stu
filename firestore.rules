/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and their associated data,
 *              and a shared access model for chats. Public read access is allowed for listings and jobs,
 *              but writes are restricted to the owner (seller or recruiter, respectively). Feedback is public,
 *              but can only be created with the correct `userId`.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, owned by the user.
 * - /users/{userId}/applications/{applicationId}: Job applications submitted by the user.
 * - /users/{userId}/favouriteJobs/{jobId}: Jobs favorited by the user.
 * - /listings/{listingId}: Listings for items for sale, with public read and owner-only write.
 * - /jobs/{jobId}: Job postings, with public read and recruiter-only write.
 * - /jobs/{jobId}/applications/{applicationId}: Applications for a specific job, owned by the applicant.
 * - /chats/{chatId}: Chat sessions between users, with access granted to participants.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat session.
 * - /feedbacks/{feedbackId}: Public feedback, but restricted to authenticated user's `userId`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listings and Jobs are publicly readable but writes are restricted to owners.
 * - Chat access is granted to participants only.
 * - Listing of user subcollections (applications, favouriteJobs) is allowed only for the owner.
 *
 * Denormalization for Authorization:
 * - Listings and Jobs must contain an `sellerId` and `recruiterId` respectively,
 *   to enforce owner-only writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access, ensuring users can only access their own data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their profile if request.auth.uid == 'user_abc'
     * @allow (get, update, delete, list) - User with UID 'user_abc' can read/update/delete their profile
     * @deny (create, update, delete) - User with UID 'user_xyz' cannot modify user 'user_abc''s profile
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages job applications for a user, only accessible by the user.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) - User 'user_abc' creates an application reference.
     * @allow (get, list, update, delete) - User 'user_abc' manages their applications.
     * @deny (create, update, delete) - User 'user_xyz' cannot access 'user_abc''s applications.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
    }

       /**
     * @description Manages favourite jobs for a user, only accessible by the user.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) - User 'user_abc' creates a favourite job reference.
     * @allow (get, list, update, delete) - User 'user_abc' manages their favourite jobs.
     * @deny (create, update, delete) - User 'user_xyz' cannot access 'user_abc''s favourite jobs.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages access to listings, allowing public reads but restricting writes to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) - Anyone can read listings.
     * @allow (create) - Seller with UID 'user_abc' can create a listing if request.resource.data.sellerId == 'user_abc'.
     * @allow (update, delete) - Seller with UID 'user_abc' can modify/delete their listing if resource.data.sellerId == 'user_abc'.
     * @deny (create, update, delete) - User 'user_xyz' cannot modify 'user_abc''s listing.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.sellerId);
      allow update: if isSignedIn() && isOwner(resource.data.sellerId);
      allow delete: if isSignedIn() && isOwner(resource.data.sellerId);
    }

    /**
     * @description Manages access to job postings, allowing public reads but restricting writes to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) - Anyone can read job postings.
     * @allow (create) - Recruiter with UID 'recruiter_abc' can create a job if request.resource.data.recruiterId == 'recruiter_abc'.
     * @allow (update, delete) - Recruiter with UID 'recruiter_abc' can modify/delete their job if resource.data.recruiterId == 'recruiter_abc'.
     * @deny (create, update, delete) - User 'user_xyz' cannot modify 'recruiter_abc''s job.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.recruiterId);
      allow update: if isSignedIn() && isOwner(resource.data.recruiterId);
      allow delete: if isSignedIn() && isOwner(resource.data.recruiterId);
    }

        /**
     * @description Manages job applications for a specific job, only accessible by the applicant.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) - Applicant with UID 'applicant_abc' creates an application if request.resource.data.applicantId == 'applicant_abc'.
     * @allow (get, list, update, delete) - Applicant with UID 'applicant_abc' manages their applications.
     * @deny (create, update, delete) - User 'user_xyz' cannot access 'applicant_abc''s applications.
     * @principle Restricts access to a user's own data tree.
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isOwner(applicantId) {
            return request.auth.uid == applicantId;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        function isExistingOwner(applicantId) {
          return isOwner(applicantId) && resource != null;
        }
        allow get: if isSignedIn() && isOwner(resource.data.applicantId);
        allow list: if false;
        allow create: if isSignedIn() && isOwner(request.resource.data.applicantId);
        allow update: if isSignedIn() && isExistingOwner(resource.data.applicantId);
        allow delete: if isSignedIn() && isExistingOwner(resource.data.applicantId);
    }

    /**
     * @description Manages chat sessions, allowing access only to participants.
     * @path /chats/{chatId}
     * @allow (get, list) - User 'user_abc' can read the chat if they are a participant.
     * @allow (create, update, delete) - If current user is a participant (e.g. buyerId and sellerId), can write.
     * @deny (create, update, delete) - User 'user_xyz' cannot access the chat if they are not a participant.
     * @principle Enforces shared access to chat sessions.
     */
    match /chats/{chatId} {
        function isSignedIn() {
          return request.auth != null;
        }
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }

      allow get, list: if isSignedIn() && isParticipant();
      allow create: if isSignedIn() && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if isSignedIn() && isParticipant();
      allow delete: if false; // Deleting chats is not permitted
    }

    /**
     * @description Manages messages within a chat, allowing access only to chat participants.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list, create) - User 'user_abc' can read/create messages if they are a participant in the chat.
     * @deny (create, update, delete) - User 'user_xyz' cannot access messages if they are not a participant in the chat.
     * @principle Enforces shared access to chat messages based on chat membership.
     */
    match /chats/{chatId}/messages/{messageId} {
       function isParticipant(chatId) {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if isSignedIn() && isParticipant(chatId);
        allow list: if isSignedIn() && isParticipant(chatId);
        allow create: if isSignedIn() && isParticipant(chatId);
        allow update: if false; // Messages can't be updated
        allow delete: if false; // Messages can't be deleted
    }

     /**
     * @description Manages feedback submissions, allowing any authenticated user to submit feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) - Anyone can view feedbacks.
     * @allow (create) - User 'user_abc' can submit feedback if request.auth.uid == request.resource.data.userId.
     * @deny (create, update, delete) - User 'user_xyz' cannot submit feedback on behalf of 'user_abc'.
     * @principle Allows public read access for feedback, but enforces ownership for creation.
     */
    match /feedbacks/{feedbackId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if false; // Feedback is not allowed to be updated.
      allow delete: if false; // Feedback is not allowed to be deleted.
    }
  }
}