/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and
 * associated data. Listings, jobs, chats, messages, and feedback have specific
 * access control rules based on their relationships to users. Public read access
 * is granted where appropriate, with owner-only write access.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data.  All data nested under a /users/{userId}
 *   path is considered private to that user.
 * - /listings/{listingId}: Stores listings.  Listings have a sellerId property
 *   indicating the owner.
 * - /jobs/{jobId}: Stores job postings. Jobs have a recruiterId indicating the
 *   owner.
 * - /chats/{chatId}: Stores chat sessions between users. Uses a participants array
 *   to manage access.
 * - /feedbacks/{feedbackId}: Stores user feedback.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted for listings and jobs.
 * - Owner-only write access is enforced for user profiles and related data.
 * - Chat access is restricted to participants.
 * - The rules do NOT validate the entire object shape (e.g., hasAll([...]))
 *   and data types for general content fields (e.g., request.resource.data.description is string
 *   or request.resource.data.isCompleted is bool).
 *
 * Denormalization for Authorization:
 * - Listings and jobs include a sellerId/recruiterId field to enable owner-based
 *   authorization without additional reads.
 * - Chats include a participants array for efficient access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, list): Anyone can read a user profile.
     * @allow (create): Only the user themselves can create their profile.
     * @allow (update, delete): Only the user themselves can update or delete their profile, and only if it exists.
     * @deny (create): Cannot create a profile for another user.
     * @deny (update, delete): Cannot update/delete another user's profile.
     * @principle Enforces document ownership for writes and allows public reads.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update, delete: if isSignedIn() && isExistingOwner(userId) && request.resource.data.uid == userId;
    }

    /**
     * @description Controls access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (list): Only the user themselves can list their applications.
     * @allow (create): Only the user themselves can create application references.
     * @allow (get, update, delete): Only the user themselves can get, update, or delete their application references, and only if the reference exists.
     * @deny (create): Cannot create application references for another user.
     * @deny (get, list, update, delete): Cannot get, list, update, or delete another user's application references.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow get, update, delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to a user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (list): Only the user themselves can list their favorite jobs.
     * @allow (create): Only the user themselves can create favorite job references.
     * @allow (get, update, delete): Only the user themselves can get, update, or delete their favorite job references, and only if the reference exists.
     * @deny (create): Cannot create favorite job references for another user.
     * @deny (get, list, update, delete): Cannot get, list, update, or delete another user's favorite job references.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow get, update, delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to listing documents.
     * @path /listings/{listingId}
     * @allow (get, list): Anyone can read listings.
     * @allow (create): Only a signed-in user can create a listing, and the sellerId must match the user's UID.
     * @allow (update, delete): Only the seller can update or delete a listing, and only if it exists.
     * @deny (create): Cannot create a listing for another user.
     * @deny (update, delete): Cannot update/delete a listing that doesn't exist or isn't owned by the user.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource != null && resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description Controls access to job documents.
     * @path /jobs/{jobId}
     * @allow (get, list): Anyone can read job postings.
     * @allow (create): Only a signed-in user can create a job, and the recruiterId must match the user's UID.
     * @allow (update, delete): Only the recruiter can update or delete a job, and only if it exists.
     * @deny (create): Cannot create a job posting for another user.
     * @deny (update, delete): Cannot update/delete a job posting that doesn't exist or isn't owned by the user.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource != null && resource.data.recruiterId == request.auth.uid;
    }

    /**
     * @description Controls access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (list): Only the recruiter who owns the job can list applications.
     * @allow (create): Only a signed-in user can apply, and the applicantId must match the user's UID.
     * @allow (get, update, delete): Only the recruiter or applicant can get, update, or delete an application, and only if the application exists.
     * @deny (create): Cannot create an application for another user.
     * @deny (update, delete): Cannot update/delete an application that doesn't exist or that the user isn't authorized to manage.
     * @principle Enforces document ownership and recruiter-based access for job applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow list: if isSignedIn() && isJobOwner(jobId, request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow get, update, delete: if isSignedIn() && resource != null && (isJobOwner(jobId, request.auth.uid) || resource.data.applicantId == request.auth.uid);
    }

    /**
     * @description Controls access to chat documents.
     * @path /chats/{chatId}
     * @allow (get, list): Only participants can read/list chat documents.
     * @allow (create): Only signed-in users can create a chat, and they must be one of the participants.
     * @allow (update, delete): Only participants can update/delete chat documents, and only if the chat exists.
     * @deny (create): Cannot create a chat without being a participant.
     * @deny (update, delete): Cannot update/delete a chat if not a participant.
     * @principle Enforces access control based on chat participants.
     */
    match /chats/{chatId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update, delete: if isSignedIn() && resource != null && request.auth.uid in resource.data.participants;
    }

    /**
     * @description Controls access to messages within a specific chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (list): Only participants of the chat can list messages.
     * @allow (create): Only participants of the chat can create messages.
     * @allow (get, update, delete): Only participants of the chat can get, update, or delete messages, and only if the chat exists.
     * @deny (create): Cannot create messages in a chat without being a participant.
     * @deny (get, list, update, delete): Cannot get, list, update, or delete messages if not a participant.
     * @principle Enforces access control based on chat participants.
     */
    match /chats/{chatId}/messages/{messageId} {
      allow list: if isSignedIn() && isChatParticipant(chatId, request.auth.uid);
      allow create: if isSignedIn() && isChatParticipant(chatId, request.auth.uid);
      allow get, update, delete: if isSignedIn() && resource != null && isChatParticipant(chatId, request.auth.uid);
    }

    /**
     * @description Controls access to feedback documents.
     * @path /feedbacks/{feedbackId}
     * @allow (create): Only signed-in users can create feedback documents, and the userId must match their UID.
     * @allow (get, list): Anyone can read feedback.
     * @allow (update, delete): No one can update or delete feedback after it's created.
     * @deny (create): Cannot create feedback for another user.
     * @principle Enforces document ownership for creation, allows public reads, and disallows updates/deletes.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description Determines if the user is the owner of the account.
     * @param {string} userId The user ID from the path.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Determines if the user is the owner of the account and the resource exists.
     * @param {string} userId The user ID from the path.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Determines if the user is the owner of the job.
     * @param {string} jobId The job ID.
     * @param {string} userId The user ID.
     * @return {boolean} True if the user is the owner of the job, false otherwise.
     */
    function isJobOwner(jobId, userId) {
      return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == userId;
    }

    /**
     * @description Checks if the user is a participant in the chat.
     * @param {string} chatId The chat ID.
     * @param {string} userId The user ID.
     * @return {boolean} True if the user is a participant, false otherwise.
     */
    function isChatParticipant(chatId, userId) {
      return userId in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
  }
}