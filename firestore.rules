/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict ownership and role-based access control.
 * It is tailored for rapid prototyping, emphasizing authorization over detailed data validation.
 *
 * Data Structure:
 * The data model includes user profiles, listings, jobs, applications, chats, and feedback.
 * User-specific data is nested under `/users/{userId}`.
 * Public listings and jobs are stored in top-level collections.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and related subcollections.
 * - Recruiters can manage jobs they created.
 * - Public read access is granted for listings and jobs, with owner-only writes.
 * - Listing is allowed on user-scoped subcollections (e.g., `/users/{userId}/...`) by default,
 *   but can be restricted if the data model or reasoning explicitly forbids it.
 * - Open write rules are strictly forbidden.
 *
 * Denormalization for Authorization:
 * To avoid costly `get()` calls, authorization-critical data (e.g., ownership) is denormalized
 * directly onto the secured documents. For example, the `Job` entity contains a `recruiterId`
 * field for easy ownership checks.
 *
 * Structural Segregation:
 * Publicly readable data (listings, jobs) is stored in top-level collections, separate from private
 * user data. This allows for efficient and secure list operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants owner-only access to user profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if the user's UID matches the userId.
     * @deny (get, create, update, delete, list) if the user's UID does not match the userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);

      /**
       * @description Grants owner-only access to a user's job application references.
       * @path /users/{userId}/applications/{applicationId}
       * @allow (get, create, update, delete, list) if the user's UID matches the userId.
       * @deny (get, create, update, delete, list) if the user's UID does not match the userId.
       * @principle Restricts access to a user's own data tree.
       */
      match /applications/{applicationId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }

      /**
       * @description Grants owner-only access to a user's favorite job references.
       * @path /users/{userId}/favouriteJobs/{jobId}
       * @allow (get, create, update, delete, list) if the user's UID matches the userId.
       * @deny (get, create, update, delete, list) if the user's UID does not match the userId.
       * @principle Restricts access to a user's own data tree.
       */
      match /favouriteJobs/{jobId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    /**
     * @description Grants public read access to listings with owner-only writes.
     * @path /listings/{listingId}
     * @allow (get, list) to anyone.
     * @allow (create) if the sellerId matches the user's UID.
     * @allow (update, delete) if the user is the owner of the listing.
     * @deny (create, update, delete) if the above conditions are not met.
     * @principle Allows public reads, but enforces document ownership for writes.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description Grants public read access to job postings with recruiter-only writes.
     * @path /jobs/{jobId}
     * @allow (get, list) to anyone.
     * @allow (create) if the recruiterId matches the user's UID.
     * @allow (update, delete) if the user is the recruiter of the job.
     * @deny (create, update, delete) if the above conditions are not met.
     * @principle Allows public reads, but enforces document ownership for writes.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;

      /**
       * @description Allows a recruiter to list applications for their job.
       * @path /jobs/{jobId}/applications/{applicationId}
       * @allow get: If the applicant id is the same as the authenticated user.
       * @allow list: If the recruiter id of the job is the same as the authenticated user
       * @allow create: If the applicant id is the same as the authenticated user.
       * @deny update: Always deny.
       * @deny delete: Always deny.
       *
       */
      match /applications/{applicationId} {
        allow get: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    /**
     * @description Grants access to chats based on participant list.
     * @path /chats/{chatId}
     * @allow (get, list) if the user is a participant in the chat.
     * @allow (create) if the user is one of the participants.
     * @allow (update, delete) if the user is the owner of the listing and a participant.
     * @principle Enforces access control based on chat participants.
     */
    match /chats/{chatId} {
      allow get: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow list: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if false; // Deletion disabled for chats
      /**
       * @description Grants access to messages based on chat participation.
       * @path /chats/{chatId}/messages/{messageId}
       * @allow (get, list, create) if the user is a participant in the parent chat.
       * @deny (update, delete) always.
       * @principle Enforces access control based on chat participants for messages.
       */
      match /messages/{messageId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow update: if false;
        allow delete: if false;
      }
    }

    /**
     * @description Allows anyone to create feedback, but only for themselves.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) to anyone.
     * @allow (create) if the userId matches the user's UID.
     * @allow (update, delete) to no one.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}