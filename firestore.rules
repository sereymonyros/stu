/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * and a public-read, owner-write model for top-level collections like 'listings' and 'jobs'.
 *
 * Data Structure:
 * - User profiles and their related data (applications, favorites, saved searches) are nested under /users/{userId}.
 * - Listings, Jobs, Chats, and Feedbacks are stored in top-level collections.
 * - Applications are stored as subcollections under Jobs.
 * - Messages are stored as subcollections under Chats.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Users can only create saved searches under their own user ID.
 * - Listings and Jobs are publicly readable, but only the creator can modify them.
 * - Chats are accessible only to the participants.
 * - Listing isFavourite and Job isFavourite is client-side only.
 * - No user listing is allowed for any collection.
 *
 * Denormalization for Authorization:
 * - The 'Chat' entity denormalizes 'buyerId' and 'sellerId' into a 'participants' array for easy authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Grants access to user profile data only to the authenticated user.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is authenticated and the userId matches the authenticated user's ID.
     * @deny (get, create, update, delete) if the user is not authenticated or the userId does not match the authenticated user's ID.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's job applications only to the authenticated user.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, create, update, delete) if the user is authenticated and the userId matches the authenticated user's ID.
     * @deny (get, create, update, delete) if the user is not authenticated or the userId does not match the authenticated user's ID.
     * @principle Restricts access to a user's own job application references.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's favorite jobs only to the authenticated user.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, create, update, delete) if the user is authenticated and the userId matches the authenticated user's ID.
     * @deny (get, create, update, delete) if the user is not authenticated or the userId does not match the authenticated user's ID.
     * @principle Restricts access to a user's own favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's saved searches only to the authenticated user.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create) if the user is authenticated and the userId matches the authenticated user's ID.
     * @deny (create) if the user is not authenticated or the userId does not match the authenticated user's ID.
     * @principle Restricts creation access to a user's own saved searches.
     */
    match /users/{userId}/savedSearches/{searchId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts write access to the owner (seller).
     * @path /listings/{listingId}
     * @allow (get, list) to anyone.
     * @allow (create) if the sellerId in the request matches the authenticated user's ID.
     * @allow (update, delete) if the sellerId in the existing document matches the authenticated user's ID.
     * @deny (create, update, delete) if the sellerId does not match the authenticated user's ID.
     * @principle Implements public read, owner-write access control.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Allows public read access to jobs, but restricts write access to the owner (recruiter).
     * @path /jobs/{jobId}
     * @allow (get, list) to anyone.
     * @allow (create) if the recruiterId in the request matches the authenticated user's ID.
     * @allow (update, delete) if the recruiterId in the existing document matches the authenticated user's ID.
     * @deny (create, update, delete) if the recruiterId does not match the authenticated user's ID.
     * @principle Implements public read, owner-write access control.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Restricts access to job applications to only the applicant and the job poster.
     * @path /jobs/{jobId}/applications/{applicationId}
     *  @allow (create) if the applicantId matches the authenticated user's ID.
     * @allow (get, list) if the applicantId matches the authenticated user's ID OR the recruiterId of the parent job matches the authenticated user's ID.
     * @allow (update, delete) if the applicantId matches the authenticated user's ID OR the recruiterId of the parent job matches the authenticated user's ID.
     * @deny (get, list, create, update, delete) if neither condition is met.
     * @principle Restricts access based on applicant and recruiter roles.
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isApplicant(applicantId) {
            return isSignedIn() && request.auth.uid == applicantId;
        }

        function isRecruiter(jobId) {
            return isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
        }

      allow get: if isApplicant(resource.data.applicantId) || isRecruiter(jobId);
      allow list: if isApplicant(resource.data.applicantId) || isRecruiter(jobId);
      allow create: if isApplicant(request.resource.data.applicantId);
      allow update: if isExistingOwner(resource.data.applicantId) || isRecruiter(jobId);
      allow delete: if isExistingOwner(resource.data.applicantId) || isRecruiter(jobId);
    }

    /**
     * @description Restricts access to chat sessions to only the participants.
     * @path /chats/{chatId}
     * @allow (get, list) if the authenticated user's ID is present in the participants array.
     * @allow (create, update, delete) if the authenticated user's ID is present in the participants array.
     * @deny (get, list, create, update, delete) if the authenticated user's ID is not present in the participants array.
     * @principle Restricts access to participants only using the 'participants' array.
     */
    match /chats/{chatId} {
        function isParticipant() {
            return isSignedIn() && request.auth.uid in resource.data.participants;
        }

        function isCreatingParticipant() {
            return isSignedIn() && request.auth.uid in request.resource.data.participants;
        }

      allow get: if isParticipant();
      allow list: if false;
      allow create: if isCreatingParticipant();
      allow update: if isExistingOwner(resource.data.participants[0]) || isExistingOwner(resource.data.participants[1]);
      allow delete: if false; // Chats cannot be deleted for auditing.
    }

    /**
     * @description Restricts access to messages within a chat to only the chat participants.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) if the authenticated user is a participant in the chat.
     * @allow (create) if the authenticated user's ID matches the senderId.
     * @allow (update, delete) never.
     * @deny (get, list, create) if the conditions are not met.
     * @principle Restricts access to messages to chat participants, validating the sender.
     */
    match /chats/{chatId}/messages/{messageId} {
        function isChatMessageParticipant(chatId) {
          return isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        }

      allow get: if isChatMessageParticipant(chatId);
      allow list: if isChatMessageParticipant(chatId);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to create feedback, but restricts reading and modification.
     * @path /feedbacks/{feedbackId}
     * @allow get, list: if false;
     * @allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
     * @deny update, delete.
     */
    match /feedbacks/{feedbackId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}