/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a user-centric security model with strict ownership
 * and role-based access where appropriate. It emphasizes preventing unauthorized
 * data access and modification while providing the flexibility needed for prototyping.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Listings are stored under `/listings/{listingId}`.
 * - Jobs are stored under `/jobs/{jobId}`.
 * - Applications for jobs are stored under `/jobs/{jobId}/applications/{applicationId}`.
 * - Chats are stored under `/chats/{chatId}`.
 * - Messages within chats are stored under `/chats/{chatId}/messages/{messageId}`.
 * - User feedback is stored under `/feedbacks/{feedbackId}`.
 * - Favourite Jobs are stored under `/users/{userId}/favoriteJobs/{jobId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listings are publicly readable, but only the seller can modify or delete them.
 * - Jobs are publicly readable, but only the recruiter can modify or delete them.
 * - Applications can only be created by the applicant, and only the recruiter can review or reject them.
 * - Chats and messages are only accessible to the participants (buyer and seller).
 * - Feedback is publicly writeable (no auth required), but userId is saved to the document.
 * - Listing of user documents is only allowed to the owner.
 *
 * Denormalization for Authorization:
 * - Listings contain a `sellerId` field to easily verify ownership for modification.
 * - Jobs contain a `recruiterId` field to easily verify ownership for modification.
 * - Chats contain `buyerId` and `sellerId` fields to control access to the chat and its messages.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID matching the document ID can create their profile.
     * @allow (get, update, delete) - Authenticated user with UID matching the document ID can read, update, and delete their profile.
     * @deny (create) - Authenticated user with UID not matching the document ID cannot create the profile.
     * @deny (get, update, delete) - Authenticated user with UID not matching the document ID cannot read, update, and delete the profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their favourite jobs
     * @path /users/{userId}/favoriteJobs/{jobId}
     * @allow (create, get, list, update, delete) Authenticated user can manage their own favourite jobs.
     * @deny (create, get, list, update, delete) Authenticated user cannot manage other users' favourite jobs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/favoriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing all favorite jobs is disabled
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts modification to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) - Any user can read any listing.
     * @allow (create) - Authenticated user can create a listing if they set the sellerId to their own UID.
     * @allow (update, delete) - Authenticated user can update or delete a listing if they are the seller.
     * @deny (create) - Authenticated user cannot create a listing if they do not set the sellerId to their own UID.
     * @deny (update, delete) - Authenticated user cannot update or delete a listing if they are not the seller.
     * @principle Allows public reads, enforces document ownership for writes.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth.uid != null && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth.uid != null && resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description Allows public read access to jobs, but restricts modification to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) - Any user can read any job.
     * @allow (create) - Authenticated user can create a job if they set the recruiterId to their own UID.
     * @allow (update, delete) - Authenticated user can update or delete a job if they are the recruiter.
     * @deny (create) - Authenticated user cannot create a job if they do not set the recruiterId to their own UID.
     * @deny (update, delete) - Authenticated user cannot update or delete a job if they are not the recruiter.
     * @principle Allows public reads, enforces document ownership for writes.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid != null && request.resource.data.recruiterId == request.auth.uid;
      allow update: if request.auth.uid != null && resource.data.recruiterId == request.auth.uid;
      allow delete: if request.auth.uid != null && resource.data.recruiterId == request.auth.uid;
    }

    /**
     * @description Allows users to apply for jobs, and recruiters to manage applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) - Authenticated user can create an application if they set the applicantId to their own UID.
     * @allow (get, list) - Recruiter can read applications for their jobs.
     * @allow (update, delete) - Recruiter can update/delete application.
     * @deny (create) - Authenticated user cannot create an application if they do not set the applicantId to their own UID.
     * @deny (update, delete) - Authenticated user cannot update/delete applications for jobs they don't own.
     * @principle Enforces document ownership for application creation, recruiter control for management.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isApplicant(applicantId) {
        return request.auth.uid == applicantId;
      }
      function isRecruiter(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }
      allow get, list: if request.auth.uid != null && isRecruiter(jobId);
      allow create: if request.auth.uid != null && request.resource.data.applicantId == request.auth.uid;
      allow update, delete: if request.auth.uid != null && isRecruiter(jobId);
    }

    /**
     * @description Allows users to chat about listings.
     * @path /chats/{chatId}
     * @allow (create, get, list) - Buyer and seller can create a chat.
     * @allow (update, delete) - No one can update or delete a chat.
     * @principle Enforces shared access (closed collaborators).
     */
    match /chats/{chatId} {
        function isParticipant() {
            return request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId;
        }

        allow get, list: if request.auth.uid != null && isParticipant();
        allow create: if request.auth.uid != null && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
        allow update, delete: if false;
    }

    /**
     * @description Allows users to send messages within a chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create, get, list) - Buyer and seller can send messages.
     * @allow (update, delete) - No one can update or delete a message.
     * @principle Enforces shared access (closed collaborators).
     */
    match /chats/{chatId}/messages/{messageId} {
        function isParticipant(chatId) {
            let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
            return chat.buyerId == request.auth.uid || chat.sellerId == request.auth.uid;
        }

        allow get, list, create: if request.auth.uid != null && isParticipant(chatId);
        allow update, delete: if false;
    }

    /**
     * @description Allows users to submit feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create) - Authenticated users can submit feedback, setting their UID as the userId.
     * @allow (get, list) - any user can view the feedback.
     * @allow (update, delete) - no user can update or delete feedback.
     */
    match /feedbacks/{feedbackId} {
        allow get, list: if true;
        allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
    }
  }
}