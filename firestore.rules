/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes strong authorization based on user identity and
 * resource ownership. It leverages Firebase Authentication to control access
 * to data, ensuring that users can only read and modify data they own or have
 * explicit permissions to access. Data shape validation is relaxed to
 * accelerate prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile data, accessible only to the
 *   owning user.
 * - /users/{userId}/applications/{applicationId}: Stores lightweight references
 *   to job applications, accessible only to the owning user.
 * - /listings/{listingId}: Stores listing data, publicly readable but writable
 *   only by the seller.
 * - /jobs/{jobId}: Stores job posting data, writable only by the recruiter.
 * - /jobs/{jobId}/applications/{applicationId}: Stores applications for a
 *   specific job, writable only by the applicant.
 * - /chats/{chatId}: Stores chat session data, accessible to participants.
 * - /chats/{chatId}/messages/{messageId}: Stores messages within a chat,
 *   accessible to participants.
 * - /feedbacks/{feedbackId}: Stores user-submitted feedback, accessible to all.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Strict ownership is enforced for user-related data.
 * - Public read access is granted for listings and jobs to maximize visibility.
 * - Flexible data validation is enabled for rapid prototyping.
 *
 * Denormalization for Authorization:
 * - Listings and Jobs: The `sellerId` and `recruiterId` are denormalized to
 *   enable efficient ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) User with matching UID can access and modify their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @deny (list) Listing all users is not allowed.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User with matching UID can create application references.
     * @allow (get, list, update, delete) User with matching UID can access and manage their application references.
     * @deny (create) User cannot create application references with a mismatched UID.
     * @principle Enforces user-ownership for application references.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId);
      allow get, list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to listing data.
     * @path /listings/{listingId}
     * @allow (get, list) All users can view listings.
     * @allow (create) User can create a listing if they are the seller.
     * @allow (update, delete) Only the seller can update or delete their listing.
     * @deny (create) User cannot create a listing for another seller.
     * @principle Public read access with owner-only writes.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }

      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }

      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Controls access to job posting data.
     * @path /jobs/{jobId}
     * @allow (get, list) All users can view job postings.
     * @allow (create) Recruiter can create a job posting if they are the recruiter.
     * @allow (update, delete) Only the recruiter can update or delete their job posting.
     * @deny (create) User cannot create a job posting for another recruiter.
     * @principle Public read access with owner-only writes.
     */
    match /jobs/{jobId} {
      function isRecruiter(recruiterId) {
        return request.auth != null && request.auth.uid == recruiterId;
      }

      function isExistingRecruiter(recruiterId) {
        return isRecruiter(recruiterId) && resource != null;
      }

      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingRecruiter(resource.data.recruiterId);
      allow delete: if isExistingRecruiter(resource.data.recruiterId);
    }

    /**
     * @description Controls access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) User can create an application if they are the applicant.
     * @allow (get) User can get their own application.
     * @allow (list) Job Applications should only be listable by the recruiter.
     * @allow (update, delete) Only the applicant can update or delete their application.
     * @deny (create) User cannot create an application for another applicant.
     * @principle Enforces user-ownership for job applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isApplicant(applicantId) {
        return request.auth != null && request.auth.uid == applicantId;
      }

      function isExistingApplicant(applicantId) {
        return isApplicant(applicantId) && resource != null;
      }

      allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
      allow get: if isApplicant(resource.data.applicantId);
      allow list: if get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      allow update: if isExistingApplicant(resource.data.applicantId);
      allow delete: if isExistingApplicant(resource.data.applicantId);
    }

    /**
     * @description Controls access to chat session data.
     * @path /chats/{chatId}
     * @allow (create, get, list) Only participants can create, get, and list chats.
     * @allow (update, delete) Only participants can update or delete chats.
     * @principle Enforces shared access for chat participants.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      }

      function isNewParticipant() {
               return request.auth != null && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
      }

      function isExistingParticipant() {
        return isParticipant() && resource != null;
      }

      allow create: if request.auth != null && isNewParticipant();
      allow get, list: if isParticipant();
      allow update: if isExistingParticipant();
      allow delete: if isExistingParticipant();
    }

    /**
     * @description Controls access to messages within a specific chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create, get, list) Only participants can create, get, and list messages.
     * @allow (update, delete) Only participants can update or delete messages.
     * @principle Enforces shared access for chat participants.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant(chatId) {
        return request.auth != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid);
      }

      function isExistingParticipant(chatId) {
        return request.auth != null && isParticipant(chatId) && resource != null;
      }

      allow create: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
      allow get, list: if isParticipant(chatId);
      allow update: if isExistingParticipant(chatId);
      allow delete: if isExistingParticipant(chatId);
    }

    /**
     * @description Controls access to user-submitted feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create, get, list) All users can create, get, and list feedback.
     * @allow (update, delete) Only the user who submitted the feedback can update or delete it.
     * @principle Public read/write access with owner-only updates/deletes.
     */
    match /feedbacks/{feedbackId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create, get, list: if true;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}