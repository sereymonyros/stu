/**
 * @fileoverview Firestore Security Rules
 *
 * Core Philosophy:
 * This ruleset employs a strict user-ownership model, ensuring that users can only access and modify data associated with their own accounts,
 * with the exception of public listings and jobs which may be readable by anyone but only created/modified by authorized users (sellers/recruiters).
 *
 * Data Structure:
 * Data is organized hierarchically with user-specific data nested under `/users/{userId}`. Top-level collections like `/listings`, `/jobs`, `/chats`,
 * `/feedbacks`, and `/companies` store data accessible under specific conditions.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Read-only access is granted to public collections like `/listings` and `/jobs` to facilitate browsing.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 * - All write operations are protected by authorization checks based on user identity and roles.
 *
 * Denormalization for Authorization:
 * - `Listing` documents contain `sellerId` to quickly verify the seller's identity.
 * - `Job` documents contain `recruiterId` and `recruiterDisplayName` to easily identify the job poster.
 * - `Chat` documents contain `participants` (array of user IDs) to simplify access control for chat participants.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's UID and resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource);
    }

    /**
     * @description Allows anyone to read and owner to modify with ownership check to the resource.
     */
    function isPublicReadOnlyWithOwnerWrite(ownerField) {
        return {
            'read': allow get, list: if true;
            'write': allow create: if isSignedIn() && request.resource.data[ownerField] == request.auth.uid;
                     allow update, delete: if isSignedIn() && resource.data[ownerField] == request.auth.uid;
        }
    }

    /**
     * @description
     * Allows owner to read and write to their data tree.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if request.auth.uid == userId
     * @deny (get, create, update, delete, list) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isExistingOwner(userId);

      /**
       * @description
       * Allows a user to manage their job applications.
       * @path /users/{userId}/applications/{applicationId}
       * @allow (create) if request.auth.uid == userId
       * @deny (create) if request.auth.uid != userId
       * @principle Restricts access to a user's own data tree
       */
      match /applications/{applicationId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description
       * Allows a user to manage their favorite jobs.
       * @path /users/{userId}/favouriteJobs/{jobId}
       * @allow (create) if request.auth.uid == userId
       * @deny (create) if request.auth.uid != userId
       * @principle Restricts access to a user's own data tree
       */
      match /favouriteJobs/{jobId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description
       * Allows a user to manage their saved searches.
       * @path /users/{userId}/savedSearches/{searchId}
       * @allow (list, create, update, delete) if request.auth.uid == userId
       * @deny (list, create, update, delete) if request.auth.uid != userId
       * @principle Restricts access to a user's own data tree
       */
      match /savedSearches/{searchId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description
     * Allows public read but restricts creation, updating, and deletion of listings to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) if true
     * @allow (create) if request.auth.uid == request.resource.data.sellerId
     * @allow (update, delete) if request.auth.uid == resource.data.sellerId
     * @deny (create, update, delete) if request.auth.uid != resource.data.sellerId
     * @principle Enforces document ownership for writes, public read access
     */
    match /listings/{listingId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description
     * Allows public read but restricts creation, updating, and deletion of jobs to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) if true
     * @allow (create) if request.auth.uid == request.resource.data.recruiterId
     * @allow (update, delete) if request.auth.uid == resource.data.recruiterId
     * @deny (create, update, delete) if request.auth.uid != resource.data.recruiterId
     * @principle Enforces document ownership for writes, public read access
     */
    match /jobs/{jobId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.recruiterId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.recruiterId == request.auth.uid;

        /**
         * @description
         * Allows a recruiter to manage applications for their job postings.
         * @path /jobs/{jobId}/applications/{applicationId}
         * @allow (create) if request.auth.uid == resource.data.recruiterId
         * @deny (create) if request.auth.uid != resource.data.recruiterId
         * @principle Restricts access to a recruiter's own job applications
         */
        match /applications/{applicationId} {
            allow get: if true; // Public
            allow list: if true; // Public
            allow create: if isSignedIn(); // Any signed-in user can apply
            allow update: if false; // TODO: Add recruiter-only access
            allow delete: if false; // TODO: Add recruiter-only access
        }
    }

    /**
     * @description
     * Allows access to chats only to participants.
     * @path /chats/{chatId}
     * @allow (get, list) if request.auth.uid in resource.data.participants
     * @allow (create, update, delete) if false
     * @principle Shared Access (Closed Collaborators)
     */
    match /chats/{chatId} {
        allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow create: if false;
        allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow delete: if false;

        /**
         * @description
         * Allows access to messages within a chat only to participants.
         * @path /chats/{chatId}/messages/{messageId}
         * @allow (create) if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
         * @deny (create) if request.auth.uid not in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
         * @principle Shared Access (Closed Collaborators)
         */
        match /messages/{messageId} {
            allow get, list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
            allow create: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
            allow update: if false;
            allow delete: if false;
        }
    }

    /**
     * @description
     * Allows anyone to create feedback.
     * @path /feedbacks/{feedbackId}
     */
    match /feedbacks/{feedbackId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description
     * Allows read access for companies, but restricts write access.
     * @path /companies/{companyId}
     */
    match /companies/{companyId} {
        allow get, list: if true;
        allow create: if false; // TODO: Add admin-only access
        allow update: if false; // TODO: Add admin-only access
        allow delete: if false; // TODO: Add admin-only access
    }
  }
}