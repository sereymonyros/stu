/**
 * @fileoverview Firestore Security Rules for the Cambodia Hub application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for search queries and results.
 * All data is nested under /users/{userId}, ensuring that only the authenticated user
 * can access their own search history.
 *
 * Data Structure:
 * - /users/{userId}/searchQueries/{searchQueryId}: Stores individual search queries for each user.
 * - /users/{userId}/searchQueries/{searchQueryId}/searchResults/{searchResultId}: Stores search results associated with a specific query.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own search queries and results.
 * - Listing of search queries and results is restricted to the owner.
 * - Data consistency between the path and the document's internal user ID is enforced on creation and updates.
 *
 * Denormalization for Authorization:
 * The data structure nests search results under search queries, which are themselves nested under users.
 * This eliminates the need for 'get()' calls to determine ownership, as the path itself enforces it.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for search queries, ensuring only the owner can manage them.
     * @path /users/{userId}/searchQueries/{searchQueryId}
     * @allow (create) - User '3RULB4nypUQUT9IUrD2uAK5cdFn2' can create a search query under their own user ID.
     * @allow (get, list) - User '3RULB4nypUQUT9IUrD2uAK5cdFn2' can read/list their own search queries.
     * @allow (update, delete) - User '3RULB4nypUQUT9IUrD2uAK5cdFn2' can update/delete their own existing search queries.
     * @deny (create) - User 'OtherUserID' cannot create a search query under '3RULB4nypUQUT9IUrD2uAK5cdFn2'.
     * @deny (get, list) - User 'OtherUserID' cannot read/list search queries under user '3RULB4nypUQUT9IUrD2uAK5cdFn2'.
     * @deny (update, delete) - User 'OtherUserID' cannot update/delete search queries under user '3RULB4nypUQUT9IUrD2uAK5cdFn2'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/searchQueries/{searchQueryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces access control for search results, ensuring only the owner of the parent query can manage them.
     * @path /users/{userId}/searchQueries/{searchQueryId}/searchResults/{searchResultId}
     * @allow (create) - User '3RULB4nypUQUT9IUrD2uAK5cdFn2' can create a search result under their own search query.
     * @allow (get, list) - User '3RULB4nypUQUT9IUrD2uAK5cdFn2' can read/list their own search results.
     * @allow (update, delete) - User '3RULB4nypUQUT9IUrD2uAK5cdFn2' can update/delete their own existing search results.
     * @deny (create) - User 'OtherUserID' cannot create a search result under '3RULB4nypUQUT9IUrD2uAK5cdFn2'.
     * @deny (get, list) - User 'OtherUserID' cannot read/list search results under user '3RULB4nypUQUT9IUrD2uAK5cdFn2'.
     * @deny (update, delete) - User 'OtherUserID' cannot update/delete search results under user '3RULB4nypUQUT9IUrD2uAK5cdFn2'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/searchQueries/{searchQueryId}/searchResults/{searchResultId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}