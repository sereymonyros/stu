
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USERS
    match /users/{userId} {
      // Users can read and update their own profile
      allow read, update: if isOwner(userId);
      // Anyone can create a user profile (during sign-up)
      allow create: if request.auth != null;

      // FAVORITE JOBS
      match /favoriteJobs/{jobId} {
        // Users can manage their own list of favorite jobs
        allow read, write, delete: if isOwner(userId);
      }
    }

    // LISTINGS
    match /listings/{listingId} {
      // Anyone can read listings
      allow read;
      // Only the seller can create, update, or delete their own listing
      allow create, update, delete: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
    }

    // JOBS
    match /jobs/{jobId} {
      // Anyone can read job postings
      allow read;
      // Only recruiters can create jobs
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'recruiter';
      // Only the recruiter who posted the job can update or delete it
      allow update, delete: if request.auth != null && resource.data.recruiterId == request.auth.uid;
      
      // JOB APPLICATIONS
      match /applications/{applicationId} {
        // A user can create an application for a job
        allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
        // An applicant can read their own application
        // A recruiter who posted the job can read all applications for it
        allow read: if request.auth != null && (resource.data.applicantId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid);
      }
    }
    
    // CHATS
    match /chats/{chatId} {
      // Participants of a chat can read and update it
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      // MESSAGES
      match /messages/{messageId} {
        // Chat participants can read and send messages
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
    }

    // FEEDBACK
    match /feedbacks/{feedbackId} {
        // Logged-in users can create feedback
        allow create: if request.auth != null;
        // For now, let's keep reads restricted. This could be opened up for admins later.
        allow read: if false; 
    }
  }
}
