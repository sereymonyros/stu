/**
 * @fileoverview Firestore Security Rules for the job board application.
 *
 * Core Philosophy:
 * This ruleset prioritizes user data protection and enforces strict ownership for user-related data, 
 * while allowing public read access to job listings and company profiles. Data validation is relaxed 
 * to facilitate rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information, accessible only by the user themselves.
 * - /users/{userId}/applications/{applicationId}: Stores job application references for a specific user, accessible only by that user.
 * - /users/{userId}/favouriteJobs/{jobId}: Stores favorite job references for a user, accessible only by that user.
 * - /users/{userId}/savedSearches/{searchId}: Stores saved job searches for a user, accessible only by that user.
 * - /listings/{listingId}: Stores item listings, publicly readable but only modifiable by the seller (owner).
 * - /jobs/{jobId}: Stores job postings, publicly readable but only modifiable by the recruiter (owner).
 * - /jobs/{jobId}/applications/{applicationId}: Stores applications for a specific job, readable and writable by the job poster (recruiter) and the applicant.
 * - /chats/{chatId}: Stores chat sessions between buyers and sellers, accessible to participants only.
 * - /chats/{chatId}/messages/{messageId}: Stores messages within a chat session, accessible to participants only.
 * - /feedbacks/{feedbackId}: Stores user feedback, publicly readable, and writable only by the user submitting the feedback.
 * - /companies/{companyId}: Stores company profiles, publicly readable and writable by authenticated users.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect privacy.
 * - Public read access is granted to job listings and company profiles for discoverability.
 * - Strict ownership is enforced for user profiles and related subcollections.
 * - Chat access is restricted to participants.
 * - Data validation is minimized to essential ownership and relationship checks to allow for rapid prototyping.
 *
 * Denormalization for Authorization:
 * - Listings: Each listing has a `sellerId` field that's checked against `request.auth.uid` for write access.
 * - Jobs: Each job has a `recruiterId` field that's checked against `request.auth.uid` for write access.
 * - Chats: Each chat has `buyerId` and `sellerId` fields, and a `participants` array to simplify participant validation.
 * - Job Applications: Each job application has `applicantId` and `jobId` fields.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profile data, allowing only the user to read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID 'user123' can create a profile at /users/user123 if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can read/update/delete their profile at /users/user123.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, update, delete) - Authenticated user with UID 'user456' cannot read/update/delete the profile at /users/user123.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures job application references stored under a user profile.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, get, list, update, delete) - Authenticated user with UID 'user123' can manage application references under /users/user123/applications/{applicationId}.
     * @deny (create, get, list, update, delete) - Authenticated user with UID 'user456' cannot manage application references under /users/user123/applications/{applicationId}.
     * @principle Restricts access to a user's own job application references.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures favorite job references stored under a user profile.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create, get, list, update, delete) - Authenticated user with UID 'user123' can manage favorite job references under /users/user123/favouriteJobs/{jobId}.
     * @deny (create, get, list, update, delete) - Authenticated user with UID 'user456' cannot manage favorite job references under /users/user123/favouriteJobs/{jobId}.
     * @principle Restricts access to a user's own favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures saved job searches stored under a user profile.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create, get, list, update, delete) - Authenticated user with UID 'user123' can manage saved searches under /users/user123/savedSearches/{searchId}.
     * @deny (create, get, list, update, delete) - Authenticated user with UID 'user456' cannot manage saved searches under /users/user123/savedSearches/{searchId}.
     * @principle Restricts access to a user's own saved job searches.
     */
    match /users/{userId}/savedSearches/{searchId} {
      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts creation, updates, and deletion to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) - Any user can read listings.
     * @allow (create) - Authenticated user with UID 'user123' can create a listing if request.resource.data.sellerId == 'user123'.
     * @allow (update, delete) - Authenticated user with UID 'user123' can update/delete a listing if resource.data.sellerId == 'user123'.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a listing with sellerId 'user123'.
     * @deny (update, delete) - Authenticated user with UID 'user456' cannot update/delete a listing with sellerId 'user123'.
     * @principle Allows public read access with owner-only writes.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.sellerId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Allows public read access to jobs, but restricts creation, updates, and deletion to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) - Any user can read jobs.
     * @allow (create) - Authenticated recruiter with UID 'recruiter123' can create a job if request.resource.data.recruiterId == 'recruiter123'.
     * @allow (update, delete) - Authenticated recruiter with UID 'recruiter123' can update/delete a job if resource.data.recruiterId == 'recruiter123'.
     * @deny (create) - Authenticated user with UID 'user456' cannot create a job with recruiterId 'recruiter123'.
     * @deny (update, delete) - Authenticated user with UID 'user456' cannot update/delete a job with recruiterId 'recruiter123'.
     * @principle Allows public read access with owner-only writes.
     */
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.recruiterId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Secures job applications under a specific job posting, allowing access to both the recruiter and the applicant.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) - Authenticated user can apply to a job.
     * @allow (get, list) - Authenticated recruiter (job owner) or the applicant can read the application.
     * @allow (update, delete) - Authenticated recruiter (job owner) or the applicant can update/delete the application.
     * @deny (create) - Unauthenticated user cannot apply to a job.
     * @principle Restricts access to job applications to the posting recruiter and the applicant.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data.applicantId) || get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && (isExistingOwner(resource.data.applicantId) || isExistingOwner(get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId));
      allow delete: if isSignedIn() && (isExistingOwner(resource.data.applicantId) || isExistingOwner(get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId));
    }

    /**
     * @description Secures chat sessions, allowing access only to participants.
     * @path /chats/{chatId}
     * @allow (get, list) - Authenticated user can read the chat if they are a participant.
     * @allow (create) - Authenticated user can create a chat if they are a participant.
     * @allow (update, delete) - Authenticated user can update/delete the chat if they are a participant.
     * @deny (get, list) - Authenticated user cannot read the chat if they are not a participant.
     * @principle Restricts access to chat sessions to participants only.
     */
    match /chats/{chatId} {
      allow get, list: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]));
      allow create: if isSignedIn() && (request.resource.data.participants.hasAny([request.auth.uid]));
      allow update: if isSignedIn() && (resource != null) && (resource.data.participants.hasAny([request.auth.uid]));
      allow delete: if isSignedIn() && (resource != null) && (resource.data.participants.hasAny([request.auth.uid]));
    }

    /**
     * @description Secures messages within a chat session, allowing access only to participants.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) - Authenticated user can read messages if they are a participant in the chat.
     * @allow (create) - Authenticated user can create a message if they are a participant in the chat.
     * @allow (update, delete) - No one is allowed to update or delete a message once created.
     * @deny (get, list) - Authenticated user cannot read messages if they are not a participant in the chat.
     * @deny (update, delete) - No one is allowed to update or delete a message once created.
     * @principle Restricts access to messages to participants only and prevents modification of messages.
     */
    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow update, delete: if false;
    }

    /**
     * @description Allows public read access to feedback, but restricts creation to authenticated users only.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) - Any user can read feedback.
     * @allow (create) - Authenticated user can submit feedback.
     * @deny (update, delete) - No one can update or delete feedback.
     * @principle Allows public read access with authenticated user-only writes.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description Allows public read access to company profiles, and allows any authenticated user to create a company profile
     * @path /companies/{companyId}
     * @allow (get, list) - Any user can read company profiles.
     * @allow (create) - Any authenticated user can create a company profile.
     * @allow (update, delete) - Authenticated user can update/delete a company profile.
     * @principle Allows public read access with authenticated user-only writes.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}