rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is the owner of a job.
    function isJobOwner(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
    }

    // Matches any document in the 'users' collection
    match /users/{userId} {
      // Anyone can create a user profile during signup
      allow create: if request.auth.uid == userId;
      // Users can only read, update, or delete their own profile
      allow read, update, delete: if request.auth.uid == userId;

       // Rules for subcollections of users
      match /applications/{applicationId} {
        // A user can manage their own application references
        allow read, write, delete: if request.auth.uid == userId;
      }
      match /favouriteJobs/{jobId} {
         // A user can manage their own favorite job references
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    // Rules for the 'listings' collection
    match /listings/{listingId} {
        // Anyone can view listings
        allow read: if true;
        // Only authenticated users can create listings
        allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
        // Only the seller can update or delete their own listing
        allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
    
    // Rules for the 'jobs' collection
    match /jobs/{jobId} {
      // Anyone can read job postings
      allow get, list: if true;
      // Authenticated users can create a job if they are the recruiter
      allow create: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
      // The recruiter who owns the job can update or delete it
      allow update, delete: if isJobOwner(jobId);

      // Rules for the 'applications' sub-collection
      match /applications/{applicationId} {
        // The recruiter who owns the job can read the applications
        allow read: if isJobOwner(jobId);
        // An authenticated user can create an application for themselves
        allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
        // Recruiter can update status, applicant can't
        allow update: if isJobOwner(jobId);
        // No one can delete applications for now to preserve history
        allow delete: if false;
      }
    }

    // Rules for the 'chats' collection
    match /chats/{chatId} {
      // Users can only access chats they are a part of
      allow read, write: if request.auth.uid in resource.data.participants;
      // Users can only query for their own chats
      allow list: if request.auth.uid == request.query.where.participants.array_contains;
      
      // Rules for the 'messages' sub-collection within a chat
      match /messages/{messageId} {
        // Participants of the chat can read and write messages
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
    
    // Rules for the 'feedbacks' collection
    match /feedbacks/{feedbackId} {
      // Anyone authenticated can submit feedback
      allow create: if request.auth != null;
      // For now, nobody can read, update or delete feedback to keep it private
      allow read, update, delete: if false;
    }
  }
}
