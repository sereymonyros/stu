
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for user profiles
    match /users/{userId} {
      // Make user profiles public to read, but only the owner can write.
      allow read: if true;
      allow write: if isOwner(userId);

      // Rules for user's subcollections
      match /applications/{applicationId} {
        allow read, write: if isOwner(userId);
      }
      match /favouriteJobs/{jobId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rules for job postings
    match /jobs/{jobId} {
      // Anyone can read job postings.
      allow read: if true;
      // Only authenticated users who are recruiters can create jobs.
      allow create: if isUserAuthenticated() && request.auth.token.userType == 'recruiter';
      // Only the recruiter who created the job can update or delete it.
      allow update, delete: if isUserAuthenticated() && isOwner(resource.data.recruiterId);

      // Rules for job applications subcollection
      match /applications/{applicationId} {
        // Anyone can read the list of applications.
        allow read: if true;
        // Only authenticated standard users can create an application.
        allow create: if isUserAuthenticated() && request.auth.token.userType == 'standard';
      }
    }

    // Rules for marketplace listings
    match /listings/{listingId} {
      // Anyone can read listings.
      allow read: if true;
      // Any authenticated user can create a listing.
      allow create: if isUserAuthenticated();
      // Only the seller can update or delete their own listing.
      allow update, delete: if isUserAuthenticated() && isOwner(resource.data.sellerId);
    }
    
    // Rules for feedback
    match /feedbacks/{feedbackId} {
        allow read: if true;
        allow create: if isUserAuthenticated();
    }

    // Rules for chat
    match /chats/{chatId} {
      // Users can read and write to chats they are a part of.
      allow read, write: if isUserAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // Users can read and write messages in chats they are a part of.
        allow read, write: if isUserAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
    }
  }
}
