/**
 * @fileoverview Firestore Security Rules for CambodiaHub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and
 * allows public read access to shared data. All write operations require
 * authentication and proper authorization.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, accessible only by the owning user.
 * - /users/{userId}/applications/{applicationId}: Job applications by a user, accessible only by the owning user.
 * - /users/{userId}/favouriteJobs/{jobId}: Favorite jobs of a user, accessible only by the owning user.
 * - /listings/{listingId}: Public listings, readable by anyone, but writable only by the owner.
 * - /jobs/{jobId}: Public job postings, readable by anyone, but writable only by the owner (recruiter).
 * - /jobs/{jobId}/applications/{applicationId}: Applications for specific jobs, writeable only by the applicant, readable by the job poster (recruiter).
 * - /chats/{chatId}: Chat sessions between buyers and sellers, accessible to participants.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat, accessible to participants.
 * - /feedbacks/{feedbackId}: User feedback, writeable by anyone.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and related subcollections.
 * - Listings and jobs are publicly readable but owner-writable.
 * - Chat access is restricted to chat participants.
 * - Denormalization: The `sellerId` and `recruiterId` fields are critical for
 *   authorization and must be present in the Listing and Job entities, respectively.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can create their profile with matching userId.
     * @allow (get) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can read their own profile.
     * @allow (update) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can update their own profile.
     * @deny (create) User 'attackerId' cannot create a profile with userId 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @deny (get) User 'attackerId' cannot read profile 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @deny (update) User 'attackerId' cannot update profile 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && resource.data.uid == userId;
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's job applications.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can create an application reference under their ID.
     * @allow (get) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can read an application reference under their ID.
     * @allow (list) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can list application references under their ID.
     * @deny (create) User 'attackerId' cannot create an application reference under user 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @deny (get) User 'attackerId' cannot read an application reference under user 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @deny (list) User 'attackerId' cannot list application references under user 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @principle Enforces user-ownership for job application references.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's favorite jobs.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can create a favorite job reference under their ID.
     * @allow (get) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can read a favorite job reference under their ID.
     * @allow (list) User 'bzb1hYlxOtW9ef1RczxKljot5nC2' can list favorite job references under their ID.
     * @deny (create) User 'attackerId' cannot create a favorite job reference under user 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @deny (get) User 'attackerId' cannot read a favorite job reference under user 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @deny (list) User 'attackerId' cannot list favorite job references under user 'bzb1hYlxOtW9ef1RczxKljot5nC2'.
     * @principle Enforces user-ownership for favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to listings.
     * @path /listings/{listingId}
     * @allow (get) Any user can read any listing.
     * @allow (list) Any user can list listings.
     * @allow (create) A user can create a listing if they are authenticated and the sellerId matches their uid.
     * @allow (update) A user can update a listing if they are the owner (sellerId matches their uid) and the document exists.
     * @deny (create) An unauthenticated user cannot create a listing.
     * @deny (update) A non-owner cannot update a listing.
     * @principle Allows public read access with owner-only writes, enforces authentication.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(sellerId) {
        return isSignedIn() && request.auth.uid == sellerId;
      }
      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if false;
    }

    /**
     * @description Controls access to job postings.
     * @path /jobs/{jobId}
     * @allow (get) Any user can read any job posting.
     * @allow (list) Any user can list job postings.
     * @allow (create) A recruiter can create a job posting if authenticated and recruiterId matches their uid.
     * @allow (update) A recruiter can update a job posting if they are the owner (recruiterId matches their uid) and the document exists.
     * @deny (create) An unauthenticated user cannot create a job posting.
     * @deny (update) A non-owner cannot update a job posting.
     * @principle Allows public read access with owner-only writes, enforces authentication.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(recruiterId) {
        return isSignedIn() && request.auth.uid == recruiterId;
      }
      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if false;
    }

    /**
     * @description Controls access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) An applicant can create an application if authenticated.
     * @allow (get) A recruiter (job poster) can read applications for their jobs.
     * @allow (list) Listing applications to a job is disallowed to all users.
     * @allow (update) Only the application's owner can update it.
     * @deny (create) An unauthenticated user cannot create an application.
     * @deny (get) A non-recruiter cannot read applications for a job they don't own.
     * @principle Enforces authentication and restricts access to recruiters and applicants.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isApplicant(applicantId) {
        return isSignedIn() && request.auth.uid == applicantId;
      }
       function isRecruiterForJob(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }
      allow get: if isRecruiterForJob(jobId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isApplicant(request.resource.data.applicantId);
      allow delete: if false;
    }

    /**
     * @description Controls access to chat sessions.
     * @path /chats/{chatId}
     * @allow (get) Participants can read the chat.
     * @allow (list) Listing chats is disallowed.
     * @allow (create) Any authenticated user can start a chat.
     * @allow (update) Participants can update the chat metadata.
     * @principle Restricts access to chat participants.
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isParticipant(buyerId, sellerId) {
          return isSignedIn() && (request.auth.uid == buyerId || request.auth.uid == sellerId);
      }
      allow get: if isParticipant(resource.data.buyerId, resource.data.sellerId);
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isParticipant(resource.data.buyerId, resource.data.sellerId);
      allow delete: if false;
    }

    /**
     * @description Controls access to messages within a chat session.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create) Participants can create messages.
     * @allow (get) Participants can read messages.
     * @allow (list) Participants can list messages.
     * @deny (create) Non-participants cannot create messages.
     * @deny (get) Non-participants cannot read messages.
     * @principle Restricts access to chat participants.
     */
    match /chats/{chatId}/messages/{messageId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isParticipant(chatId) {
          return isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid);
        }
        allow get: if isParticipant(chatId);
        allow list: if isParticipant(chatId);
        allow create: if isParticipant(chatId) && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Controls access to user-submitted feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Any authenticated user can submit feedback.
     * @allow (get) Any user can read feedback.
     * @allow (list) Any user can list feedback.
     * @principle Allows public read access to feedback.
     */
    match /feedbacks/{feedbackId} {
        function isSignedIn() {
          return request.auth != null;
        }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}