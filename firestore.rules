rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, ensuring only the owner can read, update, or delete their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) User with UID 'userId' can access their own profile.
     * @deny (get, update, delete) User with UID 'otherUserId' cannot access user 'userId' profile.
     * @allow (create) User with UID 'userId' can create their profile, as long as the document.id matches their auth.uid
     * @deny (create) User with UID 'otherUserId' cannot create user 'userId' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Protects job application references, ensuring only the owner can read, create, update, or delete their own application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, list, create, update, delete) User with UID 'userId' can access their own application references.
     * @deny (get, list, create, update, delete) User with UID 'otherUserId' cannot access user 'userId' application references.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Protects favourite job references, ensuring only the owner can read, create, update, or delete their own favourite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, list, create, update, delete) User with UID 'userId' can access their own favourite job references.
     * @deny (get, list, create, update, delete) User with UID 'otherUserId' cannot access user 'userId' favourite job references.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings but restricts creation, updates, and deletion to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can view listings.
     * @allow (create) User with UID 'sellerId' in request data can create a listing.
     * @allow (update, delete) User with UID 'sellerId' in existing document can update/delete the listing.
     * @deny (create, update, delete) User with UID 'otherUserId' cannot create/update/delete listing.
     * @principle Public read, owner-only writes.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }

      function isExistingOwner() {
        return isSignedIn() && request.auth.uid == resource.data.sellerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description Allows public read access to jobs but restricts creation, updates, and deletion to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can view job postings.
     * @allow (create) User with UID 'recruiterId' in request data can create a job posting.
     * @allow (update, delete) User with UID 'recruiterId' in existing document can update/delete the job posting.
     * @deny (create, update, delete) User with UID 'otherRecruiterId' cannot create/update/delete job posting.
     * @principle Public read, owner-only writes.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }

      function isExistingOwner() {
        return isSignedIn() && request.auth.uid == resource.data.recruiterId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
    }

    /**
     * @description Protects applications for a specific job, ensuring only the applicant can create the application.
     *              Updates and deletes are disallowed.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) User with UID 'applicantId' in request data can create the application.
     * @deny (create) User with UID 'otherUserId' cannot create application.
     * @deny (update, delete) No one can update or delete an application.
     * @allow (get, list) Any user can read applications for a job.
     * @principle Owner-only creation, no updates or deletes.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(applicantId) {
        return request.auth.uid == applicantId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects chat sessions, ensuring only the participants can read, create, update, or delete.
     * @path /chats/{chatId}
     * @allow (get, list, create, update, delete) Users in 'participants' array can access the chat.
     * @deny (get, list, create, update, delete) Users not in 'participants' array cannot access the chat.
     * @principle Shared access (Closed Collaborators).
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      
      function requestIsParticipant() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow get: if isParticipant();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if isParticipant();
      allow delete: if false;
    }

    /**
     * @description Protects messages within a chat session, ensuring only the participants can read, create, update, or delete.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list, create, update, delete) Users in 'participants' array in the parent chat can access messages.
     * @deny (get, list, create, update, delete) Users not in 'participants' array in the parent chat cannot access messages.
     * @principle Shared access (Closed Collaborators).
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isChatParticipant(chatId) {
          return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      allow get: if isChatParticipant(chatId);
      allow list: if false;
      allow create: if isChatParticipant(chatId);
      allow update: if isChatParticipant(chatId);
      allow delete: if isChatParticipant(chatId);
    }

    /**
     * @description Allows public write access to feedbacks but validates the userId.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Any signed-in user can create a feedback, as long as the userId matches their auth.uid.
     * @deny (create) User with UID 'otherUserId' cannot create feedback with userId 'userId'.
     * @allow (get, list) Any user can read the feedback.
     * @deny (update, delete) Updates and deletes are forbidden.
     * @principle Public write, userId validation.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}