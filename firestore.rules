/**
 * @fileoverview Firestore Security Rules for CambodiaHub.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and a public-read, owner-write model for listings and jobs.
 * Applications are restricted to authenticated users. Data validation is relaxed for prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the owning user.
 * - /listings/{listingId}: Stores listing data, publicly readable, writable only by the seller.
 * - /jobs/{jobId}: Stores job data, publicly readable, writable only by the recruiter.
 * - /chats/{chatId}: Stores chat data, restricted to the participants.
 * - /feedbacks/{feedbackId}: Stores user feedback, only create requests are allowed.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Public read access is granted to listings and jobs to maximize visibility.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 * - Listings and Jobs require 'sellerId' and 'recruiterId' fields, respectively, for ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create, update, delete) if the user is the owner of the profile.
     * @allow (get) if the user is the owner of the profile.
     * @deny (list) User listing is disallowed.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow get: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Rules for user applications (references).
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, update, delete) if the user is the owner.
     * @allow (get, list) if the user is the owner.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Rules for listings.
     * @path /listings/{listingId}
     * @allow (get, list) to anyone.
     * @allow (create, update, delete) only to the seller.
     * @principle Public read with owner-only writes.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }

      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }
      
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Rules for jobs.
     * @path /jobs/{jobId}
     * @allow (get, list) to anyone.
     * @allow (create, update, delete) only to the recruiter.
     * @principle Public read with owner-only writes.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth != null && request.auth.uid == recruiterId;
      }

      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }
      
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Rules for job applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) to authenticated users if the applicantId matches the user's UID and the jobId matches the parent job.
     * @allow (get, list, update, delete) to no one.
     * @principle Restricts creation to authenticated users applying for a specific job.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid && request.resource.data.jobId == jobId;
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for chats.
     * @path /chats/{chatId}
     * @allow (get, list, create, update, delete) if the user is a participant in the chat.
     * @principle Shared Access (Closed Collaborators).
     */
    match /chats/{chatId} {
        function isParticipant() {
          return request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId;
        }

        allow get: if isParticipant();
        allow list: if false; // Listing chats is likely a private operation.
        allow create: if request.auth.uid == request.resource.data.buyerId || request.auth.uid == request.resource.data.sellerId;
        allow update: if isParticipant();
        allow delete: if false; // Deleting chats is probably not allowed.
    }

    /**
     * @description Rules for messages within a chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create) if the user is a participant in the chat.
     * @allow (get, list) if the user is a participant in the chat.
     * @allow (update, delete) never.
     * @principle Shared Access (Closed Collaborators) - requires `get()` to validate parent chat.
     */
    match /chats/{chatId}/messages/{messageId} {
        function isParticipant() {
            return get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid
                   || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
        }
        allow create: if isParticipant();
        allow get: if isParticipant();
        allow list: if isParticipant();
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Rules for user feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create) to any authenticated user.
     * @deny (get, list, update, delete) to everyone.
     * @principle Open creates, no reads or other modifications.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}