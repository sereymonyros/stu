/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * and allows public read access to some collections while restricting writes
 * to authorized users.
 *
 * Data Structure:
 * - User profiles are stored under /users/{userId}.
 * - User application references are stored under /users/{userId}/applications/{applicationId}.
 * - Listings are stored under /listings/{listingId}.
 * - Jobs are stored under /jobs/{jobId}.
 * - Applications for jobs are stored under /jobs/{jobId}/applications/{applicationId}.
 * - Chats are stored under /chats/{chatId}.
 * - Messages within chats are stored under /chats/{chatId}/messages/{messageId}.
 * - Feedbacks are stored under /feedbacks/{feedbackId}.
 *
 * Key Security Decisions:
 * - User profiles and their application references are only accessible to the owning user.
 * - Listings can be read by anyone, but only the owner can modify them.
 * - Jobs can be read by anyone, but only the recruiter can create/modify applications.
 * - Chats are accessible to the buyer and seller.
 * - Feedbacks can be created by anyone.
 *
 * Denormalization for Authorization:
 * - Listings have a `sellerId` field to easily check ownership.
 * - Jobs have a `recruiterId` field to easily check ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profiles.
     * @path /users/{userId}
     * @allow (read, write) User with matching UID.
     * @deny (read, write) User with non-matching UID.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Grants access to user's job applications references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (read, write) User with matching UID.
     * @deny (read, write) User with non-matching UID.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Grants access to listings.
     * @path /listings/{listingId}
     * @allow (read) Public access.
     * @allow (write) Owner-only access.
     * @deny (write) Non-owner access.
     * @principle Allows public read access with owner-only writes.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.sellerId == request.auth.uid && resource != null;
      allow delete: if request.auth != null && request.resource.data.sellerId == request.auth.uid && resource != null;
    }

    /**
     * @description Grants access to job postings.
     * @path /jobs/{jobId}
     * @allow (read) Public access.
     * @allow (write) Recruiter-only access.
     * @deny (write) Non-recruiter access.
     * @principle Allows public read access with recruiter-only writes.
     */
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.recruiterId == request.auth.uid && resource != null;
      allow delete: if request.auth != null && request.resource.data.recruiterId == request.auth.uid && resource != null;
    }

    /**
     * @description Grants access to job applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (read) Recruiter of job can read applicaitons.
     * @allow (create) Any signed in user can create an application.
     * @allow (update,delete) Only the recruiter that created the job can update or delete the application.
     * @deny (read, write) Non-recruiter access.
     */
    match /jobs/{jobId}/applications/{applicationId} {
         function isRecruiter(jobId) {
           return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
         }

         function isSignedIn() {
             return request.auth != null;
         }

        allow get, list: if isSignedIn() && isRecruiter(jobId);
        allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
        allow update: if isSignedIn() && isRecruiter(jobId);
        allow delete: if isSignedIn() && isRecruiter(jobId);
    }

    /**
     * @description Grants access to chats.
     * @path /chats/{chatId}
     * @allow (read, write) Buyer and seller access.
     * @deny (read, write) Non-participant access.
     * @principle Enforces shared access for chat participants.
     */
    match /chats/{chatId} {
      allow get: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
      allow update: if request.auth != null && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid) && resource != null;
      allow delete: if false;
    }

    /**
     * @description Grants access to messages within a chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (read, write) Chat participants access.
     * @deny (read, write) Non-participant access.
     * @principle Enforces shared access for chat participants.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant(chatId) {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid
              || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
      }
      allow get, list: if request.auth != null && isChatParticipant(chatId);
      allow create: if request.auth != null && isChatParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants access to feedbacks.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Any signed in user can create feedback.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}