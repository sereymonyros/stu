rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, and delete their profile if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a profile for userId 'user123' because request.auth.uid != 'user123'.
     * @deny (get, update, delete) - User with UID 'user456' cannot read, update, or delete the profile for userId 'user123' because request.auth.uid != 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, get, list, update, delete) - User with UID 'user123' can manage their application references under /users/user123/.
     * @deny (create, get, list, update, delete) - User with UID 'user456' cannot manage application references under /users/user123/.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to a user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create, get, list, update, delete) - User with UID 'user123' can manage their favorite jobs under /users/user123/.
     * @deny (create, get, list, update, delete) - User with UID 'user456' cannot manage favorite jobs under /users/user123/.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to a user's saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create, get, list, update, delete) - User with UID 'user123' can manage their saved searches under /users/user123/.
     * @deny (create, get, list, update, delete) - User with UID 'user456' cannot manage saved searches under /users/user123/.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/savedSearches/{searchId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to listings.
     * @path /listings/{listingId}
     * @allow (get, list) - Any user can read any listing.
     * @allow (create) - User with UID 'user123' can create a listing with sellerId 'user123'.
     * @allow (update, delete) - User with UID 'user123' can update or delete listing with sellerId 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a listing with sellerId 'user123' because request.auth.uid != request.resource.data.sellerId.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete a listing with sellerId 'user123' because request.auth.uid != resource.data.sellerId.
     * @principle Public read, owner-only writes, validates sellerId on create.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description Controls access to job postings.
     * @path /jobs/{jobId}
     * @allow (get, list) - Any user can read any job posting.
     * @allow (create) - User with UID 'recruiter789' can create a job with recruiterId 'recruiter789'.
     * @allow (update, delete) - User with UID 'recruiter789' can update or delete job with recruiterId 'recruiter789'.
     * @deny (create) - User with UID 'user456' cannot create a job with recruiterId 'recruiter789' because request.auth.uid != request.resource.data.recruiterId.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete a job with recruiterId 'recruiter789' because request.auth.uid != resource.data.recruiterId.
     * @principle Public read, owner-only writes, validates recruiterId on create.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
    }

    /**
     * @description Controls access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) - User with UID 'user123' can create an application with applicantId 'user123'.
     * @allow (get, list) - Any authenticated user can read job application to support recruiter workflow.
     * @allow (update, delete) - User with UID 'user123' can update or delete their application with applicantId 'user123'.
     * @deny (create) - User with UID 'user456' cannot create an application with applicantId 'user123' because request.auth.uid != request.resource.data.applicantId.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete application of 'user123' because request.auth.uid != resource.data.applicantId.
     * @principle Applicant-only writes, validates applicantId on create.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
    }

    /**
     * @description Controls access to chat sessions.
     * @path /chats/{chatId}
     * @allow (get, list) - Only participants (buyer or seller) can read chat sessions.
     * @allow (create) - Only participants (buyer or seller) can create chat sessions if the participants array includes request.auth.uid.
     * @allow (update, delete) - Only participants can update chat sessions.
     * @deny (create, get, list, update, delete) - Non-participants cannot access chat sessions.
     * @principle Shared access, validates participants array.
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && 'participants' in resource.data && resource.data.participants.hasAny([request.auth.uid]);
      allow list: if isSignedIn() && 'participants' in resource.data && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && 'participants' in request.resource.data && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && 'participants' in resource.data && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if false; // No deletes for now
    }

    /**
     * @description Controls access to messages within a chat session.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create, get, list) - Only participants of the chat can create, read and list messages.
     * @allow (update, delete) - No one can update or delete messages.
     * @deny (create, get, list) - Non-participants cannot access messages.
     * @principle Shared access, inherits authorization from parent chat document.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user-submitted feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create) - Any authenticated user can submit feedback.
     * @allow (get, list) - Any user can read feedback.
     * @deny (update, delete) - No one can update or delete feedback.
     * @principle Open create for authenticated users.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to company profiles.
     * @path /companies/{companyId}
     * @allow (get, list) - Any user can read company profiles.
     * @allow (create, update, delete) - Any authenticated user can create, update, and delete company profiles.
     * @principle Public read, authenticated write.
     */
    match /companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}