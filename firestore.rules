/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership and shared-access models.
 * Users own their profiles and related data (applications, favorites).
 * Chat access is granted to participants.
 * Listings, Jobs and Feedbacks are publicly readable with owner-only writes.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /users/{userId}/applications/{applicationId}: Job application references for a user.
 * - /users/{userId}/favouriteJobs/{jobId}: Favorite job references for a user.
 * - /listings/{listingId}: Publicly readable listings.
 * - /jobs/{jobId}: Publicly readable job postings.
 * - /jobs/{jobId}/applications/{applicationId}: Applications for a specific job, created by job seeker.
 * - /chats/{chatId}: Chat sessions between users.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat session.
 * - /feedbacks/{feedbackId}: Publicly readable user-submitted feedback.
 *
 * Key Security Decisions:
 * - Users can only manage their own profile and associated data.
 * - Listing, Job, and Feedback data is publicly readable, but only the creator can modify or delete it.
 * - Chat access is restricted to the participants (buyer and seller).
 * - Listing of chats is open to any signed-in user, as the chat documents do not contain any sensitive information beyond the participants, buyerId, and sellerId.
 *
 * Denormalization for Authorization:
 * - Chats: The `Chat` document includes a `participants` array containing both user IDs. This denormalization enables efficient security rules for message access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read, create, update, and delete their own user profile.
     * @path /users/{userId}
     * @allow (create, update, delete) User with matching {userId} can perform the operation.
     * @allow (get, list) Any signed-in user can read user profiles.
     * @deny (create, update, delete) User without matching {userId} cannot perform the operation.
     * @principle Enforces document ownership for profile management.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows users to manage their own job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, update, delete) User with matching {userId} can perform the operation.
     * @allow (get, list) User with matching {userId} can perform get and list operations.
     * @deny (create, update, delete) User without matching {userId} cannot perform the operation.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows users to manage their own favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create, update, delete) User with matching {userId} can perform the operation.
     * @allow (get, list) User with matching {userId} can perform get and list operations.
     * @deny (create, update, delete) User without matching {userId} cannot perform the operation.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows anyone to read listings, but only the seller can modify or delete them.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read listings.
     * @allow (create) User can create a listing with sellerId matching their UID.
     * @allow (update, delete) User with matching sellerId can update and delete the listing.
     * @deny (create, update, delete) Non-sellers cannot create, update or delete listings.
     * @principle Public read with owner-only writes.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }
      allow get, list: if true;
      allow create: if request.resource.data.sellerId == request.auth.uid;
      allow update: if isOwner(resource.data.sellerId) && resource != null;
      allow delete: if isOwner(resource.data.sellerId) && resource != null;
    }

    /**
     * @description Allows anyone to read job postings, but only the recruiter can modify or delete them.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read job postings.
     * @allow (create) User can create a job with recruiterId matching their UID.
     * @allow (update, delete) User with matching recruiterId can update and delete the job.
     * @deny (create, update, delete) Non-recruiters cannot create, update or delete jobs.
     * @principle Public read with owner-only writes.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }
      allow get, list: if true;
      allow create: if request.resource.data.recruiterId == request.auth.uid;
      allow update: if isOwner(resource.data.recruiterId) && resource != null;
      allow delete: if isOwner(resource.data.recruiterId) && resource != null;
    }

    /**
     * @description Allows users to create applications for specific jobs.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) User can create an application with applicantId matching their UID.
     * @allow (get, list) Any signed-in user can read applications
     * @allow (update, delete) User with matching applicantId can update and delete the application.
     * @deny (create, update, delete) Non-applicants cannot create, update or delete applications.
     * @principle Owner only writes
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isOwner(applicantId) {
        return request.auth.uid == applicantId;
      }
      allow get, list: if true;
      allow create: if request.resource.data.applicantId == request.auth.uid;
      allow update: if isOwner(resource.data.applicantId) && resource != null;
      allow delete: if isOwner(resource.data.applicantId) && resource != null;
    }

    /**
     * @description Allows users to read and create chats. Access is granted to participants of the chat.
     * @path /chats/{chatId}
     * @allow (get) User must be a participant in the chat.
     * @allow (list) Any signed-in user can list chats.
     * @allow (create) User must be the buyer or seller.
     * @allow (update, delete) No one can update or delete chats.
     * @principle Shared access between buyer and seller.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      allow get: if isParticipant();
      allow list: if isSignedIn();
      allow create: if request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows participants of a chat to read and create messages.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) User must be a participant in the chat.
     * @allow (create) User must be a participant in the chat.
     * @allow (update, delete) No one can update or delete messages.
     * @principle Shared access between participants, enforced via parent chat document.
     */
    match /chats/{chatId}/messages/{messageId} {
        function isParticipant() {
            return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        }
        allow get, list: if isParticipant();
        allow create: if isParticipant();
        allow update: if false;
        allow delete: if false;
    }
      

    /**
     * @description Allows anyone to read feedback, but only the submitter can modify or delete it.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read feedback.
     * @allow (create) User can create feedback with userId matching their UID.
     * @allow (update, delete) User with matching userId can update and delete the feedback.
     * @deny (create, update, delete) Non-submitters cannot create, update or delete feedback.
     * @principle Public read with owner-only writes.
     */
    match /feedbacks/{feedbackId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if true;
      allow create: if request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && resource != null;
      allow delete: if isOwner(resource.data.userId) && resource != null;
    }

    // Helper function to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
  }
}