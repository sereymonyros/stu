/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and their associated data,
 *              while also providing public read access to listings and jobs. Write access to listings and jobs
 *              is restricted to authenticated users, who must also be the owners of the respective resources.
 *              Chat access is limited to participants, while feedback is publicly accessible.
 *
 * @dataStructure
 *  - /users/{userId}: Stores public user profile data, owned by the user.
 *  - /users/{userId}/applications/{applicationId}: Stores lightweight references to job applications made by the user.
 *  - /listings/{listingId}: Stores listing data, publicly readable, owned by the seller.
 *  - /jobs/{jobId}: Stores job posting data, publicly readable, owned by the recruiter.
 *  - /jobs/{jobId}/applications/{applicationId}: Stores applications for specific job, owned by the applicant.
 *  - /chats/{chatId}: Stores chat session data, accessible only to the participants.
 *  - /chats/{chatId}/messages/{messageId}: Stores messages within a chat, accessible only to chat participants.
 *  - /feedbacks/{feedbackId}: Stores user feedback, publicly readable, writeable by authenticated users.
 *
 * @keySecurityDecisions
 *  - User listing is disallowed.
 *  - Users can only read/write their own profile data and application references.
 *  - Listings and Jobs are publicly readable but only their owners can modify them.
 *  - Chats and Messages are only accessible to participants.
 *  - Feedback is public, but is only writeable by authenticated users.
 *  - All write operations require a valid authentication state.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the resource's owner ID.
     */
    function isResourceOwner(resourceOwnerId) {
      return request.auth.uid == resourceOwnerId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the resource's owner ID and the document exists.
     */
    function isExistingOwner(resourceOwnerId) {
      return isResourceOwner(resourceOwnerId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is one of the participants in the chat.
     */
    function isChatParticipant(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
    }

    /**
     * @description
     *  - This rule governs access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can get, update, or delete their profile if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a profile for user 'user123'.
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete the profile of user 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description
     *  - This rule governs access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) - User with UID 'user123' can create an application reference under their profile.
     * @allow (get, list, update, delete) - User with UID 'user123' can access their own application references.
     * @deny (create) - User with UID 'user456' cannot create application references under user 'user123's profile.
     * @deny (get, list, update, delete) - User with UID 'user456' cannot access user 'user123's application references.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description
     *  - This rule governs access to listing documents.
     * @path /listings/{listingId}
     * @allow (get, list) - Any user can read listings.
     * @allow (create) - User with UID 'user123' can create a listing with sellerId: 'user123'.
     * @allow (update, delete) - Only the owner (seller) can update or delete.
     * @deny (create) - User with UID 'user456' cannot create a listing with sellerId: 'user123'.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete listing owned by user 'user123'.
     * @principle Public read, owner-only writes, validates relational integrity on create.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description
     *  - This rule governs access to job documents.
     * @path /jobs/{jobId}
     * @allow (get, list) - Any user can read jobs.
     * @allow (create) - User with UID 'recruiter789' can create a job with recruiterId: 'recruiter789'.
     * @allow (update, delete) - Only the owner (recruiter) can update or delete.
     * @deny (create) - User with UID 'hacker123' cannot create a job with recruiterId: 'recruiter789'.
     * @deny (update, delete) - User with UID 'hacker123' cannot update or delete job owned by user 'recruiter789'.
     * @principle Public read, owner-only writes, validates relational integrity on create.
     */
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description
     *  - This rule governs access to application documents for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get) - Anyone can get the Job Application.
     * @allow (list) - Anyone can list Job Applications.
     * @allow (create) - Only the applicant can create an application.
     * @allow (update, delete) - Only the applicant can update/delete their application.
     * @deny (create) - User cannot create an application if they are not signed in.
     * @deny (update, delete) - User cannot update/delete an application if they are not the applicant.
     * @principle Enforces document ownership for writes.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.applicantId);
      allow delete: if isExistingOwner(resource.data.applicantId);
    }

    /**
     * @description
     *  - This rule governs access to chat documents.
     * @path /chats/{chatId}
     * @allow (get, update) - Only participants can get or update the chat.
     * @allow (list) - Listing is disabled for security reasons.
     * @allow (create) - Creation is allowed to signed in users.
     * @allow (delete) - Only participants can delete the chat.
     * @deny (get, update, delete) - Non-participants are denied from accessing the chat.
     * @principle Restricts access to participants only.
     */
    match /chats/{chatId} {
      allow get, update: if isSignedIn() && isChatParticipant(chatId);
      allow list: if false;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && isChatParticipant(chatId);
    }

    /**
     * @description
     *  - This rule governs access to message documents within a specific chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, create) - Only participants can get or create messages.
     * @allow (list) - Listing is allowed for signed-in users who are participants.
     * @allow (update, delete) - Only participants can update or delete messages.
     * @deny (get, create, update, delete) - Non-participants are denied from accessing messages.
     * @principle Restricts access to participants only.
     */
    match /chats/{chatId}/messages/{messageId} {
      allow get, create: if isSignedIn() && isChatParticipant(chatId);
      allow list: if isSignedIn() && isChatParticipant(chatId);
      allow update, delete: if isSignedIn() && isChatParticipant(chatId);
    }

    /**
     * @description
     *  - This rule governs access to feedback documents.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) - Any user can read feedback.
     * @allow (create) - Only signed in users can create feedback.
     * @allow (update, delete) - No updates or deletes allowed.
     * @deny (create) - Anonymous users cannot create feedback.
     * @principle Public read, signed-in user writes only.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}