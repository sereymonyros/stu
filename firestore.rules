/**
 * @fileoverview Firestore Security Rules
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data
 * while allowing public read access to listings and job postings. User data is isolated
 * under the `/users/{userId}` path, and only the authenticated user can read or write
 * their own data. Listings and jobs are publicly readable, but only the creator (seller or recruiter)
 * can modify them. Chat access is restricted to the participants of the chat.
 *
 * Data Structure:
 * - `/users/{userId}`: User profile data.
 * - `/users/{userId}/applications/{applicationId}`: Job application references for a user.
 * - `/users/{userId}/favouriteJobs/{jobId}`: Favorite job references for a user.
 * - `/listings/{listingId}`: Marketplace listings.
 * - `/jobs/{jobId}`: Job postings.
 * - `/jobs/{jobId}/applications/{applicationId}`: Applications for a specific job.
 * - `/chats/{chatId}`: Chat sessions between users.
 * - `/chats/{chatId}/messages/{messageId}`: Messages within a chat session.
 * - `/feedbacks/{feedbackId}`: User feedback.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted for listings and job postings.
 * - Only authenticated users can manage their profile data.
 * - Chats and Messages are accessible to the participants only.
 * - Data validation is minimal, focusing on authorization and relational integrity.
 *
 * Denormalization for Authorization:
 * - Listings and Jobs require `sellerId` and `recruiterId` fields respectively to enforce
 *   ownership for updates and deletes.
 * - Chats require a `participants` array for easy authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents. Only the authenticated user
     *              can read or write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can read/write their own profile at /users/5hEdue2w4Bb3zg7hJyDlk92A7d92.
     * @deny (get, update, delete) User 'anotherUser' cannot access profile at /users/5hEdue2w4Bb3zg7hJyDlk92A7d92.
     * @allow (create) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can create their own profile if the userId matches their auth.uid.
     * @deny (create) User 'anotherUser' cannot create profile for user '5hEdue2w4Bb3zg7hJyDlk92A7d92'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to a user's job application references. Only the
     *              authenticated user can read or write their own application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, list, create, update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can read/write their own applications at /users/5hEdue2w4Bb3zg7hJyDlk92A7d92/applications/{applicationId}.
     * @deny (get, list, create, update, delete) User 'anotherUser' cannot access application at /users/5hEdue2w4Bb3zg7hJyDlk92A7d92/applications/{applicationId}.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to a user's favorite jobs. Only the authenticated user
     *              can read or write their own favorite jobs.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, list, create, update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can read/write their own favorite jobs at /users/5hEdue2w4Bb3zg7hJyDlk92A7d92/favouriteJobs/{jobId}.
     * @deny (get, list, create, update, delete) User 'anotherUser' cannot access favorite job at /users/5hEdue2w4Bb3zg7hJyDlk92A7d92/favouriteJobs/{jobId}.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to listings. Listings are publicly readable, but only the
     *              seller can modify them.
     * @path /listings/{listingId}
     * @allow (get, list) Anyone can read listings.
     * @allow (create) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can create a listing with themselves as seller at /listings/{listingId} if request.resource.data.sellerId matches.
     * @deny (create) User 'anotherUser' cannot create a listing for user '5hEdue2w4Bb3zg7hJyDlk92A7d92'.
     * @allow (update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can update/delete their own listing at /listings/{listingId}.
     * @deny (update, delete) User 'anotherUser' cannot update listing for user '5hEdue2w4Bb3zg7hJyDlk92A7d92'.
     * @principle Allows public read access with owner-only writes for listings.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && getAfter().data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && getAfter().data.sellerId == request.auth.uid;
    }

    /**
     * @description Controls access to job postings. Job postings are publicly readable, but only the
     *              recruiter can modify them.
     * @path /jobs/{jobId}
     * @allow (get, list) Anyone can read jobs.
     * @allow (create) User 'recruiterId' can create a job listing with themselves as recruiter at /jobs/{jobId} if request.resource.data.recruiterId matches.
     * @deny (create) User 'anotherUser' cannot create a job listing for recruiter 'recruiterId'.
     * @allow (update, delete) Recruiter 'recruiterId' can update/delete their own listing at /jobs/{jobId}.
     * @deny (update, delete) User 'anotherUser' cannot update job listing for recruiter 'recruiterId'.
     * @principle Allows public read access with owner-only writes for job postings.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && getAfter().data.recruiterId == request.auth.uid;
      allow delete: if isSignedIn() && getAfter().data.recruiterId == request.auth.uid;
    }

    /**
     * @description Controls access to applications for a specific job. Only the applicant
     *              or the job poster can read or write application data.  In this simplified model,
     *              we are securing only from the perspective of the applicant.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get, list, create, update, delete) User 'applicantId' can read/write their own applications at /jobs/{jobId}/applications/{applicationId}.
     * @deny (get, list, create, update, delete) User 'anotherUser' cannot access application for user 'applicantId'.
     * @principle Enforces document ownership for job applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && (resource.data.applicantId == request.auth.uid);
      allow list: if false; // Listing applications is not permitted from the client.
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && getAfter().data.applicantId == request.auth.uid;
      allow delete: if isSignedIn() && getAfter().data.applicantId == request.auth.uid;
    }

    /**
     * @description Controls access to chat sessions. Only participants can read and write
     *              to a chat session.
     * @path /chats/{chatId}
     * @allow (get, list, create, update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can read/write chat at /chats/{chatId} if they are a participant.
     * @deny (get, list, create, update, delete) User 'anotherUser' cannot access chat at /chats/{chatId}.
     * @principle Restricts access to chat sessions to participants only.
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }

      allow get: if isSignedIn() && isParticipant();
      allow list: if false; // Listing chats is not permitted.
      allow create: if isSignedIn() && request.resource.data.participants is List && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if isSignedIn() && isParticipant();
      allow delete: if false; // Deleting chats is disabled.
    }

    /**
     * @description Controls access to messages within a chat session. Only participants
     *              can read and write messages.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list, create, update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can read/write messages at /chats/{chatId}/messages/{messageId} if they are a participant.
     * @deny (get, list, create, update, delete) User 'anotherUser' cannot access messages at /chats/{chatId}/messages/{messageId}.
     * @principle Restricts access to messages to chat participants only.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getChat(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId));
      }

      function isParticipant(chatId) {
        return isSignedIn() && getChat(chatId).data.participants.hasAny([request.auth.uid]);
      }

      allow get: if isParticipant(request.params.chatId);
      allow list: if false;
      allow create: if isParticipant(request.params.chatId);
      allow update: if false; // Updating messages is disabled.
      allow delete: if false; // Deleting messages is disabled.
    }

    /**
     * @description Controls access to user feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Anyone can read feedback.
     * @allow (create) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can create feedback with themselves as the author at /feedbacks/{feedbackId} if request.resource.data.userId matches.
     * @deny (create) User 'anotherUser' cannot create feedback for user '5hEdue2w4Bb3zg7hJyDlk92A7d92'.
     * @allow (update, delete) User '5hEdue2w4Bb3zg7hJyDlk92A7d92' can update/delete their own feedback at /feedbacks/{feedbackId}.
     * @deny (update, delete) User 'anotherUser' cannot update feedback for user '5hEdue2w4Bb3zg7hJyDlk92A7d92'.
     * @principle Allows public read access with owner-only writes for feedback.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && getAfter().data.userId == request.auth.uid;
      allow delete: if isSignedIn() && getAfter().data.userId == request.auth.uid;
    }
  }
}