/**
 * @fileoverview Firestore Security Rules for the job application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-related data
 * and a recruiter-ownership model for job postings and applications. Public
 * read access is granted to listings and jobs.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owner.
 * - /users/{userId}/applications/{applicationId}: User's job application references, accessible only to the owner.
 * - /users/{userId}/favouriteJobs/{jobId}: User's favorite job references, accessible only to the owner.
 * - /listings/{listingId}: Public listings, writeable only by the owner (seller).
 * - /jobs/{jobId}: Public job postings, writeable only by the owner (recruiter).
 * - /jobs/{jobId}/applications/{applicationId}: Job applications, writeable only by the applicant and updatable by the job owner (recruiter).
 * - /chats/{chatId}: Chat sessions between buyers and sellers, accessible to participants.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat, accessible to participants.
 * - /feedbacks/{feedbackId}: Public feedback, writeable by authenticated users.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and related subcollections.
 * - Recruiters (job posters) control the job postings and applications they create.
 * - Public read access is granted for listings and job postings.
 * - Listing is not listable by the client.
 *
 * Denormalization for Authorization:
 * - Jobs: Each job document has a `recruiterId` field to identify the owner.
 * - Applications: Each application document has an `applicantId` and `jobId` field.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (read, write) if the request is made by the user with matching userId
     * @deny (read, write) if the request is made by a different user
     * @principle Enforces user-ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Protects user application references, allowing only the owner to read and write.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (read, write) if the request is made by the user with matching userId
     * @deny (read, write) if the request is made by a different user
     * @principle Enforces user-ownership for user application references.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Protects user favorite job references, allowing only the owner to read and write.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (read, write) if the request is made by the user with matching userId
     * @deny (read, write) if the request is made by a different user
     * @principle Enforces user-ownership for user favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts writes to the owner (seller).
     * @path /listings/{listingId}
     * @allow (read) any authenticated user
     * @allow (write) the user who owns the listing
     * @deny (write) any other user
     * @principle Allows public read access while enforcing ownership for writes.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.sellerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    /**
     * @description Allows public read access to jobs, but restricts writes to the owner (recruiter).
     * @path /jobs/{jobId}
     * @allow (read) any authenticated user
     * @allow (write) the user who owns the job
     * @deny (write) any other user
     * @principle Allows public read access while enforcing ownership for writes.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.recruiterId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.recruiterId;
    }

    /**
     * @description Protects job applications, allowing the applicant to create and recruiters to update/delete.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) the user who is applying for the job
     * @allow (update, delete) the recruiter who owns the job
     * @deny (create, update, delete) any other user
     * @principle Enforces ownership for job applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isSignedIn() {
          return request.auth != null;
        }

        //Checks if user is the job poster.
        function isJobOwner(jobId) {
            return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
        }
        
        //Checks if user is the job applicant.
        function isApplicant(applicantId) {
            return isSignedIn() && request.auth.uid == applicantId;
        }
        
        function isExistingJobOwner(jobId) {
            return isJobOwner(jobId) && resource != null;
        }

        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isJobOwner(jobId);
        allow delete: if isSignedIn() && isJobOwner(jobId);
    }

    /**
     * @description Protects chat sessions, allowing only participants to read and write.
     * @path /chats/{chatId}
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isParticipant() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }
      function isExistingParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      allow get: if isExistingParticipant();
      allow list: if false; // Not listable by the client.  Chats should be accessed via user subcollections or similar.
      allow create: if isSignedIn() && isParticipant();
      allow update: if isExistingParticipant();
      allow delete: if false; // Chats should not be deletable by the client.
    }

    /**
     * @description Protects messages within a chat session, allowing only participants to read and write.
     * @path /chats/{chatId}/messages/{messageId}
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isChatParticipant(chatId) {
        return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      allow get: if isSignedIn() && isChatParticipant(chatId);
      allow list: if false;
      allow create: if isSignedIn() && isChatParticipant(chatId);
      allow update: if false; // Messages should not be updatable.
      allow delete: if false; // Messages should not be deletable.
    }

    /**
     * @description Allows any authenticated user to submit feedback.
     * @path /feedbacks/{feedbackId}
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true; //Everyone can read the feedback
      allow list: if true; //Everyone can list the feedback
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}