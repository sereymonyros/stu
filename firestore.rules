/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * while allowing public read access to certain collections like 'listings' and 'jobs'.
 * Data validation is relaxed to allow for rapid prototyping, focusing on authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile data, accessible only to the user.
 * - /users/{userId}/favoriteJobs/{jobId}: Stores lightweight job references favorited by a user, accessible only to the user.
 * - /listings/{listingId}: Stores item listings, publicly readable, but create/update/delete are restricted to the seller.
 * - /jobs/{jobId}: Stores job postings, publicly readable, but create/update/delete are restricted to the recruiter.
 * - /chats/{chatId}: Stores chat sessions, access is restricted to participants (buyer and seller).
 * - /chats/{chatId}/messages/{messageId}: Stores messages within a chat session, access is restricted to participants.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and favorite jobs.
 * - Public read access is granted for listings and job postings to allow for browsing.
 * - Writes to listings and jobs are restricted to the owner (seller/recruiter).
 * - Chats and messages are only accessible to the participants.
 * - Data shape validation is minimal, focusing on authorization fields for prototyping.
 *
 * Denormalization for Authorization:
 * - Listings and Jobs include `sellerId` and `recruiterId` respectively to simplify ownership checks without requiring additional `get()` calls.
 * - Chats include `buyerId` and `sellerId` to authorize access to chat sessions and messages.
 *
 * Structural Segregation:
 * - User-specific data (profile, favoriteJobs) is stored under the /users/{userId} path, ensuring private access.
 * - Public data (listings, jobs) is stored in top-level collections, allowing public read access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile document.
     * @allow (get, list, update, delete) - User with UID 'user123' can read/write their own profile document.
     * @deny (create) - User with UID 'user456' cannot create a profile document for 'user123'.
     * @deny (get, list, update, delete) - User with UID 'user456' cannot read/write the profile document of 'user123'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid; // Enforce immutability of user ID
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to a user's favorite jobs.
     * @path /databases/{database}/documents/users/{userId}/favoriteJobs/{jobId}
     * @allow (create) - User with UID 'user123' can add a job 'job456' to their favorites.
     * @allow (get, list, update, delete) - User with UID 'user123' can read/write their own favorite jobs.
     * @deny (create) - User with UID 'user456' cannot add a job to the favorites of 'user123'.
     * @deny (get, list, update, delete) - User with UID 'user456' cannot read/write the favorite jobs of 'user123'.
     * @principle Enforces document ownership for a user's favorite jobs.
     */
    match /users/{userId}/favoriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to listing documents.
     * @path /databases/{database}/documents/listings/{listingId}
     * @allow (get, list) - Any user can read any listing.
     * @allow (create) - User with UID 'user123' can create a listing with sellerId 'user123'.
     * @allow (update, delete) - User with UID 'user123' can update/delete their own listing (where sellerId is 'user123').
     * @deny (create) - User with UID 'user456' cannot create a listing with sellerId 'user123'.
     * @deny (update, delete) - User with UID 'user456' cannot update/delete the listing of 'user123'.
     * @principle Allows public read access to listings, enforces ownership for writes.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }

      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.sellerId);
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Controls access to job documents.
     * @path /databases/{database}/documents/jobs/{jobId}
     * @allow (get, list) - Any user can read any job posting.
     * @allow (create) - User with UID 'recruiter123' can create a job with recruiterId 'recruiter123'.
     * @allow (update, delete) - User with UID 'recruiter123' can update/delete their own job posting (where recruiterId is 'recruiter123').
     * @deny (create) - User with UID 'recruiter456' cannot create a job posting with recruiterId 'recruiter123'.
     * @deny (update, delete) - User with UID 'recruiter456' cannot update/delete the job posting of 'recruiter123'.
     * @principle Allows public read access to jobs, enforces ownership for writes.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth != null && request.auth.uid == recruiterId;
      }
      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.recruiterId);
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Controls access to chat documents.
     * @path /databases/{database}/documents/chats/{chatId}
     * @allow (get, list) - Only participants (buyer or seller) can read a chat.
     * @allow (create) - Creating a chat is allowed if the user is the buyer or seller.
     * @allow (update) - Updating a chat is allowed if the user is the buyer or seller.
     * @allow (delete) - Deleting a chat is only allowed by participants.
     * @deny (get, list) - A user who is not a participant cannot read a chat.
     * @principle Enforces shared access for chat participants.
     */
    match /chats/{chatId} {
      function isParticipant(buyerId, sellerId) {
        return request.auth != null && (request.auth.uid == buyerId || request.auth.uid == sellerId);
      }

      allow get: if isParticipant(resource.data.buyerId, resource.data.sellerId);
      allow list: if false; // Listing all chats is not permitted.
      allow create: if isParticipant(request.resource.data.buyerId, request.resource.data.sellerId);
      allow update: if isParticipant(resource.data.buyerId, resource.data.sellerId);
      allow delete: if isParticipant(resource.data.buyerId, resource.data.sellerId);
    }

    /**
     * @description Controls access to message documents within a chat.
     * @path /databases/{database}/documents/chats/{chatId}/messages/{messageId}
     * @allow (get, list) - Only participants of the chat can read messages.
     * @allow (create) - Only participants of the chat can create messages.
     * @allow (update, delete) - Updating/deleting messages is not permitted.
     * @deny (get, list) - A user who is not a participant cannot read messages in the chat.
     * @principle Enforces shared access for chat participants for messages.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
      }

      allow get: if isParticipant(chatId);
      allow list: if isParticipant(chatId);
      allow create: if isParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }
  }
}