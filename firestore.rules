/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and
 * associated data. Listings, jobs, and chats follow a more open read policy
 * with owner-only writes.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles.
 * - /users/{userId}/applications/{applicationId}: Stores job application references for each user.
 * - /users/{userId}/favouriteJobs/{jobId}: Stores favorite job references for each user.
 * - /listings/{listingId}: Stores listing data.
 * - /jobs/{jobId}: Stores job postings.
 * - /jobs/{jobId}/applications/{applicationId}: Stores job applications.
 * - /chats/{chatId}: Stores chat session data.
 * - /chats/{chatId}/messages/{messageId}: Stores messages within chat sessions.
 * - /feedbacks/{feedbackId}: Stores user feedback.
 *
 * Key Security Decisions:
 * - Users can only read their own profile data.
 * - Users can only manage their own job application and favorite job references.
 * - Listings and jobs are publicly readable, but only the owner can modify them.
 * - Chats are accessible to participants only.
 * - Feedback is publicly writable, but the userId must match the authenticated user.
 *
 * Denormalization for Authorization:
 * - Chats include a 'participants' array containing the UIDs of the buyer and seller, enabling efficient access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, list) User with matching UID can read their own profile.
     * @allow (create, update, delete) User with matching UID can create/update/delete their own profile.
     * @deny (get, list) User trying to read another user's profile.
     * @deny (create, update, delete) User trying to modify another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to job application references for a user.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, list) User with matching UID can read their own application references.
     * @allow (create, update, delete) User with matching UID can create/update/delete their own application references.
     * @deny (get, list) User trying to read another user's application references.
     * @deny (create, update, delete) User trying to modify another user's application references.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/applications/{applicationId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
        }
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to favorite job references for a user.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, list) User with matching UID can read their own favorite job references.
     * @allow (create, update, delete) User with matching UID can create/update/delete their own favorite job references.
     * @deny (get, list) User trying to read another user's favorite job references.
     * @deny (create, update, delete) User trying to modify another user's favorite job references.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
        }
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to listings. Listings are publicly readable, but only the seller can modify them.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read listings.
     * @allow (create) Only the authenticated user can create a listing, and sellerId must match their UID.
     * @allow (update, delete) Only the seller can update or delete their listing.
     * @deny (create) User attempts to create a listing with a mismatched sellerId.
     * @deny (update, delete) User attempts to modify a listing they don't own.
     * @principle Public read, owner-only write.
     */
    match /listings/{listingId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(sellerId) {
          return request.auth.uid == sellerId;
        }

        function isExistingOwner() {
            return isSignedIn() && resource.data.sellerId == request.auth.uid;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
        allow update: if isExistingOwner();
        allow delete: if isExistingOwner();
    }

    /**
     * @description Controls access to job postings. Jobs are publicly readable, but only the recruiter can modify them.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read job postings.
     * @allow (create) Only the authenticated user can create a job posting, and recruiterId must match their UID.
     * @allow (update, delete) Only the recruiter can update or delete their job posting.
     * @deny (create) User attempts to create a job posting with a mismatched recruiterId.
     * @deny (update, delete) User attempts to modify a job posting they don't own.
     * @principle Public read, owner-only write.
     */
    match /jobs/{jobId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(recruiterId) {
          return request.auth.uid == recruiterId;
        }
        
        function isExistingOwner() {
            return isSignedIn() && resource.data.recruiterId == request.auth.uid;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
        allow update: if isExistingOwner();
        allow delete: if isExistingOwner();
    }

    /**
     * @description Controls access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get, list) Any user can read applications for a job posting.
     * @allow (create) Only the authenticated user can create an application, and applicantId must match their UID.
     * @allow (update, delete) Only the applicant can update or delete their application.
     * @deny (create) User attempts to create an application with a mismatched applicantId.
     * @deny (update, delete) User attempts to modify an application they don't own.
     * @principle Public read, owner-only write.
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner() {
          return request.auth.uid == resource.data.applicantId;
        }
        
        function isExistingOwner() {
            return isSignedIn() && resource.data.applicantId == request.auth.uid;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
        allow update: if isExistingOwner();
        allow delete: if isExistingOwner();
    }

    /**
     * @description Controls access to chat sessions.
     * @path /chats/{chatId}
     * @allow (get, list) Only participants can read chat sessions.
     * @allow (create) Only authenticated users can create chat sessions, and they must be a participant.
     * @allow (update, delete) Only participants can update or delete chat sessions.
     * @deny (get, list) User attempts to read a chat session they are not a participant in.
     * @deny (create) User attempts to create a chat session without being a participant.
     * @deny (update, delete) User attempts to modify a chat session they are not a participant in.
     * @principle Shared access (closed collaborators).
     */
    match /chats/{chatId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isParticipant() {
          return request.auth.uid in resource.data.participants;
        }

        function isExistingParticipant() {
            return isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
        }

        allow get: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
        allow list: if false; // Listing chats should be disabled for privacy
        allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]);
        allow update: if isExistingParticipant();
        allow delete: if isExistingParticipant();
    }

    /**
     * @description Controls access to messages within a specific chat session.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) Only participants of the chat can read messages.
     * @allow (create) Only participants of the chat can create messages, and senderId must match their UID.
     * @allow (update, delete) No one can update or delete messages (messages are immutable).
     * @deny (get, list) User attempts to read messages in a chat they are not a participant in.
     * @deny (create) User attempts to create a message with a mismatched senderId.
     * @deny (update, delete) All updates and deletes.
     * @principle Shared access (closed collaborators) with message immutability.
     */
    match /chats/{chatId}/messages/{messageId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isChatParticipant() {
            return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow get: if isSignedIn() && isChatParticipant();
        allow list: if isSignedIn() && isChatParticipant();
        allow create: if isSignedIn() && isChatParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Controls access to user-submitted feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read feedback.
     * @allow (create) Only authenticated users can create feedback, and userId must match their UID.
     * @allow (update, delete) Only the feedback owner can update/delete their feedback.
     * @deny (create) User attempts to create feedback with a mismatched userId.
     * @deny (update, delete) User attempts to modify feedback they don't own.
     * @principle Public read, owner-only write.
     */
    match /feedbacks/{feedbackId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner() {
          return request.auth.uid == resource.data.userId;
        }

        function isExistingOwner() {
            return isSignedIn() && resource.data.userId == request.auth.uid;
        }
        
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner();
        allow delete: if isExistingOwner();
    }
  }
}