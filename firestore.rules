/**
 * @fileOverview
 * This ruleset enforces a strict user-ownership model for user-related data,
 * public read access for listings and jobs, and shared access for chats.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, owned by the user.
 * - /users/{userId}/applications/{applicationId}: Job application references, owned by the user.
 * - /users/{userId}/favouriteJobs/{jobId}: Favorite job references, owned by the user.
 * - /users/{userId}/savedSearches/{searchId}: Saved job searches, owned by the user.
 * - /listings/{listingId}: Public listings, owned by the seller (sellerId field).
 * - /jobs/{jobId}: Public job postings, owned by the recruiter (recruiterId field).
 * - /jobs/{jobId}/applications/{applicationId}: Applications for a specific job.
 * - /chats/{chatId}: Chat sessions between users (buyerId, sellerId, and participants array).
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat session.
 * - /feedbacks/{feedbackId}: User feedback, publicly accessible.
 *
 * Key Security Decisions:
 * - User data is strictly controlled by the user's authentication ID.
 * - Listing and Job data are publicly readable, but only the owner can modify them.
 * - Chat data is only accessible to the participants.
 * - Feedback data is publicly readable.
 *
 * Denormalization for Authorization:
 * - Listings: Each listing has a `sellerId` field to enable owner-based write rules.
 * - Jobs: Each job has a `recruiterId` field to enable owner-based write rules.
 * - Chats: Each chat has `buyerId`, `sellerId`, and `participants` fields to enable participant-based read/write rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User 'user_abc' can create their profile if request.auth.uid == 'user_abc'.
     * @allow (get, list) User 'user_abc' can read their own profile.
     * @allow (update, delete) User 'user_abc' can update/delete their profile if request.auth.uid == 'user_abc'.
     * @deny (create) User 'user_xyz' cannot create a profile for 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User 'user_abc' can create an application reference under their profile.
     * @allow (get, list) User 'user_abc' can read their application references.
     * @allow (update, delete) User 'user_abc' can update/delete their application references.
     * @deny (create) User 'user_xyz' cannot create an application reference for 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' application references.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to a user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User 'user_abc' can create a favorite job reference under their profile.
     * @allow (get, list) User 'user_abc' can read their favorite job references.
     * @allow (update, delete) User 'user_abc' can update/delete their favorite job references.
     * @deny (create) User 'user_xyz' cannot create a favorite job reference for 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' favorite job references.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to a user's saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create) User 'user_abc' can create a saved search under their profile.
     * @allow (get, list) User 'user_abc' can read their saved searches.
     * @allow (update, delete) User 'user_abc' can update/delete their saved searches.
     * @deny (create) User 'user_xyz' cannot create a saved search for 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' saved searches.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/savedSearches/{searchId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to listings.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read listings.
     * @allow (create) User 'user_abc' can create a listing if request.resource.data.sellerId == request.auth.uid.
     * @allow (update, delete) User 'user_abc' can update/delete a listing if they are the owner (sellerId).
     * @deny (create) User 'user_xyz' cannot create a listing for 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' listing.
     * @principle Allows public reads, but enforces ownership for writes.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(sellerId) {
        return isSignedIn() && request.auth.uid == sellerId;
      }
      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Controls access to job postings.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read job postings.
     * @allow (create) User 'user_abc' (recruiter) can create a job posting if request.resource.data.recruiterId == request.auth.uid.
     * @allow (update, delete) User 'user_abc' (recruiter) can update/delete a job posting if they are the owner (recruiterId).
     * @deny (create) User 'user_xyz' cannot create a job posting for 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' job posting.
     * @principle Allows public reads, but enforces ownership for writes.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(recruiterId) {
        return isSignedIn() && request.auth.uid == recruiterId;
      }
      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Controls access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) User 'user_abc' can create an application if request.auth.uid matches applicantId.
     * @allow (get, list) Any authenticated user can list/get job applications.
     * @allow (update, delete) Only the applicant (applicantId) can update/delete their application.
     * @deny (create) User 'user_xyz' cannot create an application with 'user_abc' as the applicantId.
     * @deny (update, delete) User 'user_xyz' cannot update/delete 'user_abc' applications.
     * @principle Enforces applicant ownership, recruiter readable.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(applicantId) {
        return isSignedIn() && request.auth.uid == applicantId;
      }
      function isExistingOwner(applicantId) {
        return isOwner(applicantId) && resource != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.applicantId);
      allow delete: if isExistingOwner(resource.data.applicantId);
    }

    /**
     * @description Controls access to chat sessions.
     * @path /chats/{chatId}
     * @allow (get, list) User can read chat if they are a participant.
     * @allow (create) User can create a chat if they are one of the participants.
     * @allow (update, delete) User can update/delete a chat if they are one of the participants.
     * @deny (get, list) User cannot read a chat if they are not a participant.
     * @deny (create) User cannot create a chat if they are not one of the participants.
     * @deny (update, delete) User cannot update/delete a chat if they are not one of the participants.
     * @principle Enforces participant access.
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isParticipant() {
          return isSignedIn() && request.auth.uid in resource.data.participants;
      }
       function isNewParticipant() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }
      function isExistingParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants && resource != null;
      }

      allow get, list: if isParticipant();
      allow create: if isSignedIn() && isNewParticipant();
      allow update: if isExistingParticipant();
      allow delete: if isExistingParticipant();
    }

    /**
     * @description Controls access to messages within a specific chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) User can read message if they are a participant of the chat.
     * @allow (create) User can create a message if they are a participant of the chat and their uid matches senderId.
     * @allow (update, delete) No one is allowed to update or delete messages.
     * @deny (get, list) User cannot read a message if they are not a participant of the chat.
     * @deny (create) User cannot create a message if they are not a participant of the chat.
     * @deny (update, delete) No one is allowed to update or delete messages.
     * @principle Enforces participant access, create validation.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isChatParticipant() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
      allow get, list: if isSignedIn() && isChatParticipant();
      allow create: if isSignedIn() && isChatParticipant() && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read feedback.
     * @allow (create) Any authenticated user can create feedback.
     * @allow (update, delete) No one is allowed to update or delete feedback.
     * @deny (update, delete) No one is allowed to update or delete feedback.
     * @principle Allows public reads, authenticated creates, no updates or deletes.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}