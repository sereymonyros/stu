/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and associated data,
 * and a public-read, owner-write model for listings, jobs, and feedback. Chats and messages are secured
 * using a shared-access pattern based on the participants.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, accessible only by the user themselves.
 * - /users/{userId}/applications/{applicationId}: Job application references, accessible only by the user themselves.
 * - /users/{userId}/favouriteJobs/{jobId}: Favorite job references, accessible only by the user themselves.
 * - /users/{userId}/savedSearches/{searchId}: Saved job searches, accessible only by the user themselves.
 * - /listings/{listingId}: Publicly readable listings, writable only by the seller (owner).
 * - /jobs/{jobId}: Publicly readable job postings, writable only by the recruiter (owner).
 * - /jobs/{jobId}/applications/{applicationId}: Applications for a specific job, writable only by the applicant.
 * - /chats/{chatId}: Chat sessions between users, accessible only by participants.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat, accessible only by chat participants.
 * - /feedbacks/{feedbackId}: Publicly readable feedback, writable only by the user who submitted it.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All write operations require a valid, authenticated user.
 * - Data validation is limited to ownership checks and relational integrity.
 *
 * Denormalization for Authorization:
 * - Listings: `sellerId` is used to enforce owner-only writes.
 * - Jobs: `recruiterId` is used to enforce owner-only writes.
 * - Chats: `participants` array is used to enforce shared access.
 * - Messages: Access is controlled by the parent chat's `participants`.
 * - Feedbacks: `userId` is used to enforce owner-only writes.
 *
 * Structural Segregation:
 * - Private user data is stored under /users/{userId}, while public listings and jobs are stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Allows users to manage their job application references.
     * @path /users/{userId}/applications/{applicationId}
     */
    match /users/{userId}/applications/{applicationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Allows users to manage their favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Allows users to manage their saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     */
    match /users/{userId}/savedSearches/{searchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Allows anyone to read listings, but only the seller can create, update, or delete them.
     * @path /listings/{listingId}
     */
    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
    }

    /**
     * @description Allows anyone to read job postings, but only the recruiter can create, update, or delete them.
     * @path /jobs/{jobId}
     */
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
    }

    /**
     * @description Allows applicants to create applications for a job. Only the applicant can manage their application.
     * @path /jobs/{jobId}/applications/{applicationId}
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow read: if false; // Intentionally not listable or gettable.
      allow write: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
    }

    /**
     * @description Allows participants of a chat to read and write messages.
     * @path /chats/{chatId}
     */
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.resource.data.participants.hasAny([request.auth.uid]);
    }

    /**
     * @description Allows participants of a chat to read and write messages.
     * @path /chats/{chatId}/messages/{messageId}
     */
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }

    /**
     * @description Allows anyone to read feedback, but only the submitter can create it. Update/delete are disallowed.
     * @path /feedbacks/{feedbackId}
     */
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}