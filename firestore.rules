rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (get, update, delete) User with UID 'user123' can read/write their own profile at /users/user123.
     * @allow (create) User with UID 'user123' can create their own profile at /users/user123 if request.auth.uid == 'user123'.
     * @deny (get, update, delete) User with UID 'user456' cannot read/write the profile of user 'user123' at /users/user123.
     * @deny (create) User with UID 'user456' cannot create a profile at /users/user123.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.uid == request.auth.uid;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure user's job application references, allowing only the owner to read and write.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, list, create, update, delete) User with UID 'user123' can manage their applications at /users/user123/applications/app1.
     * @deny (get, list, create, update, delete) User with UID 'user456' cannot manage applications for user 'user123'.
     * @principle Restricts access to a user's own job application references.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure user's favorite job references, allowing only the owner to read and write.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, list, create, update, delete) User with UID 'user123' can manage their favorite jobs at /users/user123/favouriteJobs/job1.
     * @deny (get, list, create, update, delete) User with UID 'user456' cannot manage favorite jobs for user 'user123'.
     * @principle Restricts access to a user's own favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allow public read access to listings, but restrict write access to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read any listing.
     * @allow (create) User with UID 'user123' can create a listing where listing.sellerId == 'user123'.
     * @allow (update, delete) User with UID 'user123' can update/delete a listing where listing.sellerId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a listing where listing.sellerId != 'user456'.
     * @deny (update, delete) User with UID 'user456' cannot update/delete a listing where listing.sellerId == 'user123'.
     * @principle Allows public read access with owner-only writes.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }

      function isExistingOwner(sellerId) {
        return isOwner(sellerId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.sellerId);
      allow update: if isOwner(resource.data.sellerId) && request.auth.uid == resource.data.sellerId;
      allow delete: if isOwner(resource.data.sellerId) && request.auth.uid == resource.data.sellerId;
    }

    /**
     * @description Allow public read access to job postings, but restrict write access to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read any job posting.
     * @allow (create) User with UID 'recruiter123' can create a job where job.recruiterId == 'recruiter123'.
     * @allow (update, delete) User with UID 'recruiter123' can update/delete a job where job.recruiterId == 'recruiter123'.
     * @deny (create) User with UID 'user456' cannot create a job where job.recruiterId != 'user456'.
     * @deny (update, delete) User with UID 'user456' cannot update/delete a job where job.recruiterId == 'user123'.
     * @principle Allows public read access with owner-only writes.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }

      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.recruiterId);
      allow update: if isOwner(resource.data.recruiterId) && request.auth.uid == resource.data.recruiterId;
      allow delete: if isOwner(resource.data.recruiterId) && request.auth.uid == resource.data.recruiterId;
    }

    /**
     * @description Secure job applications, allowing the applicant and the recruiter to access.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get, list) Recruiter and Applicant can view application details
     * @allow (create) Applicant can apply to Jobs
     * @allow (update, delete) Recruiter can update and delete the application
     * @principle shared read and write access based on recruiterId and applicantId
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isApplicant(applicantId) {
        return request.auth.uid == applicantId;
      }

      function isRecruiter(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }

      allow get: if request.auth.uid == resource.data.applicantId || isRecruiter(jobId);
      allow list: if isRecruiter(jobId);
      allow create: if request.auth.uid == request.resource.data.applicantId;
      allow update: if isRecruiter(jobId);
      allow delete: if isRecruiter(jobId);
    }

    /**
     * @description Secure chat sessions, allowing only participants to read and write.
     * @path /chats/{chatId}
     * @allow (get, list, create, update, delete) Participants can read/write chat messages.
     * @deny (get, list, create, update, delete) Non-participants cannot access chat messages.
     * @principle Restricts access to chat participants.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }

      allow get: if request.auth.uid in resource.data.participants;
      allow list: if false; // Listing chats could expose private info
      allow create: if request.auth.uid in request.resource.data.participants;
      allow update: if request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    /**
     * @description Secure messages within a chat, allowing only chat participants to read and write.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list, create, update, delete) Participants can read/write chat messages.
     * @deny (get, list, create, update, delete) Non-participants cannot access chat messages.
     * @principle Restricts access to chat participants.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isChatParticipant(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }

      allow get: if isChatParticipant(chatId);
      allow list: if false;
      allow create: if isChatParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allow public read access to user feedback, but restrict write access to the user.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read any feedback.
     * @allow (create) User with UID 'user123' can create feedback where feedback.userId == 'user123'.
     * @allow (update, delete) User with UID 'user123' can update/delete feedback where feedback.userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create feedback where feedback.userId != 'user456'.
     * @deny (update, delete) User with UID 'user456' cannot update/delete feedback where feedback.userId == 'user123'.
     * @principle Allows public read access with owner-only writes.
     */
    match /feedbacks/{feedbackId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.auth.uid == resource.data.userId;
      allow delete: if isOwner(resource.data.userId) && request.auth.uid == resource.data.userId;
    }
  }
}