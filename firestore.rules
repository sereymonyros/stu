rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Listings are public, but can only be created/modified by authenticated users.
    match /listings/{listingId} {
      allow read;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }

    // Allow public read for jobs, but restrict writes to the recruiter who owns it.
    match /jobs/{jobId} {
      allow read;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.recruiterId;

      // Recruiters can read all applications for their jobs.
      // Applicants can only create their own application.
      match /applications/{applicationId} {
        allow read, update: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId;
        allow create: if request.auth != null && request.auth.uid == applicationId;
      }
    }

    // Company profiles are public.
    match /companies/{companyId} {
      allow read;
    }

    // Users can read/write their own profile data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Users can manage their own applications, favorite jobs, and saved searches.
      match /applications/{applicationId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /favouriteJobs/{jobId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /savedSearches/{searchId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Feedback can be created by any authenticated user.
    match /feedbacks/{feedbackId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Chat logic: Participants can read/write to the chat and its messages.
    match /chats/{chatId} {
        allow read, create, update: if request.auth != null && request.auth.uid in resource.data.participants;
        
        match /messages/{messageId} {
            allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
    }
  }
}
