/**
 * @fileoverview Firestore Security Rules for the job board application.
 *
 * Core Philosophy:
 * This ruleset prioritizes user privacy and data ownership. Users can only
 * read and modify their own profile data. Public data (listings, jobs) are
 * generally readable, but write access is restricted to authorized users
 * (sellers, recruiters).
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /listings/{listingId}: Contains items for sale.
 * - /jobs/{jobId}: Contains job postings.
 * - /chats/{chatId}: Contains chat sessions between users.
 * - /feedbacks/{feedbackId}: Contains feedback data for the application.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to the listings and jobs collections.
 * - Ownership is enforced for user profiles and related subcollections.
 * - Data validation is minimized in this prototyping phase.
 *
 * Denormalization for Authorization:
 *  - Listings have a `sellerId` field for easy ownership checks.
 *  - Jobs have a `recruiterId` field for easy ownership checks.
 */
rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {
    // New, safe function to retrieve a user's role
    function getUserRole() {
      // 1. Check if the user is authenticated at all.
      if request.auth == null {
        return null;
      }
      
      // 2. Safely get the user document using 'exists()' and 'get()'.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));

      // 3. Return the role if the document exists, otherwise return a default/null value.
      return userDoc.exists ? userDoc.data.role : null;
    }

    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/favoriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }

      function isExistingOwner() {
        return resource.data.sellerId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner();
      allow delete: if isSignedIn() && isExistingOwner();
    }

    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }

      function isExistingOwner() {
        return resource.data.recruiterId == request.auth.uid;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if getUserRole() in ['recruiter', 'standard'];;
      allow create: if getUserRole() == 'recruiter';
      allow update, delete: if getUserRole() == 'recruiter' && isExistingOwner();
    }

    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    
    match /jobs/{jobId}/applications/{applicationId} {
      function isJobOwner(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn() && isJobOwner(jobId);
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    match /chats/{chatId} {
      function isParticipant() {
        return resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn() && isParticipant();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isParticipant();
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      function isParticipant(chatId) {
        let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
        return chat.buyerId == request.auth.uid
               || chat.sellerId == request.auth.uid;
      }
       function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn() && isParticipant(chatId);
      allow create: if isSignedIn() && isParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }
  }
}