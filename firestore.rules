/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-tenant security model with user-based access control.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Listings are stored under `/listings/{listingId}`.
 * - Jobs are stored under `/jobs/{jobId}`.
 * - Chats are stored under `/chats/{chatId}`.
 * - Feedbacks are stored under `/feedbacks/{feedbackId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listings can be read by anyone, but only the owner (seller) can create, update, or delete them.
 * - Jobs can be read by anyone, but only the recruiter who created them can modify them.
 * - Chats can be read and written to only by the participants involved.
 * - Feedbacks can be created by anyone.
 * - Listing is publicly listable.
 * - Job is publicly listable.
 * - Chats are not publicly listable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) User with matching {userId}
     * @deny (get, create, update, delete) User with non-matching {userId}
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows users to manage their job applications references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, create, update, delete, list) User with matching {userId}
     * @deny (get, create, update, delete, list) User with non-matching {userId}
     * @principle Enforces document ownership for user applications.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows users to manage their favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, create, update, delete, list) User with matching {userId}
     * @deny (get, create, update, delete, list) User with non-matching {userId}
     * @principle Enforces document ownership for user favorite jobs.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts writes to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) Anyone
     * @allow (create) Signed-in user where request.resource.data.sellerId == request.auth.uid
     * @allow (update, delete) Signed-in user who is the seller and the listing exists
     * @deny (create) Signed-in user where request.resource.data.sellerId != request.auth.uid
     * @deny (update, delete) Non-seller or non-existent listing
     * @principle Allows public read with owner-only writes, enforcing ownership.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }
       function isExistingOwner(sellerId) {
        return isOwner(sellerId) && getAfter(resource).data.sellerId == request.auth.uid;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(request.auth.uid);
      allow delete: if isSignedIn() && isExistingOwner(request.auth.uid);
    }

    /**
     * @description Allows public read access to jobs, but restricts writes to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) Anyone
     * @allow (create) Signed-in recruiter where request.resource.data.recruiterId == request.auth.uid
     * @allow (update, delete) Signed-in recruiter who is the recruiter and the job exists
     * @deny (create) Signed-in recruiter where request.resource.data.recruiterId != request.auth.uid
     * @deny (update, delete) Non-recruiter or non-existent job
     * @principle Allows public read with owner-only writes, enforcing ownership.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth != null && request.auth.uid == recruiterId;
      }
      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && getAfter(resource).data.recruiterId == request.auth.uid;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(request.auth.uid);
      allow delete: if isSignedIn() && isExistingOwner(request.auth.uid);
    }

    /**
     * @description Allows users to manage applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get, list, create, update, delete) Only the applicant.
     * @deny (get, list, create, update, delete) Other users.
     * @principle Enforces document ownership for job applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isOwner(applicantId) {
        return request.auth != null && request.auth.uid == applicantId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(request.auth.uid);
      allow delete: if isSignedIn() && isOwner(request.auth.uid);
    }

    /**
     * @description Allows access to chats for participants only.
     * @path /chats/{chatId}
     * @allow (get, create, update, delete) If the user is a participant in the chat.
     * @deny (get, create, update, delete) If the user is not a participant.
     * @principle Enforces shared access for collaborative documents.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth != null && request.resource.data.participants.hasAny([request.auth.uid]);
      }
      function isExistingParticipant() {
        return request.auth != null && getAfter(resource).data.participants.hasAny([request.auth.uid]);
      }
      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if isSignedIn() && isExistingParticipant();
       allow list: if false;
       allow create: if isSignedIn() && isParticipant();
       allow update: if isSignedIn() && isExistingParticipant();
       allow delete: if false; // Chats should not be deleted directly.
    }

    /**
     * @description Allows messages to be read and written only by chat participants.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, create) If the user is a participant in the parent chat.
     * @deny (get, create, update, delete) If the user is not a participant.
     * @principle Enforces shared access for subcollections of collaborative documents.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant(chatId) {
         return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
      function isSignedIn() {
        return request.auth != null;
      }
       allow get: if isSignedIn() && isParticipant(chatId);
       allow list: if false;
       allow create: if isSignedIn() && isParticipant(chatId);
       allow update: if false;
       allow delete: if false;
    }

    /**
     * @description Allows anyone to create feedback, but no one to read, update, or delete it.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Any signed-in user.
     * @deny (get, list, update, delete) All users.
     * @principle Restricts write access while allowing public creation.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}