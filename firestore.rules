/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and
 * associated data. Listings and Jobs are publicly readable but writable only
 * by their owners. Chats are restricted to the buyer and seller. Feedback
 * is open.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, owned by the user.
 * - /users/{userId}/applications/{applicationId}: User's job application references, owned by the user.
 * - /users/{userId}/favouriteJobs/{jobId}: User's favorited job references, owned by the user.
 * - /listings/{listingId}: Publicly readable listings, owned by the seller.
 * - /jobs/{jobId}: Publicly readable job postings, owned by the recruiter.
 * - /jobs/{jobId}/applications/{applicationId}: Applications for a specific job.
 * - /chats/{chatId}: Chat sessions between buyers and sellers.
 * - /chats/{chatId}/messages/{messageId}: Messages within a chat.
 * - /feedbacks/{feedbackId}: User-submitted feedback (open).
 *
 * Key Security Decisions:
 * - User profiles are only readable and writable by the owning user.
 * - Listings and Jobs are publicly readable to maximize discoverability.
 * - Chats are restricted to participating users (buyer and seller).
 * - Feedback is open.
 *
 * Denormalization for Authorization:
 * - Chats use a 'participants' array to quickly determine if a user is authorized to read or write messages.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user profile data.
     * @path /users/{userId}
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages access to a user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages access to listings.  Listings are publicly readable, but only the seller can modify them.
     * @path /listings/{listingId}
     */
    match /listings/{listingId} {
        function isSignedIn() {
            return request.auth != null;
        }
        function isOwner(sellerId) {
            return isSignedIn() && request.auth.uid == sellerId;
        }
        function isExistingOwner() {
            return isSignedIn() && request.auth.uid == resource.data.sellerId;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
        allow update: if isSignedIn() && request.auth.uid == resource.data.sellerId;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    /**
     * @description Manages access to job postings.  Jobs are publicly readable, but only the recruiter can modify them.
     * @path /jobs/{jobId}
     */
    match /jobs/{jobId} {
        function isSignedIn() {
            return request.auth != null;
        }
        function isOwner(recruiterId) {
            return isSignedIn() && request.auth.uid == recruiterId;
        }
        function isExistingOwner() {
            return isSignedIn() && request.auth.uid == resource.data.recruiterId;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
        allow update: if isSignedIn() && request.auth.uid == resource.data.recruiterId;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.recruiterId;
    }

    /**
     * @description Manages access to applications for a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && false;
    }

    /**
     * @description Manages access to chat sessions. Only participants can read and write.
     * @path /chats/{chatId}
     */
    match /chats/{chatId} {
        function isSignedIn() {
            return request.auth != null;
        }
        function isParticipant() {
            return isSignedIn() && request.auth.uid in resource.data.participants;
        }
        function isCreatingParticipant() {
            return isSignedIn() && request.auth.uid in request.resource.data.participants;
        }
        allow get: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
        allow list: if false;
        allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]);
        allow update: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
        allow delete: if false;
    }

    /**
     * @description Manages access to messages within a chat. Only participants can read and write.
     * @path /chats/{chatId}/messages/{messageId}
     */
    match /chats/{chatId}/messages/{messageId} {
        function isSignedIn() {
            return request.auth != null;
        }
        function isChatParticipant(chatId) {
            return isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        }

        allow get: if isChatParticipant(chatId);
        allow list: if false;
        allow create: if isChatParticipant(chatId);
        allow update: if isChatParticipant(chatId);
        allow delete: if false;
    }

    /**
     * @description Manages access to user-submitted feedback.
     * @path /feedbacks/{feedbackId}
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}