rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create, update, get, delete, list) if the user's UID matches the userId in the path.
     * @deny (create, update, delete) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, update, get, delete, list) if the user's UID matches the userId in the path.
     * @deny (create, update, delete) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create, update, get, delete, list) if the user's UID matches the userId in the path.
     * @deny (create, update, delete) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create, update, get, delete, list) if the user's UID matches the userId in the path.
     * @deny (create, update, delete) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/savedSearches/{searchId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read listings, but only the seller can modify them.
     * @path /listings/{listingId}
     * @allow (get, list) to anyone.
     * @allow (create, update, delete) only to the seller (owner).
     * @deny (create, update, delete) if not the seller.
     * @principle Public read access with owner-only writes.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    /**
     * @description Allows anyone to read jobs, but only the recruiter can modify them.
     * @path /jobs/{jobId}
     * @allow (get, list) to anyone.
     * @allow (create, update, delete) only to the recruiter (owner).
     * @deny (create, update, delete) if not the recruiter.
     * @principle Public read access with owner-only writes.
     */
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    /**
     * @description Restricts access to job applications to the applicant and the recruiter.
     * @path /jobs/{jobId}/applications/{applicationId}
     */
    match /jobs/{jobId}/applications/{applicationId} {
       allow read, write: if request.auth != null;
    }

    /**
     * @description Restricts access to chats to participants only.
     * @path /chats/{chatId}
     * @allow (get, list) if the user is a participant in the chat.
     * @allow (create) if the user is creating the chat with valid participant IDs.
     * @allow (update) if the user is a participant and updating allowed fields.
     * @deny (delete) always.
     * @principle Shared access (closed collaborators).
     */
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    /**
     * @description Restricts access to messages to participants of the parent chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) if the user is a participant in the parent chat.
     * @allow (create) if the user is a participant in the parent chat and the sender.
     * @deny (update, delete) always.
     * @principle Shared access (closed collaborators).
     */
    match /chats/{chatId}/messages/{messageId} {
       allow read, write: if request.auth != null;
    }

    /**
     * @description Allows anyone to submit feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create) to anyone who is signed in.
     * @allow (get, list) to anyone.
     * @deny (update, delete) always.
     * @principle Public read access, authenticated write access.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read company profiles, but no one to create, update, or delete them.
     * @path /companies/{companyId}
     * @allow (get, list) to anyone.
     * @deny (create, update, delete) always.
     * @principle Public read access, no write access.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}