/**
 * @fileoverview Firestore Security Rules for the job board application.
 *
 * Core Philosophy:
 * This ruleset employs a strict user-ownership model for personal data (profiles, applications, favorites, searches)
 * and a public-read/owner-write model for job postings and listings.
 *
 * Data Structure:
 * - User data is nested under /users/{userId}.
 * - Job postings are stored in the top-level /jobs/{jobId} collection.
 * - Applications for a job are stored in /jobs/{jobId}/applications/{applicationId}.
 * - Listings (items for sale) are stored in the top-level /listings/{listingId} collection.
 * - Company profiles are stored in the top-level /companies/{companyId} collection.
 * - User feedback is stored in the top-level /feedbacks/{feedbackId}.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to the /jobs and /listings collections.
 * - Recruiter ID is denormalized onto the Job document for simpler security rules.
 *
 * Denormalization for Authorization:
 * - Job documents denormalize the recruiter's display name (`recruiterDisplayName`).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the resource exists.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is the existing owner, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

   /**
     * @description Grants access to user profile data.
     * @path /users/{userId}
     * @allow (create) User '6b43Hazb5dWAygJrWly999YbnvM2' can create their profile.
     * @deny (create) User '6b43Hazb5dWAygJrWly999YbnvM2' cannot create a profile with a different userId.
     * @allow (get) User '6b43Hazb5dWAygJrWly999YbnvM2' can read their profile.
     * @deny (get) User 'randomUserId' cannot read user profile '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (update) User '6b43Hazb5dWAygJrWly999YbnvM2' can update their profile.
     * @deny (update) User 'randomUserId' cannot update user profile '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) User '6b43Hazb5dWAygJrWly999YbnvM2' can delete their profile.
     * @deny (delete) User 'randomUserId' cannot delete user profile '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

   /**
     * @description Grants access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User '6b43Hazb5dWAygJrWly999YbnvM2' can create application references.
     * @deny (create) User 'randomUserId' cannot create application references under another user.
     * @allow (get) User '6b43Hazb5dWAygJrWly999YbnvM2' can read their application reference.
     * @deny (get) User 'randomUserId' cannot read application reference of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (list) User '6b43Hazb5dWAygJrWly999YbnvM2' can list their application references.
     * @deny (update) User 'randomUserId' cannot update application reference of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) User '6b43Hazb5dWAygJrWly999YbnvM2' can delete their application reference.
     * @deny (delete) User 'randomUserId' cannot delete application reference of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Enforces user-ownership for application references.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

   /**
     * @description Grants access to a user's favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User '6b43Hazb5dWAygJrWly999YbnvM2' can create favorite job references.
     * @deny (create) User 'randomUserId' cannot create favorite job references under another user.
     * @allow (get) User '6b43Hazb5dWAygJrWly999YbnvM2' can read their favorite job reference.
     * @deny (get) User 'randomUserId' cannot read favorite job reference of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (list) User '6b43Hazb5dWAygJrWly999YbnvM2' can list their favorite job references.
     * @deny (update) User 'randomUserId' cannot update favorite job reference of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) User '6b43Hazb5dWAygJrWly999YbnvM2' can delete their favorite job reference.
     * @deny (delete) User 'randomUserId' cannot delete favorite job reference of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Enforces user-ownership for favorite job references.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create) User '6b43Hazb5dWAygJrWly999YbnvM2' can create saved job searches.
     * @deny (create) User 'randomUserId' cannot create saved job searches under another user.
     * @allow (get) User '6b43Hazb5dWAygJrWly999YbnvM2' can read their saved job search.
     * @deny (get) User 'randomUserId' cannot read saved job search of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (list) User '6b43Hazb5dWAygJrWly999YbnvM2' can list their saved job searches.
     * @deny (update) User 'randomUserId' cannot update saved job search of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) User '6b43Hazb5dWAygJrWly999YbnvM2' can delete their saved job search.
     * @deny (delete) User 'randomUserId' cannot delete saved job search of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Enforces user-ownership for saved job searches.
     */
    match /users/{userId}/savedSearches/{searchId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants public read access to listings and restricts write access to the owner.
     * @path /listings/{listingId}
     * @allow (create) User '6b43Hazb5dWAygJrWly999YbnvM2' can create a listing with their ID as the sellerId.
     * @deny (create) User '6b43Hazb5dWAygJrWly999YbnvM2' cannot create a listing with another user's ID as the sellerId.
     * @allow (get) Any user can read any listing.
     * @allow (list) Any user can list listings.
     * @allow (update) User '6b43Hazb5dWAygJrWly999YbnvM2' can update their listing.
     * @deny (update) User 'randomUserId' cannot update listing of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) User '6b43Hazb5dWAygJrWly999YbnvM2' can delete their listing.
     * @deny (delete) User 'randomUserId' cannot delete listing of user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Allows public read access but restricts writes to the listing owner.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid && resource != null;
    }

    /**
     * @description Grants public read access to job postings and restricts write access to the recruiter.
     * @path /jobs/{jobId}
     * @allow (create) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can create a job with their ID as the recruiterId.
     * @deny (create) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' cannot create a job with another recruiter's ID.
     * @allow (get) Any user can read any job posting.
     * @allow (list) Any user can list job postings.
     * @allow (update) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can update their job posting.
     * @deny (update) User 'randomUserId' cannot update job posting of recruiter '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can delete their job posting.
     * @deny (delete) User 'randomUserId' cannot delete job posting of recruiter '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Allows public read access but restricts writes to the job posting owner (recruiter).
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recruiterId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.recruiterId == request.auth.uid && resource != null;
    }

   /**
     * @description Grants access to applications to a specific job. Only the job poster/recruiter can list/read/write applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can create application to job.
     * @deny (create) User 'randomUserId' cannot create application to job.
     * @allow (get) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can get application to job.
     * @deny (get) User 'randomUserId' cannot get application to job.
     * @allow (list) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can list applications to job.
     * @deny (list) User 'randomUserId' cannot list applications to job.
     * @allow (update) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can update application to job.
     * @deny (update) User 'randomUserId' cannot update application to job.
     * @allow (delete) Recruiter '6b43Hazb5dWAygJrWly999YbnvM2' can delete application to job.
     * @deny (delete) User 'randomUserId' cannot delete application to job.
     * @principle Only the job poster/recruiter can list/read/write applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      allow list: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid && resource != null;
    }

    /**
     * @description Grants public read access to user feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (create) User '6b43Hazb5dWAygJrWly999YbnvM2' can submit feedback.
     * @deny (create) User 'randomUserId' cannot submit feedback with another ID.
     * @allow (get) Any user can read any feedback.
     * @allow (list) Any user can list feedbacks.
     * @allow (update) User '6b43Hazb5dWAygJrWly999YbnvM2' can update their own feedback.
     * @deny (update) User 'randomUserId' cannot update feedback submitted by user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @allow (delete) User '6b43Hazb5dWAygJrWly999YbnvM2' can delete their own feedback.
     * @deny (delete) User 'randomUserId' cannot delete feedback submitted by user '6b43Hazb5dWAygJrWly999YbnvM2'.
     * @principle Allows public read access to feedback, restricts write access to owner.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && resource != null;
    }

    /**
     * @description Grants public read access to company profiles.
     * @path /companies/{companyId}
     * @allow (create) Any signed-in user can create a company profile.
     * @allow (get) Any user can read any company profile.
     * @allow (list) Any user can list company profiles.
     * @allow (update) Any signed-in user can update a company profile.
     * @allow (delete) Any signed-in user can delete a company profile.
     */
    match /companies/{companyId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}