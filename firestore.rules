rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to a user's profile only to the user themselves.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates their profile at /users/user123 with matching uid field.
     * @deny (create) User with UID 'user123' attempts to create a profile at /users/user456.
     * @deny (update) User with UID 'user123' attempts to update the profile at /users/user456.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isSignedIn() && isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's job application references only to the user themselves.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User with UID 'user123' creates an application reference under their profile.
     * @deny (list) Any user attempts to list application references for another user.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return isSignedIn() && isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's favorite job references only to the user themselves.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User with UID 'user123' creates a favorite job reference under their profile.
     * @deny (list) Any user attempts to list favorite jobs for another user.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return isSignedIn() && isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's saved job searches only to the user themselves.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create) User with UID 'user123' creates a saved search under their profile.
     * @deny (list) Any user attempts to list saved searches for another user.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/savedSearches/{searchId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return isSignedIn() && isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts write access to the listing owner.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read any listing.
     * @allow (create) User with UID 'user123' creates a listing with sellerId: 'user123'.
     * @deny (create) User with UID 'user123' creates a listing with sellerId: 'user456'.
     * @deny (update) User with UID 'user123' attempts to update a listing they don't own.
     * @principle Allows public reads with owner-only writes.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(sellerId) {
        return isSignedIn() && request.auth.uid == sellerId;
      }
      function isExistingOwner(sellerId) {
          return isSignedIn() && request.auth.uid == resource.data.sellerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(listingId);
      allow delete: if isExistingOwner(listingId);
    }

    /**
     * @description Allows public read access to job postings, but restricts write access to the recruiter who posted the job.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read any job posting.
     * @allow (create) Recruiter with UID 'recruiter123' creates a job posting with recruiterId: 'recruiter123'.
     * @deny (create) User with UID 'user123' creates a job posting with recruiterId: 'user456'.
     * @deny (update) User with UID 'user123' attempts to update a job posting they don't own.
     * @principle Allows public reads with owner-only writes.
     */
    match /jobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(recruiterId) {
        return isSignedIn() && request.auth.uid == recruiterId;
      }
      function isExistingOwner(recruiterId) {
          return isSignedIn() && request.auth.uid == resource.data.recruiterId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(jobId);
      allow delete: if isExistingOwner(jobId);
    }

    /**
     * @description Allows the applicant and recruiter to access applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (get) Applicant or recruiter can read application
     * @allow (create) Applicant can create an application.
     * @deny (update) User who isn't the applicant or recruiter attempts to update the application.
     *
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isApplicant(applicantId) {
        return isSignedIn() && request.auth.uid == applicantId;
      }
      function isExistingApplicant(applicantId) {
        return isSignedIn() && request.auth.uid == resource.data.applicantId;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isExistingApplicant(applicationId);
      allow delete: if false;
    }

    /**
     * @description Restricts access to chats to only the participants.
     * @path /chats/{chatId}
     * @allow (get) User who is a participant in the chat can read the chat.
     * @allow (create) User who is a participant in the chat can create the chat.
     * @deny (update) User who isn't a participant attempts to update the chat.
     * @principle Secures shared resources by requiring user membership.
     */
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isParticipant(participants) {
        return participants.hasAny([request.auth.uid]);
      }
      function isExistingParticipant(participants) {
        return isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      }

      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow delete: if false;
    }

    /**
     * @description Restricts access to messages to only the participants of the parent chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get) User who is a participant in the parent chat can read the message.
     * @allow (create) User who is a participant in the parent chat can create the message.
     * @deny (update) User who isn't a participant attempts to update the message.
     * @principle Secures shared resources by requiring user membership.
     */
    match /chats/{chatId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isChatParticipant(chatId) {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
      function isExistingChatParticipant(chatId) {
        return isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }

      allow get: if isChatParticipant(chatId);
      allow list: if false;
      allow create: if isChatParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to feedback, but restricts write access to the user submitting the feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read any feedback.
     * @allow (create) User with UID 'user123' creates feedback with userId: 'user123'.
     * @deny (create) User with UID 'user123' creates feedback with userId: 'user456'.
     * @deny (update) User with UID 'user123' attempts to update feedback they don't own.
     * @principle Allows public reads with owner-only writes.
     */
    match /feedbacks/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isSignedIn() && request.auth.uid == resource.data.userId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(feedbackId);
      allow delete: if isExistingOwner(feedbackId);
    }
  }
}