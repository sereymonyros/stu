/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user-specific data and
 * provides controlled access to shared resources like listings, jobs, and chats. It prioritizes
 * security by default, explicitly denying access where not specifically granted.
 *
 * Data Structure:
 * - Users: Data is organized under /users/{userId}, with subcollections for applications,
 *   favorite jobs and saved searches.
 * - Listings: Publicly readable data stored in /listings/{listingId}.
 * - Jobs: Publicly readable data stored in /jobs/{jobId}, with subcollections for applications.
 * - Chats: Private data stored in /chats/{chatId}, accessible only to participants.
 * - Feedbacks: Data is stored in /feedbacks/{feedbackId}.
 * - Companies: Publicly readable data stored in /companies/{companyId}.
 *
 * Key Security Decisions:
 * - User profiles and associated data (applications, favorites, searches) are strictly
 *   user-owned, preventing unauthorized access or modification.
 * - Listings and Jobs are publicly readable but writable only by their respective owners
 *   (seller/recruiter).  The `create` operation will enforce that the `sellerId` or `recruiterId`
 *    matches the `request.auth.uid`.
 * - Chat sessions and messages are restricted to participating users.
 * - Listing of user documents and feedback documents are not allowed.
 *
 * Denormalization for Authorization:
 * - Chats store `buyerId` and `sellerId` to easily authorize access to chat sessions and messages.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile.
     * @allow (get) User with UID 'user123' can read their own profile.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @allow (delete) User with UID 'user123' can delete their own profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (update) User with UID 'user456' cannot update the profile of 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && resource.data.uid == userId;
      allow delete: if isOwner(userId) && resource.data.uid == userId;
    }

    /**
     * @description Controls access to a user's job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User with UID 'user123' can create an application reference.
     * @allow (get) User with UID 'user123' can read their own application reference.
     * @allow (update) User with UID 'user123' can update their own application reference.
     * @allow (delete) User with UID 'user123' can delete their own application reference.
     * @deny (create) User with UID 'user456' cannot create an application reference for 'user123'.
     * @deny (update) User with UID 'user456' cannot update the application reference of 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the application reference of 'user123'.
     * @principle Enforces document ownership for user applications.
     */
    match /users/{userId}/applications/{applicationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to a user's favourite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User with UID 'user123' can create a favourite job reference.
     * @allow (get) User with UID 'user123' can read their own favourite job reference.
     * @allow (update) User with UID 'user123' can update their own favourite job reference.
     * @allow (delete) User with UID 'user123' can delete their own favourite job reference.
     * @deny (create) User with UID 'user456' cannot create a favourite job reference for 'user123'.
     * @deny (update) User with UID 'user456' cannot update the favourite job reference of 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the favourite job reference of 'user123'.
     * @principle Enforces document ownership for user favorite jobs.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to a user's saved job searches.
     * @path /users/{userId}/savedSearches/{searchId}
     * @allow (create) User with UID 'user123' can create a saved search.
     * @allow (get) User with UID 'user123' can read their own saved search.
     * @allow (update) User with UID 'user123' can update their own saved search.
     * @allow (delete) User with UID 'user123' can delete their own saved search.
     * @deny (create) User with UID 'user456' cannot create a saved search for 'user123'.
     * @deny (update) User with UID 'user456' cannot update the saved search of 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the saved search of 'user123'.
     * @principle Enforces document ownership for user saved searches.
     */
    match /users/{userId}/savedSearches/{searchId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to listing documents.
     * @path /listings/{listingId}
     * @allow (get) Any user can read any listing.
     * @allow (list) Any user can list all listings.
     * @allow (create) User with UID 'user123' can create a listing with sellerId 'user123'.
     * @allow (update) User with UID 'user123' can update their listing with sellerId 'user123', if the listing exists.
     * @allow (delete) User with UID 'user123' can delete their listing with sellerId 'user123', if the listing exists.
     * @deny (create) User with UID 'user456' cannot create a listing with sellerId 'user123'.
     * @deny (update) User with UID 'user456' cannot update the listing of sellerId 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the listing of sellerId 'user123'.
     * @principle Allows public reads with owner-only writes for listings.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth.uid == sellerId;
      }
      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.sellerId);
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Controls access to job documents.
     * @path /jobs/{jobId}
     * @allow (get) Any user can read any job.
     * @allow (list) Any user can list all jobs.
     * @allow (create) User with UID 'recruiter456' can create a job with recruiterId 'recruiter456'.
     * @allow (update) User with UID 'recruiter456' can update their job with recruiterId 'recruiter456', if the job exists.
     * @allow (delete) User with UID 'recruiter456' can delete their job with recruiterId 'recruiter456', if the job exists.
     * @deny (create) User with UID 'standard123' cannot create a job with recruiterId 'recruiter456'.
     * @deny (update) User with UID 'standard123' cannot update the job of recruiterId 'recruiter456'.
     * @deny (delete) User with UID 'standard123' cannot delete the job of recruiterId 'recruiter456'.
     * @principle Allows public reads with owner-only writes for jobs.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth.uid == recruiterId;
      }
      function isExistingOwner(recruiterId) {
        return isOwner(recruiterId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(request.resource.data.recruiterId);
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Controls access to job application documents under a specific job.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) User with UID 'user123' can create an application to job 'job789'.
     * @allow (get) User with UID 'user123' can read their application to job 'job789'.
     * @allow (update) User with UID 'user123' can update their application to job 'job789'.
     * @allow (delete) User with UID 'user123' can delete their application to job 'job789'.
     * @deny (create) User with UID 'user456' cannot create an application for 'user123' to job 'job789'.
     * @deny (update) User with UID 'user456' cannot update the application of 'user123' to job 'job789'.
     * @deny (delete) User with UID 'user456' cannot delete the application of 'user123' to job 'job789'.
     * @principle Enforces applicant ownership for job applications.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      function isOwner(applicantId) {
        return request.auth.uid == applicantId;
      }
       function isExistingOwner(applicantId) {
        return isOwner(applicantId) && resource != null;
      }
      allow get: if isOwner(resource.data.applicantId);
      allow list: if true; // Publicly listable for recruiters.
      allow create: if isOwner(request.resource.data.applicantId);
      allow update: if isExistingOwner(resource.data.applicantId);
      allow delete: if isExistingOwner(resource.data.applicantId);
    }

    /**
     * @description Controls access to chat documents.
     * @path /chats/{chatId}
     * @allow (get) User with UID 'user123' can read chat 'chatabc' if they are a participant.
     * @allow (create) User with UID 'user123' can create chat 'chatabc' if they are a participant.
     * @allow (update) User with UID 'user123' can update chat 'chatabc' if they are a participant, and it exists.
     * @allow (delete) User with UID 'user123' can delete chat 'chatabc' if they are a participant, and it exists.
     * @deny (get) User with UID 'user456' cannot read chat 'chatabc' if they are not a participant.
     * @deny (create) User with UID 'user456' cannot create chat 'chatabc' if they are not a participant.
     * @deny (update) User with UID 'user456' cannot update chat 'chatabc' if they are not a participant.
     * @deny (delete) User with UID 'user456' cannot delete chat 'chatabc' if they are not a participant.
     * @principle Restricts chat access to participating users.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid != null && request.auth.uid in resource.data.participants;
      }

      function isExistingParticipant() {
        return request.auth.uid != null && request.auth.uid in resource.data.participants && resource != null;
      }
      allow get: if isParticipant();
      allow list: if request.auth.uid != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth.uid != null && request.auth.uid in request.resource.data.participants;
      allow update: if isExistingParticipant();
      allow delete: if isExistingParticipant();
    }

    /**
     * @description Controls access to message documents within a specific chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get) User with UID 'user123' can read message 'msg123' in chat 'chatabc' if they are a participant.
     * @allow (create) User with UID 'user123' can create message 'msg123' in chat 'chatabc' if they are a participant.
     * @allow (update) User with UID 'user123' can update message 'msg123' in chat 'chatabc' if they are a participant, and the message exists.
     * @allow (delete) User with UID 'user123' can delete message 'msg123' in chat 'chatabc' if they are a participant, and the message exists.
     * @deny (get) User with UID 'user456' cannot read message 'msg123' in chat 'chatabc' if they are not a participant.
     * @deny (create) User with UID 'user456' cannot create message 'msg123' in chat 'chatabc' if they are not a participant.
     * @deny (update) User with UID 'user456' cannot update message 'msg123' in chat 'chatabc' if they are not a participant.
     * @deny (delete) User with UID 'user456' cannot delete message 'msg123' in chat 'chatabc' if they are not a participant.
     * @principle Restricts message access to participating users in the chat.
     */
    match /chats/{chatId}/messages/{messageId} {
       function isParticipant(chatId) {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }

      allow get: if request.auth.uid != null && isParticipant(chatId);
      allow list: if request.auth.uid != null && isParticipant(chatId);
      allow create: if request.auth.uid != null && isParticipant(chatId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to feedback documents.
     * @path /feedbacks/{feedbackId}
     * @allow (create) Any authenticated user can submit feedback.
     * @allow (get) Any authenticated user can read any feedback.
     * @deny (update) No one can update feedback documents.
     * @deny (delete) No one can delete feedback documents.
     * @principle Allows public read-only access to feedback.
     */
    match /feedbacks/{feedbackId} {
       function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

     /**
     * @description Controls access to company documents.
     * @path /companies/{companyId}
     * @allow (get) Any user can read any company profile.
     * @allow (list) Any user can list all company profiles.
     * @allow (create) No one can create a company profile through the client, only through admin SDK.
     * @allow (update) No one can update a company profile through the client, only through admin SDK.
     * @allow (delete) No one can delete a company profile through the client, only through admin SDK.
     */
    match /companies/{companyId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}