/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and their associated data,
 *              while allowing public read access to listings and jobs but controlling writes to owners only.
 *              Chats are secured using a shared access model. User listing is disallowed.
 * @dataStructure
 *  - /users/{userId}: User profile data, owned by the user.
 *  - /users/{userId}/applications/{applicationId}: Job application references for a user, owned by the user.
 *  - /users/{userId}/favouriteJobs/{jobId}: Favorite job references for a user, owned by the user.
 *  - /listings/{listingId}: Publicly readable listings, with owner-only writes.
 *  - /jobs/{jobId}: Publicly readable jobs, with recruiter-only writes.
 *  - /jobs/{jobId}/applications/{applicationId}: Applications for a specific job, writable by the applicant.
 *  - /chats/{chatId}: Chats between users, secured by participant lists.
 *  - /chats/{chatId}/messages/{messageId}: Messages within a chat, secured by the chat's participant list.
 *  - /feedbacks/{feedbackId}: Publicly writeable feedback, where write access controlled by the user.
 * @keySecurityDecisions
 *  - User profiles are strictly owned by the authenticated user.
 *  - Listings and Jobs are publicly readable, but only the owner can modify them.
 *  - Chats are accessible only to the participants.
 *  - User listing is disallowed to protect privacy.
 *  - All write operations require authentication.
 * @denormalizationForAuthorization
 *  - Listings and Jobs must contain an `ownerId` or `recruiterId` field, respectively, to enforce ownership for writes.
 *  - Chats must contain a `participants` array to define who can access the chat and its messages.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is signed in and the requested userId matches the authenticated user's ID.
     * @deny (get) if the requested userId does not match the authenticated user's ID.
     * @deny (create) if the user is not signed in or the requested userId does not match the authenticated user's ID.
     * @deny (update, delete) if the user is not signed in or the requested userId does not match the authenticated user's ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.uid == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the authenticated user can manage their own job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (get, create, update, delete) if the user is signed in and the requested userId matches the authenticated user's ID.
     * @deny (get) if the requested userId does not match the authenticated user's ID.
     * @deny (create) if the user is not signed in or the requested userId does not match the authenticated user's ID.
     * @deny (update, delete) if the user is not signed in or the requested userId does not match the authenticated user's ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the authenticated user can manage their own favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (get, create, update, delete) if the user is signed in and the requested userId matches the authenticated user's ID.
     * @deny (get) if the requested userId does not match the authenticated user's ID.
     * @deny (create) if the user is not signed in or the requested userId does not match the authenticated user's ID.
     * @deny (update, delete) if the user is not signed in or the requested userId does not match the authenticated user's ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts writes to the owner.
     * @path /listings/{listingId}
     * @allow (get, list) to anyone.
     * @allow (create) if the user is signed in and the sellerId matches the authenticated user's ID.
     * @allow (update, delete) if the user is signed in and is the owner of the listing.
     * @deny (create, update, delete) if the user is not signed in or is not the owner of the listing.
     * @principle Allows public read access while enforcing document ownership for writes.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(resource.data.sellerId) && resource != null;
      allow delete: if isSignedIn() && isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Allows public read access to job postings, but restricts writes to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) to anyone.
     * @allow (create) if the user is signed in and the recruiterId matches the authenticated user's ID.
     * @allow (update, delete) if the user is signed in and is the recruiter of the job.
     * @deny (create, update, delete) if the user is not signed in or is not the recruiter of the job.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(resource.data.recruiterId) && resource != null;
      allow delete: if isSignedIn() && isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Allows users to create applications for jobs, but only recruiters can modify them.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) if the user is signed in and the applicantId matches the authenticated user's ID.
     * @allow (get, list, update, delete) if the user is signed in and is the recruiter of the job.
     * @deny (create) if the user is not signed in or the applicantId does not match the authenticated user's ID.
     * @deny (get, list, update, delete) if the user is not signed in or is not the recruiter of the job.
     * @principle Restricts access based on user roles and document ownership.
     */
    match /jobs/{jobId}/applications/{applicationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.applicantId == request.auth.uid;
      allow delete: if isSignedIn() && isOwner(resource.data.applicantId) && resource != null;
    }

    /**
     * @description Allows access to chats only to the participants.
     * @path /chats/{chatId}
     * @allow (get, list) if the user is signed in and is a participant in the chat.
     * @allow (create, update) if the user is signed in and is a participant in the chat and the 'participants' array contains both buyerId and sellerId and both match the current user.
     * @allow (delete) if the user is signed in and is a participant in the chat.
     * @deny (get, list, create, update, delete) if the user is not signed in or is not a participant in the chat.
     * @principle Enforces shared access based on a participant list.
     */
    match /chats/{chatId} {
      allow get: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow list: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]) && request.resource.data.buyerId != null && request.resource.data.sellerId != null;
      allow update: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]) && resource != null;
      allow delete: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]) && resource != null;
    }

    /**
     * @description Allows access to messages within a chat only to the chat participants.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list, create) if the user is signed in and is a participant in the chat.
     * @deny (get, list, create) if the user is not signed in or is not a participant in the chat.
     * @principle Enforces shared access to chat messages based on the parent chat's participant list.
     */
    match /chats/{chatId}/messages/{messageId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to create feedback, but restricts modifications to the owner.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) to anyone.
     * @allow (create) if the user is signed in.
     * @allow (update, delete) if the user is signed in and the userId matches the authenticated user's ID.
     * @deny (create, update, delete) if the user is not signed in or is not the owner of the feedback.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(resource.data.userId) && resource != null;
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}