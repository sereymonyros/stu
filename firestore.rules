/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and their
 * associated data, while also allowing public read access to listings and jobs.
 * The rules are designed to be strict on authorization, ensuring that only
 * authenticated users can access or modify data they own or are explicitly
 * authorized to access. Data shape validation is relaxed for rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the user.
 * - /users/{userId}/applications/{applicationId}: Stores user's job application references, only accessible to the user.
 * - /listings/{listingId}: Stores listing data, publicly readable, but writable only by the owner.
 * - /jobs/{jobId}: Stores job posting data, publicly readable, but writable only by the recruiter.
 * - /jobs/{jobId}/applications/{applicationId}: Stores applications for a specific job, only accessible to the job poster and applicant.
 * - /chats/{chatId}: Stores chat session data, accessible only to the buyer and seller involved.
 * - /chats/{chatId}/messages/{messageId}: Stores messages within a chat, accessible only to the participants.
 * - /feedbacks/{feedbackId}: Stores user feedback data, accessible to all authenticated users.
 *
 * Key Security Decisions:
 * - User profiles are strictly private and only accessible to the owning user.
 * - Listings and Jobs are publicly readable, but write access is restricted to the owner (seller) or recruiter, respectively.
 * - Listing is secured using the "Public Read with Owner-Only Writes" pattern.
 * - Jobs is secured using the "Public Read with Owner-Only Writes" pattern.
 * - Chats and Messages are only accessible to the participants involved.
 * - User listing is disabled to prevent data scraping.
 *
 * Denormalization for Authorization:
 *   The rules rely on the 'sellerId' field in 'Listing' documents and the
 *   'recruiterId' field in 'Job' documents to enforce ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create, update, delete) User with matching {userId} can create, update, and delete their profile.
     * @deny (create, update, delete) User tries to create, update, or delete a profile with a mismatched {userId}.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to read and write their own job application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create, update, delete) User with matching {userId} can create, update, and delete their application references.
     * @deny (create, update, delete) User tries to create, update, or delete application references with a mismatched {userId}.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/applications/{applicationId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to listings, but restricts write access to the seller.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read listings.
     * @allow (create, update, delete) The seller (owner) can create, update, and delete their listings.
     * @deny (create, update, delete) A non-seller user tries to create, update, or delete a listing.
     * @principle Public read access with owner-only writes.
     */
    match /listings/{listingId} {
        function isOwner(sellerId) {
            return request.auth.uid == sellerId;
        }
        function isExistingOwner(sellerId) {
            return isOwner(sellerId) && resource != null;
        }

        allow get: if true;
        allow list: if true;

        allow create: if isOwner(request.resource.data.sellerId);
        allow update: if isExistingOwner(resource.data.sellerId);
        allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Allows public read access to jobs, but restricts write access to the recruiter.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read jobs.
     * @allow (create, update, delete) The recruiter (owner) can create, update, and delete their jobs.
     * @deny (create, update, delete) A non-recruiter user tries to create, update, or delete a job.
     * @principle Public read access with owner-only writes.
     */
    match /jobs/{jobId} {
        function isRecruiter(recruiterId) {
            return request.auth.uid == recruiterId;
        }
        function isExistingRecruiter(recruiterId) {
            return isRecruiter(recruiterId) && resource != null;
        }

        allow get: if true;
        allow list: if true;

        allow create: if isRecruiter(request.resource.data.recruiterId);
        allow update: if isExistingRecruiter(resource.data.recruiterId);
        allow delete: if isExistingRecruiter(resource.data.recruiterId);
    }

    /**
     * @description Allows the job poster and applicant to read and write applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isApplicant(applicantId) {
            return request.auth.uid == applicantId;
        }
        function isExistingApplicant(applicantId) {
            return isApplicant(applicantId) && resource != null;
        }

        allow get: if isApplicant(resource.data.applicantId) || request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId;
        allow list: if false; // Listing applications to a job is not allowed

        allow create: if isApplicant(request.resource.data.applicantId);
        allow update: if isExistingApplicant(resource.data.applicantId) || request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId;
        allow delete: if isExistingApplicant(resource.data.applicantId) || request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId;
    }

    /**
     * @description Allows only participants of the chat to read and write messages.
     * @path /chats/{chatId}
     */
    match /chats/{chatId} {
        function isParticipant(buyerId, sellerId) {
            return request.auth.uid == buyerId || request.auth.uid == sellerId;
        }

        allow get: if isParticipant(resource.data.buyerId, resource.data.sellerId);
        allow list: if false;

        allow create: if request.auth.uid == request.resource.data.buyerId || request.auth.uid == request.resource.data.sellerId;
        allow update: if request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId;
        allow delete: if false; // Deleting a chat is not allowed
    }

    /**
     * @description Allows only participants of the chat to read and write messages.
     * @path /chats/{chatId}/messages/{messageId}
     */
    match /chats/{chatId}/messages/{messageId} {
      function isParticipant(chatId) {
        return request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId;
      }

      allow get: if isParticipant(chatId);
      allow list: if isParticipant(chatId);

      allow create: if isParticipant(chatId);
      allow update: if false; // Messages are immutable
      allow delete: if false; // Deleting messages is not allowed
    }

    /**
     * @description Allows any authenticated user to submit feedback.
     * @path /feedbacks/{feedbackId}
     */
    match /feedbacks/{feedbackId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if isSignedIn();
        allow list: if false; // Listing all feedbacks is not allowed

        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if false; // Updating feedback is not allowed
        allow delete: if false; // Deleting feedback is not allowed
    }
  }
}