/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and
 * allows public read access to certain collections while restricting write
 * access to authorized users. It prioritizes security by default, explicitly
 * denying access unless specifically granted.  It also denormalizes critical authorization info onto documents when possible.
 *
 * Data Structure:
 * - User-specific data is nested under `/users/{userId}`.
 * - Public listings and jobs are stored in top-level collections (`/listings`, `/jobs`).
 * - Applications are stored as subcollections of both `/users/{userId}` and `/jobs/{jobId}`.
 * - Chats and Messages are stored in `/chats/{chatId}` and `/chats/{chatId}/messages/{messageId}`
 * - Feedbacks are stored in a top level `/feedbacks` collection.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and related subcollections.
 * - Listings and Jobs are publicly readable, but only the owner (seller or recruiter) can modify them.
 * - Listing isFavourite and Job isFavourite are client-side flags, server side is ignored.
 * - Applications can only be accessed by the applicant and the recruiter who posted the job.
 * - Chats can only be accessed by the two participants (buyer and seller).
 * - Feedback can be created by any signed-in user.
 *
 * Denormalization for Authorization:
 * - Listings: `sellerId` field enables owner-only writes.
 * - Jobs: `recruiterId` field enables owner-only writes.
 * - Chats: `participants` array enables shared access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verified Identity
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Ownership
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Ownership and Existence
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user is one of the listed participants.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Shared Access
     */
    function isParticipant(participants) {
        return isSignedIn() && participants.hasAny( [request.auth.uid] );
    }

    /**
     * @description Rules for user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates their own profile document.
     * @allow (get, update, delete) User with UID 'user123' reads, updates, or deletes their own profile document.
     * @deny (create) User with UID 'user123' tries to create a profile document for user 'user456'.
     * @deny (get, update, delete) User with UID 'user123' tries to read, update, or delete the profile document of user 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for user application references.
     * @path /users/{userId}/applications/{applicationId}
     * @allow (create) User with UID 'user123' creates an application reference for themselves.
     * @allow (get, update, delete) User with UID 'user123' reads, updates, or deletes their own application reference.
     * @deny (create) User with UID 'user123' tries to create an application reference for user 'user456'.
     * @deny (get, update, delete) User with UID 'user123' tries to read, update, or delete the application reference of user 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for user favorite job references.
     * @path /users/{userId}/favouriteJobs/{jobId}
     * @allow (create) User with UID 'user123' creates a favorite job reference for themselves.
     * @allow (get, update, delete) User with UID 'user123' reads, updates, or deletes their own favorite job reference.
     * @deny (create) User with UID 'user123' tries to create a favorite job reference for user 'user456'.
     * @deny (get, update, delete) User with UID 'user123' tries to read, update, or delete the favorite job reference of user 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/favouriteJobs/{jobId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for listings.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read listings.
     * @allow (create) User with UID 'user123' creates a listing with sellerId 'user123'.
     * @allow (update, delete) User with UID 'user123' updates or deletes a listing where resource.data.sellerId == 'user123'.
     * @deny (create) User with UID 'user123' creates a listing with sellerId 'user456'.
     * @deny (update, delete) User with UID 'user123' updates or deletes a listing where resource.data.sellerId != 'user123'.
     * @principle Public read, owner-only writes.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId);
    }

    /**
     * @description Rules for job postings.
     * @path /jobs/{jobId}
     * @allow (get, list) Any user can read job postings.
     * @allow (create) User with UID 'recruiter123' creates a job with recruiterId 'recruiter123'.
     * @allow (update, delete) User with UID 'recruiter123' updates or deletes a job where resource.data.recruiterId == 'recruiter123'.
     * @deny (create) User with UID 'recruiter123' creates a job with recruiterId 'recruiter456'.
     * @deny (update, delete) User with UID 'recruiter123' updates or deletes a job where resource.data.recruiterId != 'recruiter123'.
     * @principle Public read, owner-only writes.
     */
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.recruiterId);
      allow delete: if isExistingOwner(resource.data.recruiterId);
    }

    /**
     * @description Rules for job applications.
     * @path /jobs/{jobId}/applications/{applicationId}
     * @allow (create) User with UID 'user123' creates an application for job 'job456' with applicantId 'user123'.
     * @allow (get) User with UID 'user123' or recruiter with UID 'recruiter456' reads application 'application789' for job 'job456' where applicantId == 'user123' or recruiterId == 'recruiter456'.
     * @allow (list) User with UID 'user123' list applications for job 'job456' where applicantId == 'user123'.
     * @allow (update, delete) User with UID 'recruiter456' updates or deletes application 'application789' for job 'job456' where recruiterId == 'recruiter456'.
     * @deny (create) User with UID 'user123' creates an application for job 'job456' with applicantId 'user456'.
     * @deny (get, list, update, delete) User with UID 'user123' tries to read, update, or delete application 'application789' for job 'job456' where applicantId != 'user123' and recruiterId != 'recruiter123'.
     * @principle Shared access: Applicant and Recruiter can access.
     */
    match /jobs/{jobId}/applications/{applicationId} {
        function isApplicant(jobId) {
            return get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
        }
      allow get, list: if isOwner(resource.data.applicantId) || isApplicant(jobId);
      allow create: if isSignedIn() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isApplicant(jobId) && resource != null;
      allow delete: if isApplicant(jobId) && resource != null;
    }

    /**
     * @description Rules for chats.
     * @path /chats/{chatId}
     * @allow (get, list) User with UID 'user123' or 'user456' reads or lists chat 'chat789' if they are participants.
     * @allow (create) User with UID 'user123' creates a chat with participants 'user123' and 'user456'.
     * @allow (update, delete) User with UID 'user123' updates or deletes chat 'chat789' if they are participants.
     * @deny (get, list, create, update, delete) User with UID 'user789' tries to access chat 'chat789' if they are not a participant.
     * @principle Shared access: Only participants can access.
     */
    match /chats/{chatId} {
      allow get, list: if isParticipant(resource.data.participants);
      allow create: if isSignedIn() && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow update: if isExistingOwner(request.auth.uid) && isParticipant(resource.data.participants);
      allow delete: if isExistingOwner(request.auth.uid) && isParticipant(resource.data.participants);
    }

    /**
     * @description Rules for messages within a chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (get, list) User with UID 'user123' or 'user456' reads or lists messages in chat 'chat789' if they are participants.
     * @allow (create) User with UID 'user123' creates a message in chat 'chat789' if they are a participant.
     * @allow (update, delete) No one is allowed to update or delete messages.
     * @deny (get, list, create) User with UID 'user789' tries to access messages in chat 'chat789' if they are not a participant.
     * @principle Shared access: Only participants can access.
     */
    match /chats/{chatId}/messages/{messageId} {
        function chatParticipants() {
            return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
      allow get, list: if isParticipant(chatParticipants());
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && isParticipant(chatParticipants());
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any signed-in user can read feedback.
     * @allow (create) Any signed-in user can create feedback.
     * @deny (update, delete) No one can update or delete feedback.
     * @principle Public read, authenticated create, no updates or deletes.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}