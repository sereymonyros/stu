/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and associated data,
 * and a public-read, owner-write model for listings, jobs, and feedback. Chats and messages are secured
 * using a shared-access pattern based on the participants list.
 *
 * Data Structure:
 * - User profiles and related data (applications, favorites, searches) are nested under /users/{userId}.
 * - Listings, jobs, chats, and feedback are stored in top-level collections.
 * - Applications are stored as subcollections of jobs.
 * - Messages are stored as subcollections of chats.
 *
 * Key Security Decisions:
 * - Users can only read, create, update, and delete their own profile data.
 * - Listings and Jobs are publicly readable but only the owner (seller/recruiter) can modify them.
 * - Chats and messages are only accessible to participants.
 * - Listing isFavourite and Job isFavourite are client-side flags and not secured.
 * - Denormalization is used on chats to include listingTitle and participants for simpler rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read, create, update, and delete their own profile data.
     * @path /users/{userId}
     * @allow (create) request.auth.uid == userId
     * @allow (get, update, delete) request.auth.uid == userId
     * @deny (create) request.auth.uid != userId
     * @deny (get, update, delete) request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Allows a user to read, create, update, and delete their own job application references.
       * @path /users/{userId}/applications/{applicationId}
       * @allow (create) request.auth.uid == userId
       * @allow (get, update, delete) request.auth.uid == userId
       * @deny (create) request.auth.uid != userId
       * @deny (get, update, delete) request.auth.uid != userId
       * @principle Enforces document ownership for all operations.
       */
      match /applications/{applicationId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Allows a user to read, create, update, and delete their own favourite job references.
       * @path /users/{userId}/favouriteJobs/{jobId}
       * @allow (create) request.auth.uid == userId
       * @allow (get, update, delete) request.auth.uid == userId
       * @deny (create) request.auth.uid != userId
       * @deny (get, update, delete) request.auth.uid != userId
       * @principle Enforces document ownership for all operations.
       */
      match /favouriteJobs/{jobId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Allows a user to read, create, update, and delete their own saved job searches.
       * @path /users/{userId}/savedSearches/{searchId}
       * @allow (create) request.auth.uid == userId
       * @allow (get, update, delete) request.auth.uid == userId
       * @deny (create) request.auth.uid != userId
       * @deny (get, update, delete) request.auth.uid != userId
       * @principle Enforces document ownership for all operations.
       */
      match /savedSearches/{searchId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Allows anyone to read listings, but only the seller can create, update, or delete them.
     * @path /listings/{listingId}
     * @allow (get, list) if true
     * @allow (create) request.auth.uid == request.resource.data.sellerId
     * @allow (update, delete) request.auth.uid == resource.data.sellerId
     * @deny (create) request.auth.uid != request.resource.data.sellerId
     * @deny (update, delete) request.auth.uid != resource.data.sellerId
     * @principle Public read, owner-only write.
     */
    match /listings/{listingId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update: if request.auth.uid == resource.data.sellerId;
      allow delete: if request.auth.uid == resource.data.sellerId;
    }

    /**
     * @description Allows anyone to read job postings, but only the recruiter can create, update, or delete them.
     * @path /jobs/{jobId}
     * @allow (get, list) if true
     * @allow (create) request.auth.uid == request.resource.data.recruiterId
     * @allow (update, delete) request.auth.uid == resource.data.recruiterId
     * @deny (create) request.auth.uid != request.resource.data.recruiterId
     * @deny (update, delete) request.auth.uid != request.resource.data.recruiterId
     * @principle Public read, owner-only write.
     */
    match /jobs/{jobId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.recruiterId;
      allow update: if request.auth.uid == resource.data.recruiterId;
      allow delete: if request.auth.uid == resource.data.recruiterId;

      /**
       * @description Allows creation, retrieval, update, and deletion of job applications only by the applicant.
       * @path /jobs/{jobId}/applications/{applicationId}
       * @allow (create) request.auth.uid == request.resource.data.applicantId
       * @allow (get, update, delete) request.auth.uid == resource.data.applicantId
       * @deny (create) request.auth.uid != request.resource.data.applicantId
       * @deny (get, update, delete) request.auth.uid != request.resource.data.applicantId
       * @principle: Applications are owned by the user submitting them
       */
      match /applications/{applicationId} {
        allow get: if request.auth.uid == resource.data.applicantId;
        allow list: if false;
        allow create: if request.auth.uid == request.resource.data.applicantId;
        allow update: if request.auth.uid == resource.data.applicantId;
        allow delete: if request.auth.uid == resource.data.applicantId;
      }
    }

    /**
     * @description Allows only participants to read and write to chats.
     * @path /chats/{chatId}
     * @allow (get, list) request.auth.uid in resource.data.participants
     * @allow (create, update, delete) request.auth.uid in resource.data.participants
     * @deny (get, list) !(request.auth.uid in resource.data.participants)
     * @deny (create, update, delete) !(request.auth.uid in resource.data.participants)
     * @principle Shared access based on the participants list.
     */
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }

      function isExistingParticipant() {
          return isParticipant() && resource != null;
      }
      allow get: if isParticipant();
      allow list: if false;
      allow create: if request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isExistingParticipant();
      allow delete: if false; // No deleting chats

      /**
       * @description Allows only participants to read and write messages within a chat.
       * @path /chats/{chatId}/messages/{messageId}
       * @allow (get, list, create) get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])
       * @deny (get, list, create) !get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])
       * @principle Shared access based on the participants list of the parent chat.
       */
      match /messages/{messageId} {
        function isChatParticipant(chatId) {
            return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
          allow get: if isChatParticipant(chatId);
          allow list: if false;
          allow create: if isChatParticipant(chatId) && request.auth.uid == request.resource.data.senderId;
          allow update: if false;
          allow delete: if false;
      }
    }

    /**
     * @description Allows anyone to create feedback, but does not allow updating or deleting.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) if true
     * @allow (create) request.auth.uid == request.resource.data.userId
     * @deny (create) request.auth.uid != request.resource.data.userId
     * @deny (update, delete) if false
     * @principle Public read, owner-only create, no updates or deletes.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if false;
    }
  }
}