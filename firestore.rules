/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-related data,
 * and a recruiter-ownership model for job postings. Public read access is granted for
 * listings and jobs, but modifications are restricted to owners (sellers or recruiters).
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile data.
 * - /users/{userId}/applications/{applicationId}: Stores references to jobs a user has applied for.
 * - /listings/{listingId}: Stores listing data.
 * - /jobs/{jobId}: Stores job posting data.
 * - /jobs/{jobId}/applications/{applicationId}: Stores applications for a specific job.
 * - /chats/{chatId}: Stores chat session data.
 * - /chats/{chatId}/messages/{messageId}: Stores messages within a chat.
 * - /feedbacks/{feedbackId}: Stores user-submitted feedback.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data and application references.
 * - Recruiters can only manage their own job postings.
 * - Public read access is granted to listings and jobs.
 * - Listing of applications is restricted to the recruiter who owns the job.
 * - Data type and schema validation is relaxed for rapid prototyping, focusing on authorization.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `sellerId` field in listings and the `recruiterId` field in jobs for ownership checks,
 *   avoiding the need for additional `get()` calls.
 *
 * Structural Segregation:
 * - Drafts vs. published content is not explicitly implemented, but could be achieved by creating
 *   separate collections (e.g., `/private_listings/{listingId}` and `/listings/{listingId}`).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      /**
       * @description Allows users to read and write their own job application references.
       * @path /users/{userId}/applications/{applicationId}
       * @allow (get, create, update, delete) if request.auth.uid == userId
       * @deny (get, create, update, delete) if request.auth.uid != userId
       * @principle Restricts access to a user's own job application references.
       */
      match /applications/{applicationId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    /**
     * @description Allows anyone to read listings, but only the seller can modify them.
     * @path /listings/{listingId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if request.auth.uid == resource.data.sellerId
     * @deny (create, update, delete) if request.auth.uid != resource.data.sellerId
     * @principle Allows public read access with owner-only writes.
     */
    match /listings/{listingId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update: if request.auth.uid == resource.data.sellerId;
      allow delete: if request.auth.uid == resource.data.sellerId;
    }

    /**
     * @description Allows anyone to read job postings, but only the recruiter can modify them.
     * @path /jobs/{jobId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if request.auth.uid == resource.data.recruiterId
     * @deny (create, update, delete) if request.auth.uid != resource.data.recruiterId
     * @principle Allows public read access with owner-only writes.
     */
    match /jobs/{jobId} {
      function isOwner(recruiterId) {
        return request.auth != null && request.auth.uid == recruiterId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.recruiterId;
      allow update: if request.auth.uid == resource.data.recruiterId;
      allow delete: if request.auth.uid == resource.data.recruiterId;

      /**
       * @description Allows recruiters to manage applications for their job postings.
       * @path /jobs/{jobId}/applications/{applicationId}
       * @allow (list) if request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId
       * @allow (get, create, update, delete) if request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId
       * @deny (get, create, update, delete) if request.auth.uid != get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId
       * @principle Restricts access to applications based on job posting ownership.
       */
      match /applications/{applicationId} {
          function isRecruiterForJob(jobId) {
            return request.auth != null && request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId;
          }
        allow get: if isRecruiterForJob(jobId);
        allow list: if isRecruiterForJob(jobId);
        allow create: if isRecruiterForJob(jobId);
        allow update: if isRecruiterForJob(jobId);
        allow delete: if isRecruiterForJob(jobId);
      }
    }

    /**
     * @description Allows read and write access to chats for participating users.
     * @path /chats/{chatId}
     */
    match /chats/{chatId} {
        function isParticipant(chatId) {
            return request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
        }
      allow get: if resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid;
      allow list: if false;
      allow create: if request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid;
      allow update: if resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid;
      allow delete: if false;

      /**
       * @description Allows read and write access to messages within a chat for participating users.
       * @path /chats/{chatId}/messages/{messageId}
       */
      match /messages/{messageId} {
          function isMessageSender(chatId) {
              return request.auth != null && request.auth.uid == request.resource.data.senderId && (get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid);
          }
        allow get: if get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid;
        allow list: if false;
        allow create: if request.auth.uid == request.resource.data.senderId && (get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == request.auth.uid);
        allow update: if false;
        allow delete: if false;
      }
    }

    /**
     * @description Allows anyone to read feedback, but only the user who created it can modify it.
     * @path /feedbacks/{feedbackId}
     */
    match /feedbacks/{feedbackId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }

      allow get: if true;
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId;
    }
  }
}