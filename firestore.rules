rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isRecruiter() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'recruiter';
    }

    function isStandardUser() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'standard';
    }
    
    // USERS
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isUser(userId);
      // Users can't delete their own profiles
      allow delete: if false;

      // SUB-COLLECTIONS
      match /applications/{jobId} {
        allow read, create, delete: if isUser(userId) && isStandardUser();
        allow update: if isUser(userId) || isRecruiter(); // Recruiter can update status
      }
      match /favouriteJobs/{jobId} {
        allow read, create, delete: if isUser(userId) && isStandardUser();
        allow write: if isUser(userId) && isStandardUser();
      }
    }

    // JOBS
    match /jobs/{jobId} {
      allow read: if isAuth();
      allow create: if isRecruiter();
      // Only the recruiter who posted the job can update or delete it
      allow update, delete: if isRecruiter() && resource.data.recruiterId == request.auth.uid;

      // SUB-COLLECTIONS
      match /applications/{applicationId} {
        allow read: if isRecruiter() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
        allow create: if isStandardUser() && request.auth.uid == applicationId;
        // Recruiter can update status, applicant can't
        allow update: if isRecruiter() && get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
        allow delete: if false; // Don't allow deleting applications
      }
    }

    // LISTINGS
    match /listings/{listingId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.sellerId == request.auth.uid;
    }

    // CHATS
    match /chats/{chatId} {
      // Only participants can read the chat document
      allow read, update: if isAuth() && request.auth.uid in resource.data.participants;
      // Only participants can create a new chat
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    
    // FEEDBACK
    match /feedbacks/{feedbackId} {
      allow read: if isAuth(); // Or make public if you want
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Generally users shouldn't edit feedback
    }
  }
}
