rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isRecruiter() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'recruiter';
    }

    // USERS
    // Users can read their own profile.
    // Users can update their own profile.
    // Anyone can create a user profile (during signup).
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if request.auth != null;
    }

    // USER SUB-COLLECTIONS
    // Users can fully manage their own sub-collections (applications, favouriteJobs).
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isOwner(userId);
    }
    
    // LISTINGS
    // Anyone authenticated can read all listings.
    // Users can create a listing if they are logged in.
    // Only the seller (owner) can update or delete their own listing.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isOwner(resource.data.sellerId);
    }

    // CHATS
    // Users can list and read chats they are a participant in.
    // Users can create a chat if they are one of the participants in the request.
    // Users can update a chat (e.g., lastMessage) if they are a participant.
    match /chats/{chatId} {
      allow read, update: if request.auth.uid in resource.data.participants;
      allow create: if request.auth.uid in request.resource.data.participants;
      allow list: if request.auth.uid == query.get("participants")[0]; // This is simplified. Complex queries are tricky.
    }

    // MESSAGES (sub-collection of CHAT)
    // Users can read messages in a chat they are part of.
    // Users can create messages in a chat they are part of.
    match /chats/{chatId}/messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    
    // FEEDBACK
    // Any authenticated user can create feedback.
    // No one can read/update/delete feedback directly (handled by server flows if needed).
    match /feedbacks/{feedbackId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false;
    }
    
    // COMPANIES
    // Anyone can read company profiles (they are public).
    // Only recruiters can create/update company profiles (or server-side flows).
    match /companies/{companyId} {
        allow read: if true;
        allow write: if isRecruiter();
    }

    // JOBS
    // Anyone can read job listings.
    // Only recruiters can create, update, or delete jobs.
    // An applicant can apply (create a document in the 'applications' subcollection).
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isRecruiter() && isOwner(request.resource.data.recruiterId);
      
      // APPLICATIONS (sub-collection of JOBS)
      // Any standard user can create an application for a job.
      // The applicant can read their own application.
      // The recruiter who posted the job can read all applications for that job.
      match /applications/{applicationId} {
          allow create: if isOwner(applicationId) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'standard';
          allow read: if isOwner(applicationId) || isOwner(get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId);
          allow update: if isOwner(get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId); // Only recruiter can update status
      }
    }
  }
}

    