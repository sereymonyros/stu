
{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "baseUrl": ".", // Set the base directory for module resolution
    "paths": {
      // Define the alias: '@/*' should resolve to the 'src/' directory
      // (or whatever your source root is, e.g., 'app/', 'lib/', etc.)
      "@/*": ["./src/*"] 
    }
  },
  "compileOnSave": true,
  "include": [
    "index.ts"
  ]
}
