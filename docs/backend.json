{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores public user data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID from Firebase Authentication."
        },
        "displayName": {
          "type": "string",
          "description": "The user's public display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "userType": {
          "type": "string",
          "description": "The type of user, determines permissions.",
          "enum": [
            "standard",
            "recruiter"
          ]
        },
        "favoriteJobs": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "A list of job IDs that the user has favourited."
        }
      },
      "required": [
        "uid",
        "displayName",
        "userType"
      ]
    },
    "Listing": {
      "title": "Listing",
      "description": "Represents an item for sale.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the listing."
        },
        "description": {
          "type": "string",
          "description": "A description of the item."
        },
        "price": {
          "type": "number",
          "description": "The price of the item."
        },
        "originalPrice": {
          "type": "number",
          "description": "The original price of the item, for displaying a sale."
        },
        "sellerId": {
          "type": "string",
          "description": "The UID of the seller."
        },
        "imageUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "A list of URLs for item images."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the listing was created."
        },
        "isFavourite": {
          "type": "boolean",
          "description": "Indicates if the listing is a favourite."
        },
        "status": {
          "type": "string",
          "description": "The current status of the listing.",
          "enum": [
            "available",
            "pending",
            "sold"
          ]
        }
      },
      "required": [
        "title",
        "price",
        "sellerId",
        "createdAt",
        "status"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between a buyer and a seller about a listing.",
      "type": "object",
      "properties": {
        "listingId": {
          "type": "string"
        },
        "buyerId": {
          "type": "string"
        },
        "sellerId": {
          "type": "string"
        },
        "lastMessage": {
          "type": "string",
          "description": "The last message sent in the chat for preview purposes."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "listingId",
        "buyerId",
        "sellerId",
        "updatedAt"
      ]
    },
    "Message": {
      "title": "Message",
      "description": "A single message within a chat.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "senderId",
        "text",
        "timestamp"
      ]
    },
    "Job": {
      "title": "Job",
      "description": "Represents a job posting.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the job."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the job."
        },
        "companyName": {
          "type": "string",
          "description": "The name of the hiring company."
        },
        "location": {
          "type": "string",
          "description": "The location of the job."
        },
        "salary": {
          "type": "string",
          "description": "The salary or salary range for the job."
        },
        "jobType": {
          "type": "string",
          "description": "The type of employment.",
          "enum": [
            "Full-time",
            "Part-time",
            "Contract",
            "Internship"
          ]
        },
        "status": {
          "type": "string",
          "description": "The hiring status of the job.",
          "enum": [
            "Available",
            "Offering",
            "Closed"
          ]
        },
        "recruiterId": {
          "type": "string",
          "description": "The UID of the recruiter who posted the job."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the job was posted."
        }
      },
      "required": [
        "title",
        "companyName",
        "location",
        "jobType",
        "status",
        "recruiterId",
        "createdAt"
      ]
    },
    "FavoriteJob": {
        "title": "Favorite Job",
        "description": "A lightweight reference to a job a user has favorited.",
        "type": "object",
        "properties": {
            "jobId": {
                "type": "string"
            },
            "favoritedAt": {
                "type": "string",
                "format": "date-time"
            }
        },
        "required": ["jobId", "favoritedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile information."
    },
    "/users/{userId}/favoriteJobs/{jobId}": {
        "schema": {
            "$ref": "#/entities/FavoriteJob"
        },
        "description": "A user's list of favorite job references."
    },
    "/listings/{listingId}": {
      "schema": {
        "$ref": "#/entities/Listing"
      },
      "description": "Collection of all listings."
    },
    "/jobs/{jobId}": {
      "schema": {
        "$ref": "#/entities/Job"
      },
      "description": "Collection of all job postings."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "Collection of all chat sessions."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Sub-collection for messages within a specific chat."
    }
  }
}
