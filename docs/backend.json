{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores public user data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID from Firebase Authentication."
        },
        "displayName": {
          "type": "string",
          "description": "The user's public display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "address": {
          "type": "string",
          "description": "The user's physical address."
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "resumeUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's uploaded resume."
        },
        "userType": {
          "type": "string",
          "description": "The type of user, determines permissions.",
          "enum": [
            "standard",
            "recruiter"
          ]
        }
      },
      "required": [
        "uid",
        "displayName",
        "address",
        "phone",
        "email",
        "userType"
      ]
    },
    "Listing": {
      "title": "Listing",
      "description": "Represents an item for sale.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the listing."
        },
        "description": {
          "type": "string",
          "description": "A description of the item."
        },
        "price": {
          "type": "number",
          "description": "The price of the item."
        },
        "originalPrice": {
          "type": "number",
          "description": "The original price of the item, for displaying a sale."
        },
        "sellerId": {
          "type": "string",
          "description": "The UID of the seller."
        },
        "imageUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "A list of URLs for item images."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the listing was created."
        },
        "isFavourite": {
          "type": "boolean",
          "description": "Indicates if the listing is a favourite."
        },
        "status": {
          "type": "string",
          "description": "The current status of the listing.",
          "enum": [
            "available",
            "pending",
            "sold"
          ]
        }
      },
      "required": [
        "title",
        "price",
        "sellerId",
        "createdAt",
        "status"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between two users about a listing.",
      "type": "object",
      "properties": {
        "listingId": {
          "type": "string"
        },
        "listingTitle": {
          "type": "string",
          "description": "The title of the listing being discussed, denormalized for easy display."
        },
        "buyerId": {
          "type": "string"
        },
        "sellerId": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An array containing the UIDs of both the buyer and the seller for easy querying."
        },
        "lastMessage": {
          "type": "string",
          "description": "The last message sent in the chat for preview purposes."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "listingId",
        "listingTitle",
        "buyerId",
        "sellerId",
        "participants",
        "updatedAt"
      ]
    },
    "Message": {
      "title": "Message",
      "description": "A single message within a chat.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "senderId",
        "text",
        "timestamp"
      ]
    },
    "Job": {
      "title": "Job",
      "description": "Represents a job posting.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the job."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the job."
        },
        "companyName": {
          "type": "string",
          "description": "The name of the hiring company."
        },
        "location": {
          "type": "string",
          "description": "The location of the job."
        },
        "salary": {
          "type": "string",
          "description": "The salary or salary range for the job."
        },
        "jobType": {
          "type": "string",
          "description": "The type of employment.",
          "enum": [
            "Full-time",
            "Part-time",
            "Contract",
            "Internship"
          ]
        },
        "status": {
          "type": "string",
          "description": "The hiring status of the job.",
          "enum": [
            "Available",
            "Offering",
            "Closed"
          ]
        },
        "recruiterId": {
          "type": "string",
          "description": "The UID of the recruiter who posted the job."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the job was posted."
        },
        "isFavourite": {
          "type": "boolean",
          "description": "Client-side flag to indicate if a job is a favorite."
        }
      },
      "required": [
        "title",
        "companyName",
        "location",
        "jobType",
        "status",
        "recruiterId",
        "createdAt"
      ]
    },
    "Application": {
      "title": "Application",
      "description": "Represents a user's application for a job.",
      "type": "object",
      "properties": {
        "applicantId": {
          "type": "string",
          "description": "The UID of the user who applied."
        },
        "jobId": {
          "type": "string",
          "description": "The ID of the job being applied for."
        },
        "status": {
          "type": "string",
          "description": "The current status of the application.",
          "enum": [
            "submitted",
            "reviewed",
            "rejected"
          ]
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the application was submitted."
        },
        "resumeUrl": {
          "type": "string",
          "format": "uri",
          "description": "A snapshot of the applicant's resume URL at the time of application."
        }
      },
      "required": [
        "applicantId",
        "jobId",
        "status",
        "appliedAt",
        "resumeUrl"
      ]
    },
    "UserApplication": {
      "title": "User Application",
      "description": "A lightweight reference to a job a user has applied for, stored under the user's document.",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "jobId",
        "appliedAt"
      ]
    },
    "UserFavouriteJob": {
      "title": "User Favourite Job",
      "description": "A lightweight reference to a job a user has favorited, stored under the user's document.",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "favouritedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "jobId",
        "favouritedAt"
      ]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User-submitted feedback for the application.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user submitting the feedback."
        },
        "rating": {
          "type": "number",
          "description": "A rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "description": "The user's comment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the feedback was submitted."
        }
      },
      "required": [
        "userId",
        "rating",
        "comment",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile information."
    },
    "/users/{userId}/applications/{applicationId}": {
      "schema": {
        "$ref": "#/entities/UserApplication"
      },
      "description": "A user's list of job applications references."
    },
    "/users/{userId}/favouriteJobs/{jobId}": {
      "schema": {
        "$ref": "#/entities/UserFavouriteJob"
      },
      "description": "A user's list of favorite job references."
    },
    "/listings/{listingId}": {
      "schema": {
        "$ref": "#/entities/Listing"
      },
      "description": "Collection of all listings."
    },
    "/jobs/{jobId}": {
      "schema": {
        "$ref": "#/entities/Job"
      },
      "description": "Collection of all job postings."
    },
    "/jobs/{jobId}/applications/{applicationId}": {
      "schema": {
        "$ref": "#/entities/Application"
      },
      "description": "Sub-collection for applications to a specific job."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "Collection of all chat sessions."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Sub-collection for messages within a specific chat."
    },
    "/feedbacks/{feedbackId}": {
      "schema": {
        "$ref": "#/entities/Feedback"
      },
      "description": "Collection of all user-submitted feedback."
    }
  }
}
