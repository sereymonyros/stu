rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the 'listings' folder
    match /listings/{allPaths=**} {
      // Allow anyone to read (view) images.
      // This is necessary for users to see the listing images.
      allow read: if true;

      // Allow authenticated users to write (upload, update, delete) images.
      allow write: if request.auth != null;
    }
  }
}
